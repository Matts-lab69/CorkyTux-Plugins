def _login_window_url(store: str) -> str:
    if store == "epic":
        # Heroic-style: responseType=code plus a redirectUrl that points back to
        # localhost so this window can read the code. Without redirectUrl Epic
        # never lands on a URL that carries the code (it just ends up back on
        # epicgames.com), so the localhost/launcher/authorized?code=... capture
        # below would never fire.
        from urllib.parse import quote
        return ("https://www.epicgames.com/id/login?redirectUrl="
                + quote("http://localhost/launcher/authorized", safe="")
                + "&responseType=code"
                + "&display=popup")  # inline forward (same view), never window.open
    # CORKYTUX_GOG_LAYOUT probes whether GOG has a layout that renders the
    # social login inline the way Epic's &display=popup does. Unset (or empty)
    # keeps layout=client2. GOG only: this function is not used for epic.
    layout = os.environ.get("CORKYTUX_GOG_LAYOUT", "").strip()
    if not layout:
        return GOG_LOGIN_URL
    return GOG_LOGIN_URL.replace("layout=client2", "layout=" + layout)


def _query_param(url: str, key: str) -> str:
    import urllib.parse
    try:
        qs = urllib.parse.urlparse(url).query
        return (urllib.parse.parse_qs(qs).get(key) or [""])[0]
    except Exception:
        return ""


_LOG_FILE = CONFIG_DIR / "sso_debug.log"

def _log_safe(msg: str) -> bool:
    """True when the line carries no credential/code material. Applied inside
    _dbg as a last-resort filter so even an accidental sensitive value never
    reaches the log file."""
    low = msg.lower()
    return not any(k in low for k in ("code=", "authorization", "password",
                                      "token", "secret"))


def _sani_uri(uri: str, limit: int = 120) -> str:
    """URIs are logged WITHOUT query nor fragment (they can carry code=,
    token or other secret params). Never log a raw URI."""
    try:
        import urllib.parse as _up
        p = _up.urlparse(uri)
        if not p.netloc:
            return uri[:limit]
        hostpath = (f"{p.scheme}://{p.netloc}{p.path}" if p.scheme
                    else f"{p.netloc}{p.path}")
        return hostpath[:limit]
    except Exception:
        return uri[:limit]


def _host_of(uri: str) -> str:
    """Hostname only — safe for logs: no path, no query, no fragment."""
    try:
        import urllib.parse as _up
        return _up.urlparse(uri).hostname or ""
    except Exception:
        return ""


def _dbg(msg):
    """Write a debug line to CONFIG_DIR/sso_debug.log (0600)."""
    try:
        import time
        if not _log_safe(msg):
            return
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        with open(_LOG_FILE, "a") as f:
            os.chmod(_LOG_FILE, 0o600)
            f.write(f"[{time.strftime('%H:%M:%S')}] {msg}\n")
    except Exception:
        pass


def cmd_login_window(args):
    """Embedded login (Heroic-style): GTK window with WebKit, the code is
    captured automatically — no copy-paste, no duplicate browser tabs."""
    try:
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("WebKit", "6.0")
        from gi.repository import Gtk, WebKit as WebKit2, GLib
    except (ImportError, ValueError) as e:
        die(3, f"Login window needs PyGObject WebKitGTK 6.0 for GTK4 "
               f"(e.g. net-libs/webkit-gtk:6 on Gentoo). Or paste the code manually: {e}")
    import json as _json
    store = args.store
    got = {"code": ""}

    # Clear previous debug log (config dir, 0600)
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        with open(_LOG_FILE, "w") as f:
            os.chmod(_LOG_FILE, 0o600)
            f.write("")
    except Exception:
        pass
    _dbg(f"=== LOGIN WINDOW OPENED store={store} ===")

    def finish(code: str):
        if got["code"]:
            return
        got["code"] = code
        _dbg(f"*** CODE CAPTURED: {code[:12]}... ***")
        emit({"type": "code", "store": store, "code": code})
        GLib.idle_add(loop.quit)

    def code_in_uri(uri: str) -> str:
        if store == "gog":
            if "on_login_success" in uri:
                c = _query_param(uri, "code")
                if c:
                    return c
                import urllib.parse as _up
                try:
                    frag = _up.urlparse(uri).fragment
                    return (_up.parse_qs(frag).get("code") or [""])[0]
                except Exception:
                    return ""
            return ""
        # Heroic pattern: hostname === 'localhost' → extract code param
        from urllib.parse import urlparse
        try:
            parsed = urlparse(uri)
        except Exception:
            return ""
        if parsed.hostname in ("localhost", "127.0.0.1"):
            code = parsed.query.split("code=")[1].split("&")[0] if "code=" in parsed.query else ""
            if code:
                return code
        # authorizationCode param (old id/api/redirect flow)
        code2 = _query_param(uri, "authorizationCode")
        if code2:
            return code2
        return ""

    def try_extract_code_from_page(webview=None):
        """Read the page body via JS and parse the JSON response.
        Matches Playnite's approach: check page source for localhost URL.
        `webview` defaults to the main login view (also usable on SSO popups)."""
        target = webview if webview is not None else web
        js = "(function() { try { return document.body ? document.body.innerText : ''; } catch(e) { return ''; } })()"
        def on_js(grw, res, _ud):
            try:
                val = grw.evaluate_javascript_finish(res)
                text = val.to_string().strip() if val else ""
                # Page CONTENT is never logged (it can hold credentials or a
                # code): only its length and the page host, no query/fragment.
                _dbg(f"Page body len={len(text)} host={_host_of(target.get_uri() or '')}")
                if not text:
                    return
                # Try JSON parse (Epic id/api/redirect returns JSON)
                try:
                    data = _json.loads(text)
                    code = (data.get("authorizationCode")
                            or data.get("authorization_code")
                            or data.get("code")
                            or data.get("sid") or "")
                    if code:
                        _dbg(f"Found code in JSON: {str(code)[:12]}...")
                        finish(str(code))
                        return
                except _json.JSONDecodeError:
                    pass
                # Playnite pattern: regex for localhost/launcher/authorized?code=
                import re
                m = re.search(r'localhost/launcher/authorized\?code=([a-zA-Z0-9_-]+)', text)
                if m:
                    _dbg(f"Found code in page text via regex: {m.group(1)[:12]}...")
                    finish(m.group(1))
            except Exception as e:
                _dbg(f"JS eval error: {e}")
        target.evaluate_javascript(js, -1, None, None, None, on_js, None)

    def try_extract_code_from_uri(uri: str) -> bool:
        code = code_in_uri(uri)
        if code:
            _dbg(f"Found code in URI: {str(code)[:12]}... uri={_sani_uri(uri)}")
            finish(str(code))
            return True
        return False

    win = Gtk.Window(title="Log in with " + ("Epic Games" if store == "epic" else "GOG"))
    win.set_default_size(760, 600)
    loop = GLib.MainLoop()
    win.connect("close-request", lambda *_: (loop.quit(), False)[1])
    col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
    col.set_margin_top(6)
    col.set_margin_bottom(6)
    col.set_margin_start(6)
    col.set_margin_end(6)
    # ── Sesión de red persistente + reCAPTCHA-friendly (WebKitGTK 6.0) ─────
    # GOG's login page embeds Google reCAPTCHA (recaptcha.net) in a
    # cross-origin iframe and its SSO providers live under
    # external-accounts.gog.com. WebKitGTK blocks third-party cookies by
    # default (ITP) and keeps the session in memory, which hangs the captcha
    # and the provider handshake. 6.0 removed the custom-WebContext
    # constructors (verified against WebKit-6.0.gir), so tune the default
    # network session instead: persistent credential storage, ITP off, and
    # cookies always accepted. The default session persists site data to
    # disk (non-ephemeral), so cookies survive between attempts.
    web = WebKit2.WebView()
    web.set_vexpand(True)
    web.set_hexpand(True)

    # --- Experimental social login in this same view (GOG only) ---
    # Epic needs none of this: its URL carries &display=popup, which makes
    # Epic render the provider "forward" INLINE in the same view, so it never
    # asks for a second window. GOG has no such parameter, so its social
    # buttons use window.open / target=_blank. Two env toggles (GOG only,
    # unset = current behaviour) let us probe that without a rebuild:
    #   CORKYTUX_GOG_SAMEWIN=1 -> inject the same-window shim below
    #   CORKYTUX_GOG_LAYOUT=<v> -> replace layout=client2 in the login URL
    # The popup blocks (decide-policy + create) stay as the safety net either
    # way, and the on_login_success capture is untouched.
    samewin = store == "gog" and os.environ.get("CORKYTUX_GOG_SAMEWIN") == "1"
    _dbg(f"toggles: samewin={'on' if samewin else 'off'} "
         f"layout={os.environ.get('CORKYTUX_GOG_LAYOUT') or 'default'}")
    if samewin:
        # UserContentManager of the view: user-content-manager is
        # construct-only in WebKit-6.0.gir, so the default manager is taken
        # from the getter and the script is added to it (add_script, gir
        # 20177). UserScript.new (gir 20987, "Creates a new user script")
        # injects into the PAGE's own world -- that is what makes it able to
        # replace the page's window.open. new_for_world (gir 21054, "for
        # script world with name @world_name") would inject into a separate
        # named world, where patching window.open would have NO effect.
        _SAMEWIN_JS = """(function(){
try {
  window.open = function(url) {
    try { if (url) { window.location.assign(url); } } catch(e) {}
    return window;
  };
  document.addEventListener("click", function(ev) {
    try {
      var a = ev.target && ev.target.closest && ev.target.closest("a[target]");
      if (a) { a.setAttribute("target", "_self"); }
    } catch(e) {}
  }, true);
} catch(e) {}
})();"""
        try:
            _script = WebKit2.UserScript.new(
                _SAMEWIN_JS,
                WebKit2.UserContentInjectedFrames.TOP_FRAME,
                WebKit2.UserScriptInjectionTime.START,
                None, None)
            web.get_user_content_manager().add_script(_script)
            _dbg("samewin: shim injected (window.open -> location.assign, target=_blank removed)")
        except Exception as e:
            samewin = False
            _dbg(f"samewin: shim not injected ({e})")

    def _relax_storage(ns):
        """Allow persistent credentials + third-party cookies so reCAPTCHA and
        the SSO popup pages work inside the embedded view. Each call is
        guarded: WebKitGTK 6.0 moved these knobs onto WebKitNetworkSession."""
        for name, arg in (("set_persistent_credential_storage_enabled", True),
                          ("set_itp_enabled", False)):
            try:
                getattr(ns, name)(arg)
            except Exception as e:
                _dbg(f"  _relax_storage {name}: {e}")
        try:
            ns.get_cookie_manager().set_accept_policy(WebKit2.CookieAcceptPolicy.ALWAYS)
        except Exception as e:
            _dbg(f"  cookie accept policy: {e}")

    try:
        _relax_storage(web.get_network_session())
    except Exception as e:
        _dbg(f"storage relaxation failed: {e}")
    try:
        settings = web.get_settings()
        settings.set_property("enable-javascript", True)
        settings.set_property("enable-media-stream", True)
    except Exception:
        pass
    try:
        # Auto-allow permission requests (media, geolocation, ...) so
        # recaptcha.net / external-accounts.gog.com never block on a prompt.
        web.connect("permission-request", lambda _w, req: (req.allow(), True)[1])
    except Exception:
        pass
    if store == "epic":
        try:
            s = web.get_settings()
            s.set_user_agent("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) EpicGamesLauncher")
            _dbg("User agent set to EpicGamesLauncher")
        except Exception as e:
            _dbg(f"set_user_agent failed: {e}")
    else:
        # GOG UA: CORKYTUX_GOG_UA env override (the plugin inherits the
        # launcher's environment — spawn_streaming_inner builds Command
        # without .env()/.env_clear(), so CORKYTUX_GOG_UA=default keeps
        # WebKit's own UA, any other value is used verbatim, and unset
        # keeps the prior Safari override for reCAPTCHA).
        ua_gog = os.environ.get("CORKYTUX_GOG_UA", "")
        try:
            s = web.get_settings()
            if ua_gog == "default":
                _dbg("GOG UA: CORKYTUX_GOG_UA=default -> keep WebKit default (no set_user_agent)")
            elif ua_gog:
                s.set_user_agent(ua_gog)
                _dbg(f"GOG UA: overridden via CORKYTUX_GOG_UA (len={len(ua_gog)})")
            else:
                s.set_user_agent("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.4 Safari/605.1.15")
                _dbg("GOG UA: default Safari override (CORKYTUX_GOG_UA unset)")
            _dbg(f"GOG UA active: {s.get_user_agent()}")
        except Exception as e:
            _dbg(f"GOG UA setup failed: {e}")

    col.append(web)
    hint = Gtk.Label(label="Sign in above — the code is captured automatically.")
    hint.set_wrap(True)
    col.append(hint)

    def grab_current():
        uri = web.get_uri() or ""
        _dbg(f"Grab button: uri={_sani_uri(uri)}")
        if try_extract_code_from_uri(uri):
            return
        hint.set_text("Reading page content…")
        try_extract_code_from_page()

    grab_btn = Gtk.Button(label="Grab code")
    grab_btn.connect("clicked", lambda *_: grab_current())
    col.append(grab_btn)
    win.set_child(col)

    # ─── Heroic's EXACT pattern: dom-ready + URL check ───
    # Heroic does NOT intercept decide-policy. It lets the page load
    # naturally, then checks webview.getURL() on dom-ready (= FINISHED).
    # For SSO popups, Heroic uses Electron's allowpopups + partition.

    def on_load_changed(_view, load_event):
        if load_event != WebKit2.LoadEvent.FINISHED:
            return
        uri = web.get_uri() or ""
        _dbg(f"FINISHED uri={_sani_uri(uri)}")

        # Heroic pattern: check URL directly
        if try_extract_code_from_uri(uri):
            return

        # Also try page content (Playnite pattern: regex in page source)
        _dbg("  Trying page content extraction...")
        try_extract_code_from_page()

    # ─── Social login popups: refused on every path ───
    # Two paths can request a new window and both are handled:
    #  1) window.open() → decide-policy/NEW_WINDOW_ACTION
    #  2) <a target="_blank"> → "create" directly, WITHOUT decide-policy
    #     (observed live: 0 NEW_WINDOW logs before the Google popup)
    # A host check is not reliable: on the create path the navigation has no
    # URI yet (get_request().get_uri() is empty/about:blank), which is exactly
    # why the earlier accounts.google.com-only guard let it through. Related
    # views also share the web process with the opener, so a crashing provider
    # page (Google did: WebProcessTerminationReason.CRASHED) takes the whole
    # login window down. So no child WebView is ever created: decide-policy
    # ignores the request and "create" always returns None (WebKit-6.0.gir:
    # "or %NULL to propagate the event further").
    def _block_popup(host: str):
        _dbg(f"popup blocked host={host}" if host else "popup blocked")
        try:
            hint.set_text("Social login is not available here; "
                          "use email/password or the manual code")
        except Exception:
            pass

    def on_decide(_view, decision, decision_type):
        # NAV/RESP are let through untouched (unhandled = accepted, as the
        # page relies on them). NEW_WINDOW is refused.
        if decision_type != WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION:
            return False
        host = ""
        try:
            uri = decision.get_navigation_action().get_request().get_uri() or ""
            from urllib.parse import urlparse
            host = urlparse(uri).hostname or ""  # hostname only, no query
        except Exception:
            host = ""
        _block_popup(host)
        try:
            decision.ignore()
            return True
        except Exception:
            return False

    def on_create(_view, navigation_action):
        # WebKitGTK 6.0 signal: returns the new WebKitWebView (a Gtk.Widget)
        # or NULL. Never returns a widget: no child view, no popup window.
        host = ""
        try:
            from urllib.parse import urlparse as _uparse
            popup_uri = navigation_action.get_request().get_uri() or ""
            host = _uparse(popup_uri).hostname or ""  # hostname only, no query
        except Exception:
            host = ""
        _block_popup(host)
        return None

    try:
        web.connect("create", on_create)
    except Exception as e:
        _dbg(f"create signal not available: {e}")
    web.connect("decide-policy", on_decide)
    web.connect("load-changed", on_load_changed)
    # Safety net: if the shared web process still dies mid-handshake (related
    # popup + provider SSO), reload the opener so the login window stays alive
    # instead of showing a dead blank page. Capped at 2 reloads.
    _terminations = [0]
    def on_web_process_terminated(_w, reason):
        # Bounded: a provider page that keeps killing the shared process must
        # not put the window in a reload loop. Two reloads to recover, then
        # stop and tell the user.
        _terminations[0] += 1
        n = _terminations[0]
        if n > 2:
            _dbg(f"WEB PROCESS TERMINATED (reason={reason!r}) - reload limit "
                 f"reached (2 reloads), not reloading again")
            try:
                hint.set_text("The login page keeps crashing. Use email/password, "
                              "or the manual code in the launcher.")
            except Exception:
                pass
            return
        _dbg(f"WEB PROCESS TERMINATED (reason={reason!r}) - reloading opener ({n}/2)")
        try:
            web.reload()
        except Exception as e:
            _dbg(f"reload after termination failed: {e}")
    try:
        web.connect("web-process-terminated", on_web_process_terminated)
    except Exception as e:
        _dbg(f"web-process-terminated not available: {e}")

    # ─── Instrumentación (WebKit-6.0.gir verificado) ───
    # console-message NO existe como señal en 6.0 (solo la propiedad
    # enable-write-console-messages-to-stdout) y resource-load-finished
    # tampoco: se usa load-failed (28550) + resource-load-started (28793),
    # monitorizando cada recurso con sus señales propias finished/failed +
    # get_response()/get_status_code(). URIs siempre vía _sani_uri.
    WATCH_HOSTS = ("gog.com", "recaptcha.net", "gstatic.com",
                   "external-accounts.gog.com", "google.com",
                   "accounts.google.com", "steamcommunity.com",
                   "login.live.com", "discord.com")

    def _watch_host(uri):
        try:
            from urllib.parse import urlparse
            host = (urlparse(uri).hostname or "").lower()
        except Exception:
            host = ""
        return any(host == w or host.endswith("." + w) for w in WATCH_HOSTS)

    def _res_uri(res):
        try:
            return res.get_uri() or ""
        except Exception:
            return ""

    def on_load_failed(_view, load_event, failing_uri, error):
        # gir: (LoadEvent, gchar*, GError) → gboolean
        try:
            _dbg(f"LOAD-FAILED ev={load_event} uri={_sani_uri(failing_uri)} "
                 f"dom={getattr(error, 'domain', '?')} code={getattr(error, 'code', '?')}")
        except Exception:
            pass

    def on_resource_started(_view, resource, request):
        # gir: (WebKitWebResource, WebKitURIRequest) → void
        uri = _res_uri(resource)
        if not _watch_host(uri):
            return
        try:
            _dbg(f"RES-START {_sani_uri(uri)}")
        except Exception:
            pass
        try:
            resource.connect("finished", _on_res_finished)
            resource.connect("failed", _on_res_failed)
        except Exception:
            pass

    def _on_res_finished(resource):
        try:
            resp = resource.get_response()
            status = resp.get_status_code() if resp else 0
            _dbg(f"RES-FINISHED status={status} uri={_sani_uri(_res_uri(resource))}")
        except Exception:
            pass

    def _on_res_failed(resource, error):
        try:
            _dbg(f"RES-FAILED dom={getattr(error, 'domain', '?')} code={getattr(error, 'code', '?')} "
                 f"uri={_sani_uri(_res_uri(resource))}")
        except Exception:
            pass

    try:
        web.connect("load-failed", on_load_failed)
    except Exception as e:
        _dbg(f"load-failed not available: {e}")
    try:
        web.connect("resource-load-started", on_resource_started)
    except Exception as e:
        _dbg(f"resource-load-started not available: {e}")

    # Poll: keeps checking URI + page content every 500s for 30s
    # Covers cases where load-changed misses the redirect
    poll_id = [None]
    def _schedule_poll():
        if poll_id[0] is not None:
            GLib.source_remove(poll_id[0])
        attempts = [0]
        def _poll():
            if got["code"]:
                poll_id[0] = None
                return False
            attempts[0] += 1
            if attempts[0] > 60:
                _dbg("Poll: 30s timeout")
                poll_id[0] = None
                return False
            uri = web.get_uri() or ""
            _dbg(f"Poll #{attempts[0]}: uri={_sani_uri(uri)}")
            if try_extract_code_from_uri(uri):
                poll_id[0] = None
                return False
            try_extract_code_from_page()
            return True
        poll_id[0] = GLib.timeout_add(500, _poll)

    # Start polling after first page load (covers SSO redirect chains)
    def _start_poll_after_first_load(_view, load_event):
        if load_event == WebKit2.LoadEvent.FINISHED and poll_id[0] is None:
            _schedule_poll()
    web.connect("load-changed", _start_poll_after_first_load)

    _dbg(f"Loading URL: {_sani_uri(_login_window_url(store), 160)}")
    web.load_uri(_login_window_url(store))
    win.present()
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    if poll_id[0] is not None:
        GLib.source_remove(poll_id[0])
    if not got["code"]:
        _dbg("No code captured")
        emit({"type": "done", "ok": True, "store": store, "code": ""})
    else:
        _dbg("Login window closing with code")


def _epic_offer_summary(el, now):
    """(is_active, pct, end_short) for the element's current offer window."""
    import datetime as _dt
    promos = el.get("promotions") or {}
    groups = promos.get("promotionalOffers") or []
    offers = (groups[0].get("promotionalOffers", []) if groups else [])
    for off in offers:
        try:
            pct = (off.get("discountSetting") or {}).get("discountPercentage", -1)
            start = _dt.datetime.fromisoformat(str(off.get("startDate", "")).replace("Z", "+00:00"))
            end = _dt.datetime.fromisoformat(str(off.get("endDate", "")).replace("Z", "+00:00"))
        except (ValueError, TypeError):
            continue
        if start <= now <= end:
            return True, pct, end.strftime("%m/%d")
    return False, -1, ""


def _epic_catalog():
    import urllib.request
    url = ("https://store-site-backend-static.ak.epicgames.com/"
           "freeGamesPromotions?locale=en-US&country=US&allowCountries=US")
    req = urllib.request.Request(url, headers={"User-Agent": "CorkyTux/3.0"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = json.loads(resp.read().decode())
    return (((((data.get("data") or {}).get("Catalog") or {}).get("searchStore") or {}).get("elements")) or [])


def _epic_catalog_cover(el):
    for im in el.get("keyImages", []) or []:
        if im.get("type") in ("OfferImageTall", "OfferImageWide", "DieselGameBoxTall") and im.get("url"):
            return im["url"]
    return ""


def _epic_search_url(title: str) -> str:
    import urllib.parse
    q = urllib.parse.quote_plus((title or "").strip())
    return f"https://store.epicgames.com/en-US/browse?q={q}" if q else ""


def _epic_page_slug(el) -> str:
    # catalogNs.mappings pageSlug is the authoritative store slug
    # (urlSlug is often a UUID or a stale-but-clean string that 404s).
    # Prefer the productHome mapping (info/demo/offer pages 500).
    try:
        maps = (el.get("catalogNs") or {}).get("mappings") or []
        ordered = sorted(maps, key=lambda m: 0 if (m or {}).get("pageType") == "productHome" else 1)
        for m in ordered:
            ps = str((m or {}).get("pageSlug") or "").split("?")[0].rstrip("/")
            if ps and "/" not in ps:
                return ps
    except Exception:
        pass
    return ""


def _epic_slug_url(el):
    # Real page slug first; urlSlug/productSlug heuristics next; store
    # search last (never 404s) so Open/Claim buttons always land somewhere.
    slug = _epic_page_slug(el)
    if not slug:
        slug = (el.get("urlSlug") or el.get("productSlug") or "").split("?")[0].rstrip("/")
        if "/" in slug or len(slug) == 32:
            slug = ""
    if slug:
        return f"https://store.epicgames.com/en-US/p/{slug}"
    return _epic_search_url(el.get("title", ""))


def _epic_price(el):
    total = ((el.get("price") or {}).get("totalPrice") or {})
    fmt = total.get("fmtPrice") or {}
    disc, orig = fmt.get("discountPrice") or "", fmt.get("originalPrice") or ""
    if (not disc or not orig) and total.get("currencyCode"):
        # Catalog search omits fmtPrice: format from cent numbers.
        cur = total.get("currencyCode") or "USD"
        sym = "$" if cur == "USD" else (cur + " ")
        try:
            d = float(total.get("discountPrice") or 0) / 100.0
            o = float(total.get("originalPrice") or 0) / 100.0
            if o > 0:
                disc, orig = f"{sym}{d:.2f}", f"{sym}{o:.2f}"
        except (ValueError, TypeError):
            pass
    return disc, orig, total.get("currencyCode") or ""


def _epic_sale_search(count=40, start=0):
    """One on-sale catalog page via the public store GraphQL (the weekly
    freeGamesPromotions feed only carries ~12 items). Returns (elements,
    catalog_total). The API caps pages at 40."""
    import urllib.request
    fields = """paging { total }
      elements {
        title description urlSlug productSlug
        catalogNs { mappings { pageSlug pageType } }
        keyImages { type url }
        price(country: "US") {
          totalPrice { discountPrice originalPrice currencyCode
                       fmtPrice { discountPrice originalPrice } }
        }
        promotions { promotionalOffers { promotionalOffers {
          startDate endDate discountSetting { discountPercentage } } } }
      }"""
    headers = {"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/126.0 Safari/537.36",
               "Content-Type": "application/json", "Accept": "application/json"}
    query = """query {
  Catalog {
    searchStore(category: "games", count: %d, country: "US", keywords: "",
                locale: "en-US", onSale: true, sortBy: "relevancy",
                sortDir: "DESC", start: %d) {
      %s
    }
  }
}""" % (max(1, min(40, count)), max(0, start), fields)
    body = json.dumps({"query": query}).encode()
    req = urllib.request.Request("https://store.epicgames.com/graphql", data=body, headers=headers)
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.loads(resp.read().decode())
    store = (((data.get("data") or {}).get("Catalog") or {}).get("searchStore") or {})
    return (store.get("elements") or [], (store.get("paging") or {}).get("total") or 0)


def _epic_price_pct(el) -> int:
    try:
        total = (el.get("price") or {}).get("totalPrice") or {}
        d, o = float(total.get("discountPrice") or 0), float(total.get("originalPrice") or 0)
        if o > 0 and d < o:
            return int(round((1.0 - d / o) * 100))
    except (ValueError, TypeError):
        pass
    return 0


def _epic_sale_page(start=0, count=40):
    """One catalog page + catalog total (UI paginates with --start)."""
    els, total = _epic_sale_search(count, start)
    return els, total


def cmd_epic_deals(args):
    import datetime as _dt
    start = max(0, int(getattr(args, "start", 0) or 0))
    count = max(1, min(40, int(getattr(args, "count", 0) or 40)))
    now = _dt.datetime.now(_dt.timezone.utc)
    out, seen, seen_urls = [], set(), set()
    total, fetched = 0, 0
    if start == 0:
        # Verified promo-window deals first (with end dates).
        # pct >= 100 is a free promo, not a deal (lives in Free games now).
        try:
            elements = _epic_catalog()
        except Exception:
            elements = []
        for el in elements:
            active, pct, end = _epic_offer_summary(el, now)
            if not active or pct <= 0 or pct >= 100:
                continue
            title = el.get("title", "")
            seen.add(title.casefold())
            disc, orig, _cur = _epic_price(el)
            out.append({"title": title,
                        "description": el.get("description", ""),
                        "cover": _epic_catalog_cover(el),
                        "discount": pct,
                        "price": disc, "base_price": orig,
                        "ends": end,
                        "store_url": _epic_slug_url(el)})
    # Catalog page (the full on-sale catalog, summer sale & co).
    try:
        extra, total = _epic_sale_page(start, count)
    except Exception as e:
        if start == 0 and not out:
            die(3, f"Could not fetch Epic offers: {e}")
        extra, total = [], 0
    for el in extra:
        title = el.get("title", "") or ""
        if not title or title.casefold() in seen:
            continue
        active, pct, end = _epic_offer_summary(el, now)
        if not active or pct <= 0:
            pct = _epic_price_pct(el)
            end = ""
        if pct <= 0 or pct >= 100:
            continue
        url = _epic_slug_url(el)
        if url in seen_urls:
            continue
        seen.add(title.casefold())
        seen_urls.add(url)
        disc, orig, _cur = _epic_price(el)
        out.append({"title": title,
                    "description": el.get("description", ""),
                    "cover": _epic_catalog_cover(el),
                    "discount": pct,
                    "price": disc, "base_price": orig,
                    "ends": end,
                    "store_url": url})
    fetched = len(extra)
    out.sort(key=lambda x: -(x["discount"] or 0))
    if not out and start == 0:
        die(3, "Could not fetch Epic offers")
    has_more = (start + fetched) < total if total else False
    emit({"type": "done", "ok": True, "store": "epic", "deals": out,
          "total": total, "next": start + fetched if has_more else start + fetched,
          "start": start, "count": count, "fetched": fetched,
          "has_more": has_more})


def cmd_gog_store_search(args):
    """Public GOG catalog search (no login): titles, covers, prices, links."""
    import urllib.request
    import urllib.parse
    try:
        url = ("https://catalog.gog.com/v1/catalog?query=search/"
               + urllib.parse.quote(args.query or "") + "&limit="
               + str(max(1, min(20, args.limit or 10))))
        req = urllib.request.Request(url, headers={"User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
    except Exception as e:
        die(3, f"GOG store search failed: {e}")
    out = []
    for p in data.get("products", []) or []:
        price = p.get("price") or {}
        devs = p.get("developers") or []
        out.append({
            "id": str(p.get("id", "")),
            "title": p.get("title", ""),
            "cover": p.get("coverHorizontal", "") or p.get("coverVertical", ""),
            "price": str(price.get("final", "")),
            "base_price": str(price.get("base", "")),
            "developer": devs[0] if devs else "",
            "store_url": p.get("storeLink", ""),
        })
    emit({"type": "done", "ok": True, "store": "gog", "results": out})


def cmd_eos_code(_args):
    """Epic Online Services exchange code for launching EOS games
    (Fall Guys & co. refuse to start without -auth_password=<code>).
    Same mechanism Heroic uses before every Epic launch."""
    import urllib.request
    user_path = Path.home() / ".config" / "legendary" / "user.json"
    try:
        udata = json.loads(user_path.read_text())
    except (OSError, ValueError):
        die(4, "Epic not logged in (no legendary session).")
    token = udata.get("access_token", "")
    if not token:
        die(4, "Epic session expired. Log in again.")
    try:
        req = urllib.request.Request(
            "https://account-public-service-prod03.ol.epicgames.com/account/api/oauth/exchange",
            headers={"Authorization": f"bearer {token}",
                     "User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
        code = data.get("code", "")
        if not code:
            die(4, "Epic rejected the session (expired?). Log in again.")
        emit({"type": "done", "ok": True,
              "code": code,
              "account_id": udata.get("account_id", ""),
              "display_name": udata.get("display_name", "")})
    except Exception as e:
        die(4, f"EOS exchange failed (session expired?): {e}")


UMU_DIR = Path.home() / ".local" / "share" / "CorkyTux" / "tools" / "umu"
UMU_BIN = UMU_DIR / "umu"


def _umu_bin():
    found = shutil.which("umu-run") or shutil.which("umu")
    if found:
        return found
    if UMU_BIN.is_file() and os.access(UMU_BIN, os.X_OK):
        return str(UMU_BIN)
    return ""


def cmd_umu_status(_args):
    emit({"type": "done", "ok": True, "available": bool(_umu_bin()),
          "path": _umu_bin()})


def cmd_umu_setup(_args):
    import urllib.request
    if _umu_bin():
        emit({"type": "done", "ok": True, "path": _umu_bin(),
              "note": "already installed"})
        return
    UMU_DIR.mkdir(parents=True, exist_ok=True)
    emit({"type": "progress", "stage": "fetching-umu-release", "percent": None})
    try:
        req = urllib.request.Request(
            "https://api.github.com/repos/Open-Wine-Components/umu-launcher/releases/latest",
            headers={"User-Agent": "CorkyTux/3.0", "Accept": "application/vnd.github+json"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            rel = json.loads(resp.read().decode())
        asset = next((a for a in rel.get("assets", [])
                      if "zipapp.tar" in a.get("name", "")), None)
        if not asset:
            die(2, "No umu zipapp in the latest release")
        emit({"type": "progress", "stage": "downloading-umu", "percent": 0})
        import tarfile
        import tempfile
        tmp = Path(tempfile.mkdtemp(prefix="umu-"))
        try:
            tgz = tmp / "umu.tar"
            req = urllib.request.Request(asset["browser_download_url"],
                                         headers={"User-Agent": "CorkyTux/3.0"})
            with urllib.request.urlopen(req, timeout=300) as resp, open(tgz, "wb") as f:
                shutil.copyfileobj(resp, f)
            with tarfile.open(tgz) as t:
                t.extractall(tmp, filter="data")
            cand = next((p for p in tmp.rglob("umu*")
                         if p.is_file() and os.access(p, os.X_OK)
                         and p.suffix not in (".tar", ".gz")), None)
            if not cand:
                cand = next((p for p in tmp.rglob("*")
                             if p.is_file() and p.name == "umu"), None)
            if not cand:
                die(3, "umu binary not found inside the release tarball")
            shutil.copy2(cand, UMU_BIN)
            os.chmod(UMU_BIN, 0o755)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
    except Exception as e:
        die(3, f"umu install failed: {e}")
    emit({"type": "done", "ok": True, "path": str(UMU_BIN)})


def cmd_free_promos(_args):
    try:
        import urllib.request
        url = ("https://store-site-backend-static.ak.epicgames.com/"
               "freeGamesPromotions?locale=en-US&country=US&allowCountries=US")
        req = urllib.request.Request(url, headers={"User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode())
    except Exception as e:
        die(3, f"Could not fetch promotions: {e}")
    import datetime as _dt
    now = _dt.datetime.now(_dt.timezone.utc)
    els = (((data.get("data") or {}).get("Catalog") or {}).get("searchStore") or {}).get("elements", [])
    out = []
    for el in els:
        promos = el.get("promotions") or {}
        groups = promos.get("promotionalOffers") or []
        offers = (groups[0].get("promotionalOffers", []) if groups else [])
        # Truly free = 100% off AND right now inside the offer window.
        # (Discounted-but-paid games like -20% must NOT appear here.)
        is_free = False
        for off in offers:
            try:
                pct = (off.get("discountSetting") or {}).get("discountPercentage", -1)
                start = _dt.datetime.fromisoformat(str(off.get("startDate", "")).replace("Z", "+00:00"))
                end = _dt.datetime.fromisoformat(str(off.get("endDate", "")).replace("Z", "+00:00"))
            except (ValueError, TypeError):
                continue
            if pct == 0 and start <= now <= end:
                is_free = True
                break
        if not is_free:
            continue
        cover = ""
        for im in el.get("keyImages", []) or []:
            if im.get("type") in ("OfferImageTall", "OfferImageWide", "DieselGameBoxTall") and im.get("url"):
                cover = im["url"]
                break
        out.append({"title": el.get("title", ""),
                    "description": el.get("description", ""),
                    "cover": cover,
                    "store_url": _epic_slug_url(el)})
    emit({"type": "done", "ok": True, "store": "epic", "free_now": out})


