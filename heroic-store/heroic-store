        emit({"type": "progress", "done": done, "total": total, "stage": title, "store": "epic"})
    emit({"type": "done", "ok": True, "store": "epic", "updated": updated, "total": total,
          "rescued": 0, "markers": 0})


_PROGRESS_RE = re.compile(r"(\d{1,3}(?:\.\d+)?)\s*%")


def _run_streaming(cmd, store):
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, bufsize=1)
    for line in proc.stdout:
        line = line.strip()
        if not line:
            continue
        m = _PROGRESS_RE.search(line)
        if m:
            try:
                pct = float(m.group(1))
            except ValueError:
                pct = None
            emit({"type": "progress", "stage": "downloading", "percent": pct, "store": store})
        else:
            emit({"type": "progress", "stage": line[:120], "percent": None, "store": store})
    proc.wait()
    return proc.returncode == 0


def _legendary_info(app_id: str):
    try:
        proc = subprocess.run([LEGENDARY_BIN, "info", app_id, "--json"],
                              capture_output=True, text=True, timeout=60)
        if proc.returncode != 0:
            return {}
        return json.loads(proc.stdout or "{}")
    except (ValueError, subprocess.TimeoutExpired, OSError):
        return {}


def cmd_install(args):
    store = args.store
    dest = Path(args.path or (Path.home() / "Games" / "Heroic")).expanduser()
    dest.mkdir(parents=True, exist_ok=True)
    if store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        ok = _run_streaming([LEGENDARY_BIN, "install", args.app_id, "-y",
                             "--base-path", str(dest)], store)
        if not ok:
            die(3, "legendary install failed")
        # Re-read AFTER install: pre-install info has no install section.
        info = _legendary_info(args.app_id)
        inst = info.get("install", {}) or {}
        game = info.get("game", {}) or {}
        platform = game.get("platform", "Windows")
        exe = inst.get("executable", "") or ""
        ipath = inst.get("install_path", "") or str(dest / args.app_id)
        if not exe and Path(ipath).is_dir():
            best, best_size = "", -1
            try:
                entries = list(Path(ipath).iterdir())
            except OSError:
                entries = []
            for p in entries:
                if not (p.is_file() and p.suffix.lower() == ".exe"):
                    continue
                stem = p.stem.lower()
                if any(s in stem for s in ("unins", "crashhandler", "setup", "redist", "vcredist", "installer")):
                    continue
                try:
                    sz = p.stat().st_size
                except OSError:
                    continue
                if sz > best_size:
                    best, best_size = p.name, sz
            exe = best
    else:
        _require_binary(GOGDL_BIN, "gogdl")
        # gogdl reads its tokens from --auth-config-path (global flag, before
        # the subcommand) and runs ANONYMOUS without it (auth.py
        # get_credentials -> None -> no Authorization header in api.py).
        ok = _run_streaming([GOGDL_BIN, "--auth-config-path", _gogdl_auth_file(),
                             "download", args.app_id,
                             "--path", str(dest), "--platform", "windows"], store)
        if not ok:
            die(3, "gogdl download failed")
        ipath, exe, platform = _gog_probe(dest, args.app_id)
    regs = _read_installs()
    regs[f"{store}:{args.app_id}"] = {"path": ipath, "exe": exe}
    _write_installs(regs)
    emit({"type": "done", "ok": True, "store": store, "app_id": args.app_id,
          "install_path": ipath, "executable": exe,
          "requires_wine": platform == "Windows"})


def _gog_probe(dest: Path, app_id: str):
    """Find the installed game dir + exe via `gogdl import`, fallback: biggest exe."""
    try:
        proc = subprocess.run([GOGDL_BIN, "import", str(dest)], capture_output=True,
                              text=True, timeout=60)
        data = json.loads(proc.stdout or "{}")
        game = data.get("game", {}) if isinstance(data, dict) else {}
        tasks = game.get("playTasks", []) or []
        for t in tasks:
            if (t.get("type") or "").lower() == "filetask" and str(t.get("path", "")).lower().endswith(".exe"):
                return str(dest), t["path"], "Windows"
        for t in tasks:
            if str(t.get("path", "")):
                return str(dest), t["path"], "Linux"
    except (ValueError, subprocess.TimeoutExpired, OSError):
        pass
    best, best_size = "", -1
    for root, _dirs, files in os.walk(dest):
        for f in files:
            if f.lower().endswith(".exe"):
                try:
                    sz = os.path.getsize(os.path.join(root, f))
                except OSError:
                    continue
                if sz > best_size:
                    best, best_size = os.path.join(root, f), sz
    if best:
        return str(dest), os.path.relpath(best, dest), "Windows"
    return str(dest), "", "Linux"


def _stale_cleanup_decision(install_path: str):
    """Guards shared by cleanup-stale (real run and --dry-run).

    Returns (allowed, reason). Reasons: "no_path" (registry entry without
    install_path), "folder_present" (the install folder exists again —
    never touch live files), "disk_unmounted" (parent folder missing while
    the path is under a mount prefix or outside the default base).
    allowed=True means the record is safe to drop: the folder is gone and
    either its parent exists or the path lives under the plugin's default
    base (~/Games/Heroic), which is never a mount point.
    """
    if not install_path:
        return False, "no_path"
    ipath = Path(install_path)
    if ipath.is_dir():
        return False, "folder_present"
    if not ipath.parent.is_dir():
        under_mount = any(
            ipath.is_relative_to(Path(p))
            for p in ("/mnt", "/media", "/run/media")
        )
        if under_mount or not ipath.is_relative_to(Path.home() / "Games" / "Heroic"):
            return False, "disk_unmounted"
    return True, None


def cmd_cleanup_stale(args):
    """Drop a stale Epic registry entry (record whose install folder is
    gone) so the next `install` respects the user's --base-path instead of
    legendary silently reusing the old install_path from the registry.

    Safe by construction: guards refuse to touch live folders or paths
    whose parent is missing under a mount prefix; the uninstall runs with
    --keep-files/--skip-uninstaller (pure registry drop, never deletes
    files); installed.json is backed up first (last 5 kept in CONFIG_DIR);
    success is verified by re-reading installed.json because legendary
    exits 0 even when its lock is held. --dry-run applies the guards and
    reports what would happen without touching anything.
    """
    if args.store != "epic":
        die(2, "cleanup-stale only supports the epic store")
    regs = _read_json(LEGENDARY_INSTALLED)
    if not isinstance(regs, dict):
        die(4, f"Could not read {LEGENDARY_INSTALLED}: expected the installed-games "
               f"object (is the legendary session ready?).")
    entry = regs.get(args.app_id)
    if not entry:
        emit({"type": "done", "ok": True, "store": "epic", "app_id": args.app_id,
              "cleaned": False, "reason": "no_record"})
        return
    ip = str(entry.get("install_path") or "")
    allowed, reason = _stale_cleanup_decision(ip)
    if args.dry_run:
        emit({"type": "done", "ok": True, "store": "epic", "app_id": args.app_id,
              "cleaned": False, "would_clean": allowed, "reason": reason,
              "install_path": ip})
        return
    if not allowed:
        if reason == "folder_present":
            die(7, f"The install folder already exists ({ip}); the record was NOT "
                   f"cleaned. Import the game instead.")
        if reason == "disk_unmounted":
            die(6, f"Install directory is not accessible ({Path(ip).parent} does not "
                   f"exist; disk probably unmounted). The record was NOT cleaned.")
        die(6, f"The registry entry of {args.app_id} has no install_path; "
               f"nothing to clean.")
    _require_binary(LEGENDARY_BIN, "legendary")
    # Backup installed.json (only the 5 most recent survive).
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    import time as _t
    ts = _t.strftime("%Y%m%d-%H%M%S")
    shutil.copy2(LEGENDARY_INSTALLED, CONFIG_DIR / f"installed.json.bak-{ts}")
    for bak in sorted(CONFIG_DIR.glob("installed.json.bak-*"))[:-5]:
        try:
            bak.unlink()
        except OSError:
            pass
    try:
        subprocess.run([LEGENDARY_BIN, "uninstall", "--keep-files",
                        "--skip-uninstaller", "-y", args.app_id],
                       capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        die(5, f"legendary uninstall timed out (120s) for {args.app_id}; "
               f"the record was NOT cleaned. Retry once no other Epic "
               f"operation is running.")
    # legendary exits 0 even when it could not take the installed.json lock
    # (cli.py returns without error); verify by re-reading the registry.
    regs2 = _read_json(LEGENDARY_INSTALLED)
    if isinstance(regs2, dict) and args.app_id in regs2:
        die(5, "The record was not cleaned: another Epic process holds the "
               "installed.json lock. Retry when it finishes.")
    regs = _read_installs()
    regs.pop(f"epic:{args.app_id}", None)
    _write_installs(regs)
    emit({"type": "done", "ok": True, "store": "epic", "app_id": args.app_id,
          "cleaned": True})


def cmd_uninstall(args):
    if args.store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        proc = subprocess.run([LEGENDARY_BIN, "uninstall", args.app_id, "-y"],
                              capture_output=True, text=True, timeout=120)
        if proc.returncode != 0:
            die(3, f"Uninstall failed: {(proc.stderr or proc.stdout).strip()[-200:]}")
    else:
        regs = _read_installs()
        info = regs.get(f"gog:{args.app_id}", {})
        path = info.get("path", "")
        if path and Path(path).is_dir():
            shutil.rmtree(path, ignore_errors=True)
        regs.pop(f"gog:{args.app_id}", None)
        _write_installs(regs)
    regs = _read_installs()
    regs.pop(f"{args.store}:{args.app_id}", None)
    _write_installs(regs)
    emit({"type": "done", "ok": True, "store": args.store, "app_id": args.app_id})


def _heroic_game_cfg(app_id: str):
    for base in (HEROIC_DIR / "GamesConfig", HEROIC_DIR / "sideload_apps"):
        for suffix in (".json", ""):
            p = base / f"{app_id}{suffix}"
            if p.is_file():
                data = _read_json(p)
                if isinstance(data, dict):
                    return data.get(app_id, data)
    return {}


def _heroic_titles():
    cache = HEROIC_DIR / "store_cache" / "legendary_install_info.json"
    data = _read_json(cache)
    out = {}
    if isinstance(data, dict):
        for k, v in data.items():
            if k.startswith("_") or not isinstance(v, dict):
                continue
            game = v.get("game", {}) if isinstance(v.get("game"), dict) else {}
            if game.get("title"):
                out[k] = game["title"]
    return out


def _legendary_list_installed(env_extra=None):
    try:
        env = os.environ.copy()
        if env_extra:
            env.update(env_extra)
        proc = subprocess.run([LEGENDARY_BIN, "list-installed", "--json"],
                              capture_output=True, text=True, timeout=60, env=env)
        if proc.returncode == 0:
            data = json.loads(proc.stdout or "[]")
            return data if isinstance(data, list) else []
    except (ValueError, subprocess.TimeoutExpired, OSError):
        pass
    return []


def _verify_path_exe(ip: str, exe: str) -> bool:
    """Single installed criterion shared by every store: the install dir
    exists AND the game executable exists inside it (executable is usually
    relative to the install dir; an empty exe only requires the dir)."""
    if not ip or not Path(ip).is_dir():
        return False
    if exe:
        ep = Path(exe)
        if not ep.is_absolute():
            ep = Path(ip) / exe
        return ep.is_file()
    return True


def _installed_status():
    """app_name -> {"installed": bool, "stale": bool, "install_path": str,
    "executable": str}.

    installed = legendary registry entry AND the install dir exists AND the
    game executable exists on disk (executable is usually relative to the
    install dir). stale = registry entry present but the files are gone:
    the game is still listed so the launcher offers Install instead of
    Import, and installed.json is never edited here. install_path and
    executable are echoed from the registry so a verified game can be
    imported with its real folder/exe (a broken import must not fall back
    to a guessed default dir).
    """
    out = {}
    for g in _legendary_list_installed():
        app = g.get("app_name")
        if not app:
            continue
        ip = str(g.get("install_path") or "")
        exe = str(g.get("executable") or "")
        ok = _verify_path_exe(ip, exe)
        out[app] = {"installed": ok, "stale": not ok,
                    "install_path": ip, "executable": exe}
    return out


def _gog_installed_status():
    """app_id -> {"installed": bool, "stale": bool, "install_path": str,
    "executable": str} for GOG, using the plugin's own registry
    (installs.json, written by cmd_install and read by launch-info). Same
    single criterion as Epic: registry entry AND install dir exists AND
    executable exists on disk. GOG has no external list-installed to query,
    so installs.json is the only reliable source; a game installed outside
    the launcher (Heroic/Galaxy) simply has no entry and shows as not
    installed (Install), never as a false 'installed'.
    """
    out = {}
    for key, info in _read_installs().items():
        if not key.startswith("gog:") or not isinstance(info, dict):
            continue
        app = key.split(":", 1)[1]
        if not app:
            continue
        ip = str(info.get("path") or "")
        exe = str(info.get("exe") or "")
        ok = _verify_path_exe(ip, exe)
        out[app] = {"installed": ok, "stale": not ok,
                    "install_path": ip, "executable": exe}
    return out


def _pretty_dir_title(dirname: str) -> str:
    name = re.sub(r"(GgG\d+|EGS_?\d*|_?\d{4,})$", "", dirname).strip(" _-")
    name = re.sub(r"(?<!^)(?=[A-Z][a-z])", " ", name).strip()
    return re.sub(r"\s+", " ", name) or dirname


_SKIP_EXE = ("crashhandler", "crashpad", "unins", "setup", "redist",
              "vcredist", "dxsetup", "dotnet", "language_setup", "installer",
              "uninstall", "config", "launcher_update")


def _find_exe(root: Path):
    """Game exe within 1 level: skip helpers/crashhandlers, prefer a name
    resembling the folder, else the biggest remaining candidate."""
    try:
        top = list(root.iterdir())
    except OSError:
        return "", False
    subdirs = [p for p in top if p.is_dir()]
    # container guard: several subdirs each holding an exe = collection folder
    with_exe = 0
    for sub in subdirs:
        try:
            if any(f.is_file() and f.suffix.lower() == ".exe" for f in sub.iterdir()):
                with_exe += 1
        except OSError:
            continue
    if with_exe >= 2:
        return "", False
    cands = []
    for base in [root] + subdirs:
        try:
            entries = list(base.iterdir())
        except OSError:
            continue
        for p in entries:
            if not p.is_file() or p.suffix.lower() != ".exe":
                continue
            stem = p.stem.lower()
            if any(s in stem for s in _SKIP_EXE):
                continue
            try:
                sz = p.stat().st_size
            except OSError:
                continue
            if sz < 50 * 1024:
                continue
            cands.append((str(p.relative_to(root)), stem, sz))
    if not cands:
        for base in [root] + subdirs:
            try:
                entries = list(base.iterdir())
            except OSError:
                continue
            for p in entries:
                if p.is_file() and not p.suffix and os.access(p, os.X_OK):
                    return str(p.relative_to(root)), False
        return "", True
    norm = re.sub(r"[^a-z0-9]", "", root.name.lower())
    named = [c for c in cands if c[1].replace(" ", "") and
             (norm in c[1].replace(" ", "") or c[1].replace(" ", "") in norm)]
    pool = named or cands
    best = max(pool, key=lambda c: c[2])
    return best[0], True


def cmd_heroic_scan(_args):
    games = []
    seen_paths = set()
    titles = _heroic_titles()

    def push(store, app, title, version, ipath, exe, platform, eac, battleye):
        if not ipath or ipath in seen_paths:
            return
        seen_paths.add(ipath)
        games.append({
            "store": store, "app_id": app or Path(ipath).name,
            "title": title or _pretty_dir_title(Path(ipath).name),
            "version": version, "install_path": ipath, "executable": exe,
            "platform": platform, "requires_wine": platform == "Windows",
            "eac": bool(eac), "battleye": bool(battleye),
        })

    if Path(LEGENDARY_BIN).exists() or shutil.which("legendary"):
        # 1) own session installs
        for g in _legendary_list_installed():
            app = g.get("app_name", "")
            if not app:
                continue
            info = _legendary_info(app)
            game = info.get("game", {}) or {}
            inst = info.get("install", {}) or {}
            platform = game.get("platform", "Windows")
            push("epic", app, game.get("app_title") or titles.get(app) or g.get("title") or app,
                 inst.get("version") or g.get("version", ""),
                 inst.get("install_path") or g.get("install_path", ""),
                 inst.get("executable") or g.get("executable", ""),
                 platform, False, False)
        # 2) Heroic's own session installs (read-only: import only)
        heroic_leg = HEROIC_DIR / "legendaryConfig" / "legendary"
        if heroic_leg.is_dir():
            hero_env = {"LEGENDARY_CONFIG_PATH": str(heroic_leg)}
            hero_list = _legendary_list_installed(hero_env)
            missing = [g.get("app_name", "") for g in hero_list
                       if g.get("app_name") and not titles.get(g.get("app_name", ""))]
            hero_names = {}
            for app in missing:
                try:
                    env = os.environ.copy()
                    env.update(hero_env)
                    proc = subprocess.run(
                        [LEGENDARY_BIN, "info", app, "--json"],
                        capture_output=True, text=True, timeout=60, env=env)
                    if proc.returncode == 0:
                        gg = json.loads(proc.stdout or "{}").get("game") or {}
                        hero_names[app] = gg.get("title") or gg.get("app_title", "")
                except (ValueError, subprocess.TimeoutExpired, OSError):
                    continue
            for g in hero_list:
                app = g.get("app_name", "")
                if not app:
                    continue
                cfg = _heroic_game_cfg(app)
                ipath = g.get("install_path", "")
                title = (titles.get(app) or hero_names.get(app) or ""
                         or (g.get("app_title", "") if isinstance(g.get("app_title"), str) else ""))
                if not title and ipath:
                    title = _pretty_dir_title(Path(ipath).name)
                push("epic", app, title or app, g.get("version", ""),
                     ipath, g.get("executable", ""),
                     "Windows", cfg.get("eacRuntime", False),
                     cfg.get("battlEyeRuntime", False))
    # 3) filesystem fallback ONLY inside Heroic's own folder: game dirs
    # with an exe but no legendary record (killed/incomplete downloads).
    # Never ~/Games as a whole — those are GOG/manual games, not Heroic.
    roots = []
    for cand in (Path.home() / "Games" / "Heroic",):
        if cand.is_dir():
            roots.append(cand)
    for root in roots:
        try:
            subdirs = [p for p in root.iterdir() if p.is_dir()]
        except OSError:
            continue
        for d in subdirs:
            if d.name in ("Prefixes", "Heroic", "CommonRedist", "__redist"):
                continue
            if str(d) in seen_paths:
                continue
            exe, wine = _find_exe(d)
            if not exe:
                continue
            push("epic", d.name, _pretty_dir_title(d.name), "",
                 str(d), exe, "Windows" if wine else "Linux", False, False)
    eac = EAC_RUNTIME.is_dir()
    be = BE_RUNTIME.is_dir()
    emit({"type": "done", "ok": True, "games": games,
          "runtimes": {"eac": eac, "battleye": be,
                       "eac_path": str(EAC_RUNTIME) if eac else "",
                       "battleye_path": str(BE_RUNTIME) if be else ""}})


