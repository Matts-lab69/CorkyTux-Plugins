                return
        match = cat.get(str(title).casefold())
        if _describe_game(app_id, title, lang, g, match):
            updated += 1
        done += 1
        emit({"type": "progress", "done": done, "total": total, "stage": title, "store": "epic"})
    emit({"type": "done", "ok": True, "store": "epic", "updated": updated, "total": total,
          "rescued": 0, "markers": 0})


_PROGRESS_RE = re.compile(r"(\d{1,3}(?:\.\d+)?)\s*%")
_GOG_PROGRESS_RE = re.compile(r"=\s*Progress:\s*(\d+(?:\.\d+)?)\s+(\d+)\s*/\s*(\d+)")
_GOG_ETA_RE = re.compile(r"ETA:\s*(\d+):(\d+):(\d+)")
_GOG_SPEED_RE = re.compile(r"([0-9]+(?:\.[0-9]+)?)\s*MiB/s\s*\(raw\)")


def _parse_progress_line(line: str):
    """Línea de log gogdl/legendary → dict de evento o None si no es progreso.
    Pura (sin IO): la cubren los tests sin red. NOTA: written_raw/total_raw
    son contadores sin unidad confirmada (NO afirmar bytes hasta captura
    real); percent y eta_s sí son seguros por construcción."""
    m = _GOG_PROGRESS_RE.search(line)
    if m:
        eta = None
        me = _GOG_ETA_RE.search(line)
        if me:
            eta = int(me.group(1)) * 3600 + int(me.group(2)) * 60 + int(me.group(3))
        return {"stage": "downloading", "percent": float(m.group(1)),
                "written_raw": int(m.group(2)), "total_raw": int(m.group(3)),
                "eta_s": eta}
    ms = _GOG_SPEED_RE.search(line)
    if ms:
        return {"stage": "downloading", "percent": None,
                "speed_mibs": float(ms.group(1))}
    m = _PROGRESS_RE.search(line)
    if m:
        try:
            pct = float(m.group(1))
        except ValueError:
            pct = None
        return {"stage": "downloading", "percent": pct}
    return None


def _run_streaming(cmd, store, ppid=0):
    import signal
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, bufsize=1)
    prev_term = signal.getsignal(signal.SIGTERM)

    def _on_term(_signo, _frame):
        # Cancelación del launcher: terminar gogdl antes de salir
        # (terminate, 2 s de gracia, kill). El marker partial queda y
        # permite reanudar.
        try:
            proc.terminate()
            try:
                proc.wait(timeout=2)
            except subprocess.TimeoutExpired:
                proc.kill()
        finally:
            try:
                signal.signal(signal.SIGTERM, prev_term)
                os.kill(os.getpid(), signal.SIGTERM)
            except Exception:
                os._exit(128 + 15)

    signal.signal(signal.SIGTERM, _on_term)
    speed = None
    last_emit = 0.0
    first = True
    pending = None
    try:
        for line in proc.stdout:
            # Self-exit si el launcher murió. LIMITACIÓN explícita: solo
            # corre al llegar una línea; un gogdl colgado sin salida no lo
            # dispara (lo cubre el watchdog/kill del launcher en el paso d).
            if ppid:
                try:
                    if os.getppid() != ppid:
                        proc.kill()
                        return False
                except Exception:
                    proc.kill()
                    return False
            line = line.strip()
            if not line:
                continue
            ev = _parse_progress_line(line)
            if ev is None:
                ev = {"stage": line[:120], "percent": None}
            elif ev.get("speed_mibs") is not None and ev.get("percent") is None:
                speed = ev["speed_mibs"]
                continue  # velocidad sola: se adjunta al próximo Progress
            else:
                if ev.get("percent") is not None and speed is not None:
                    ev["speed_mibs"] = speed
            ev["store"] = store
            # Throttle ~2/s: siempre el primero y el último (pending).
            now = time.monotonic()
            if first or now - last_emit >= 0.5:
                if pending is not None:
                    emit(pending)
                    pending = None
                emit(ev)
                last_emit = now
                first = False
            else:
                pending = ev
        if pending is not None:
            emit(pending)
            pending = None
    finally:
        try:
            signal.signal(signal.SIGTERM, prev_term)
        except Exception:
            pass
    proc.wait()
    return proc.returncode == 0


