def cmd_eos_code(_args):
    """Epic Online Services exchange code for launching EOS games
    (Fall Guys & co. refuse to start without -auth_password=<code>).
    Same mechanism Heroic uses before every Epic launch."""
    import urllib.request
    user_path = Path.home() / ".config" / "legendary" / "user.json"
    try:
        udata = json.loads(user_path.read_text())
    except (OSError, ValueError):
        die(4, "Epic not logged in (no legendary session).")
    token = udata.get("access_token", "")
    if not token:
        die(4, "Epic session expired. Log in again.")
    try:
        req = urllib.request.Request(
            "https://account-public-service-prod03.ol.epicgames.com/account/api/oauth/exchange",
            headers={"Authorization": f"bearer {token}",
                     "User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
        code = data.get("code", "")
        if not code:
            die(4, "Epic rejected the session (expired?). Log in again.")
        emit({"type": "done", "ok": True,
              "code": code,
              "account_id": udata.get("account_id", ""),
              "display_name": udata.get("display_name", "")})
    except Exception as e:
        die(4, f"EOS exchange failed (session expired?): {e}")


