# carpetas de Heroic (~/.config/heroic_gogdl) para no colisionar si el
# usuario también usa Heroic. Solo afecta a gogdl hijo (auth va por
# --auth-config-path explícito, ya separada).
os.environ.setdefault("GOGDL_CONFIG_PATH", str(CONFIG_DIR / "gogdl"))
# Shared Steam API minimum gap, enforced across plugin processes via a
# timestamp file (the launcher can run a library refresh and modal
# game-info calls at the same time; a per-process sleep would let the two
# overlap).
