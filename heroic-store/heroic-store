def _find_bin(name: str):
    found = shutil.which(name)
    if found:
        return found
    cand = CONFIG_DIR / "bin" / name
    if cand.is_file():
        return str(cand)
    return str(cand)


LEGENDARY_BIN = _find_bin("legendary")
GOGDL_BIN = _find_bin("gogdl")


def emit(event: dict):
    print(json.dumps(event), flush=True)


def die(code: int, message: str):
    # `code` lets the launcher differentiate error kinds (e.g. no suffix
    # "(codes expire fast...)" when the binary is missing). The launcher's
    # JSON parser ignores unknown fields, so this stays backward compatible.
    emit({"type": "error", "code": code, "message": message})
    sys.exit(code)


def _auth_dbg(msg):
    """Trace the manual auth flow (browser + pasted code) to a log file so a
    failed login is diagnosable: the login-window flow logs to
    /tmp/corkytux_sso_debug.log, this one logs to /tmp/corkytux_auth_debug.log."""
    try:
        import time
        with open("/tmp/corkytux_auth_debug.log", "a") as f:
            f.write(f"[{time.strftime('%H:%M:%S')}] {msg}\n")
    except Exception:
        pass


def _require_binary(path: str, name: str):
    if not Path(path).exists() and shutil.which(name) is None:
        die(5, f"{name} not found. Run `setup` to download it, or place it at {path}")


def cmd_setup(_args):
    import platform as _plat
    import urllib.request
    if _plat.machine() not in ("x86_64", "AMD64"):
        die(2, f"Auto-download only supports x86_64 (this is {_plat.machine()}). Install legendary/gogdl manually.")
    bindir = CONFIG_DIR / "bin"
    bindir.mkdir(parents=True, exist_ok=True)
    got, failed = [], []
    jobs = [
        ("legendary", bindir / "legendary",
         "https://github.com/legendary-gl/legendary/releases/latest/download/legendary_linux_x64"),
        ("gogdl", bindir / "gogdl",
         "https://github.com/Heroic-Games-Launcher/heroic-gogdl/releases/latest/download/gogdl_linux_x86_64"),
    ]
    for name, dest, url in jobs:
        if dest.is_file() or shutil.which(name):
            got.append(f"{name} (already present)")
            continue
        emit({"type": "progress", "stage": f"downloading-{name}", "percent": None})
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "CorkyTux/3.0"})
            with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as f:
                shutil.copyfileobj(resp, f)
            os.chmod(dest, 0o755)
            got.append(name)
        except Exception as e:
            if dest.exists():
                dest.unlink(missing_ok=True)
            failed.append(f"{name}: {e}")
    if failed and not got:
        die(3, "Setup failed: " + "; ".join(failed))
    emit({"type": "done", "ok": True, "installed": got, "failed": failed})


def _read_json(path: Path):
    try:
        return json.loads(path.read_text())
    except OSError:
        return None
    except ValueError:
        pass
    # Archivo a medio escribir por gogdl (rota el token y reescribe el
    # fichero entero): reintenta antes de declararlo ilegible.
    for _ in range(2):
        time.sleep(0.1)
        try:
            return json.loads(path.read_text())
        except (OSError, ValueError):
            pass
    return None


def _atomic_write_json(path: Path, payload: str, mode: int = 0) -> None:
    """Escritura atómica (tmp + rename). Con mode != 0 el tmp nace ya con
    esos permisos (tokens: nada legible por otros ni por un instante)."""
    tmp = path.with_name(path.name + ".tmp")
    if mode:
        fd = os.open(tmp, os.O_CREAT | os.O_TRUNC | os.O_WRONLY, mode)
        with os.fdopen(fd, "w") as f:
            f.write(payload)
    else:
        tmp.write_text(payload)
    os.replace(tmp, path)


def _read_installs():
    data = _read_json(INSTALLS_JSON)
    return data if isinstance(data, dict) else {}


def _write_installs(data: dict):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    _atomic_write_json(INSTALLS_JSON, json.dumps(data, indent=2))


def _epic_account_name():
    try:
        udata = json.loads((Path.home() / ".config" / "legendary" / "user.json").read_text())
        if udata.get("displayName"):
            return str(udata["displayName"])
    except (OSError, ValueError):
        pass
    return ""


def _gogdl_auth_file() -> str:
    """Create gogdl's token file 0600 BEFORE gogdl writes it: gogdl uses a
    plain open(path, "w") (auth.py __write_config), so a file it creates
    itself would land with the process umask (0644). Pre-creating it with
    os.open(..., 0o600) is the primary defence; the chmod only fixes a file
    left behind by an older build.

    The file is created holding a valid empty JSON object, NOT empty. gogdl's
    __read_config only guards on os.path.exists(), so an existing zero-byte
    file reaches json.loads("") and raises JSONDecodeError: gogdl then dies
    with a traceback before it ever contacts GOG, and the login fails with a
    bare "rc=1" no matter how good the authorization code was. A missing file
    is fine (credentials_data stays {}); an empty one is not."""
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        if not GOGDL_AUTH_JSON.exists():
            # O_EXCL: si aparece entre el exists() y el open(), no se pisa.
            fd = os.open(GOGDL_AUTH_JSON, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            try:
                os.write(fd, b"{}")
            finally:
                os.close(fd)
        elif GOGDL_AUTH_JSON.stat().st_size == 0:
            # Un intento anterior dejo el archivo vacio. gogdl no lo tolera.
            GOGDL_AUTH_JSON.write_text("{}")
        os.chmod(GOGDL_AUTH_JSON, 0o600)
    except OSError:
        return str(GOGDL_AUTH_JSON)
    return str(GOGDL_AUTH_JSON)


def _gogdl_entry() -> dict:
    """gogdl's credential entry for our client (gogdl/auth.py keys the file by
    client_id; its CLIENT_ID is the same 46899977096215655 we use)."""
    data = _read_json(GOGDL_AUTH_JSON)
    if not isinstance(data, dict):
        return {}
    entry = data.get(GOG_CLIENT_ID)
    return entry if isinstance(entry, dict) else {}


def _gog_refresh_token() -> str:
    return str(_gogdl_entry().get("refresh_token", "") or "")


def _gogdl_store_entry(entry: dict, refresh_used: str = "") -> None:
    """Write a refreshed entry back in gogdl's own format, because GOG rotates
    the refresh_token: keeping our own copy would leave gogdl with a stale one
    and break every download. Mirrors auth.py refresh_credentials
    (entry + loginTime, whole file rewritten, 0600)."""
    data = _read_json(GOGDL_AUTH_JSON)
    if not isinstance(data, dict):
        data = {}
    # Compare-and-swap: si gogdl rotó desde nuestra lectura, su entrada es
    # la válida y la nuestra (derivada del token viejo) está muerta: no
    # escribir. cur ausente o sin refresh_token (None/"") NO es rotación:
    # se escribe igual.
    cur = data.get(GOG_CLIENT_ID)
    cur_rt = cur.get("refresh_token") if isinstance(cur, dict) else None
    if cur_rt not in (None, "", refresh_used):
        _auth_dbg("access_token: gogdl rotated meanwhile, keeping its entry")
        return
    stored = dict(entry)
    stored["loginTime"] = time.time()
    data[GOG_CLIENT_ID] = stored
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        _atomic_write_json(GOGDL_AUTH_JSON, json.dumps(data), mode=0o600)
        os.chmod(GOGDL_AUTH_JSON, 0o600)
    except OSError as e:
        _auth_dbg(f"access_token: could not store rotated token ({type(e).__name__})")


def _gog_account_name():
    # Real session check: refresh -> access token -> userData.json -> username.
    access = _gog_access_token()
    if not access:
        return ""
    try:
        import urllib.request
        req = urllib.request.Request("https://embed.gog.com/userData.json",
                                     headers={"Authorization": f"Bearer {access}",
                                              "User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            data = json.loads(resp.read().decode())
        return str(data.get("username", ""))
    except Exception:
        return ""


def _gog_logged_in() -> str:
    """Real GOG session check (refresh -> access token -> userData.json ->
    username). Returns the account name, or "" when the session is dead."""
    return _gog_account_name()


STATUS_CACHE = CONFIG_DIR / ".status_cache.json"


def _status_cache_invalidate() -> bool:
    """Borra el caché de `status` (bins/sesión). Las demás cachés
    (rails TTL, descriptions con prune en refresh) no cambian con
    install/uninstall: se invalidan por su propia vía."""
    try:
        STATUS_CACHE.unlink()
        return True
    except OSError:
        return not STATUS_CACHE.exists()


def _status_cache_get(max_age_s=60):
    try:
        d = json.loads(STATUS_CACHE.read_text())
        import time as _t
        if _t.time() - float(d.get("ts", 0)) <= max_age_s:
            return d.get("payload")
    except (OSError, ValueError, TypeError):
        pass
    return None


def _status_cache_set(payload):
    try:
        import time as _t
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        STATUS_CACHE.write_text(json.dumps({"ts": _t.time(), "payload": payload}))
    except OSError:
        pass


