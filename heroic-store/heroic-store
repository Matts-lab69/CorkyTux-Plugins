def cmd_status(args):
    quick = bool(getattr(args, "quick", False))
    if quick:
        cached = _status_cache_get()
        if cached is not None:
            emit({"type": "done", "ok": True, **cached, "cached": True})
            return
    epic_bin = Path(LEGENDARY_BIN).exists() or shutil.which("legendary") is not None
    gog_bin = Path(GOGDL_BIN).exists() or shutil.which("gogdl") is not None
    epic_logged = False
    epic_name = ""
    if epic_bin:
        try:
            proc = subprocess.run([LEGENDARY_BIN, "status"], capture_output=True,
                                  text=True, timeout=8)
            epic_logged = "not logged in" not in (proc.stdout + proc.stderr).lower()
        except (OSError, subprocess.TimeoutExpired):
            epic_logged = False
        if epic_logged and not quick:
            epic_name = _epic_account_name()
    gog_logged = False
    gog_name = ""
    if _gog_refresh_token():
        gog_logged = True
        if not quick:
            gog_name = _gog_account_name()
            if not gog_name:
                gog_logged = False
    payload = {
          "bins": {"epic": epic_bin, "gog": gog_bin},
          "logged": {"epic": epic_logged, "gog": gog_logged},
          "accounts": {"epic": epic_name, "gog": gog_name},
          "heroic": {"installed": HEROIC_DIR.is_dir(),
                     "eac_runtime": EAC_RUNTIME.is_dir(),
                     "battleye_runtime": BE_RUNTIME.is_dir()}}
    _status_cache_set(payload)
    emit({"type": "done", "ok": True, **payload, "cached": False})


def cmd_logout(args):
    if args.store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        subprocess.run([LEGENDARY_BIN, "auth", "--delete"],
                       capture_output=True, timeout=60)
        emit({"type": "done", "ok": True, "store": "epic"})
        return
    # The session lives in gogdl's token file; the legacy plugin-only copy is
    # removed too in case an older build left one behind.
    for f in (GOGDL_AUTH_JSON, LEGACY_GOG_TOKEN_JSON):
        try:
            f.unlink(missing_ok=True)
        except OSError:
            pass
    emit({"type": "done", "ok": True, "store": "gog"})


def _epic_logged_in() -> str:
    """Account name or '' — legendary 0.21 exits 0 even on failed login,
    so the return code is useless; verify the session for real."""
    try:
        proc = subprocess.run([LEGENDARY_BIN, "status"], capture_output=True,
                              text=True, timeout=30)
        for line in (proc.stdout or "").splitlines():
            if line.startswith("Epic account:"):
                name = line.split(":", 1)[1].strip()
                return "" if "not logged in" in name.lower() else name
    except (OSError, subprocess.TimeoutExpired):
        pass
    return ""


def _epic_do_auth(args_list, timeout=120) -> str:
    try:
        proc = subprocess.run(args_list, capture_output=True, text=True,
                              timeout=timeout)
        return (proc.stderr or proc.stdout or "")
    except subprocess.TimeoutExpired:
        return "timed out"


def cmd_auth(args):
    store = args.store
    if store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        if args.code:
            code = args.code.strip().strip('"').strip("'")
            _epic_do_auth([LEGENDARY_BIN, "auth", "--code", code])
            name = _epic_logged_in()
            if not name:
                # Fallback: pasted value may be a session id (sid).
                _epic_do_auth([LEGENDARY_BIN, "auth", "--sid", code])
                name = _epic_logged_in()
            if not name:
                die(4, "Epic login failed: the code/sid was rejected. Get a fresh code (it expires fast) and try again.")
            emit({"type": "done", "ok": True, "store": "epic", "account": name})
            return
        import urllib.parse
        redirect = (f"https://www.epicgames.com/id/api/redirect?clientId={EPIC_CLIENT_ID}"
                    "&responseType=code")
        # Login-first: Epic only fills authorizationCode when the session
        # already exists. Going straight to the redirect URL with no
        # session returns nulls, so force the login screen first — after
        # login Epic lands on the JSON with the codes filled in.
        url = ("https://www.epicgames.com/id/login?redirectUrl="
               + urllib.parse.quote(redirect, safe=""))
        # No code on purpose: the launcher opens a dedicated browser window and
        # captures the code itself. Calling webbrowser.open here would open a
        # SECOND tab in the user's own browser, where nobody is watching for the
        # code, and the launcher would time out waiting for it.
        _auth_dbg("auth epic: MARCADOR-EPIC-NO-ABRE-NAVEGADOR-v2")
        emit({"type": "auth_url", "store": "epic", "url": url,
              "instructions": "1) Log in to Epic in the window that just opened (solve any captcha, you must see your avatar). 2) Nothing else: the code is picked up automatically."})
        return
    _require_binary(GOGDL_BIN, "gogdl")
    if args.code:
        import urllib.parse as _up
        raw = args.code.strip().strip('"').strip("'")
        code = raw
        # Tolerate pasting the whole final URL (or its query/fragment) instead
        # of the bare code value — the most common copy-paste mistake.
        if "://" in raw or raw.startswith(("?", "#")):
            parsed = _up.urlparse(raw if "://" in raw else "https://x/" + raw)
            code = (_up.parse_qs(parsed.query).get("code")
                    or _up.parse_qs(parsed.fragment).get("code") or [""])[0]
        if not code:
            die(4, "No valid code found — copy the value of 'code' from the final URL (it expires in ~1 min) and paste just that.")
        _auth_dbg(f"auth gog: code len={len(code)} (raw len={len(raw)})")
        # The authorization code is SINGLE-USE, so it is spent exactly once,
        # by gogdl, which owns the token file from now on. gogdl is also the
        # only one that can do it correctly: its token endpoint call carries
        # client_id AND client_secret (auth.py CODE_URL), while the plugin's
        # own exchange sent neither secret nor config and always got HTTP 400.
        # --auth-config-path is a GLOBAL flag, so it goes before `auth`.
        # gogdl writes the token JSON (0600, pre-created above) AND prints it
        # on stdout; stdout is parsed here but never logged, and neither is
        # the parsed JSON or any token value.
        auth_file = _gogdl_auth_file()
        try:
            proc = subprocess.run([GOGDL_BIN, "--auth-config-path", auth_file,
                                   "auth", "--code", code],
                                  capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.TimeoutExpired):
            die(5, "Could not run gogdl. Run `setup` in the Stores tab and retry.")
        out = (proc.stdout or "").strip()
        _auth_dbg(f"gogdl auth rc={proc.returncode} stdout_len={len(out)}")
        data = None
        try:
            data = json.loads(out) if out else None
        except ValueError:
            data = None
        if not isinstance(data, dict) or not data.get("refresh_token"):
            # gogdl prints {"error": true} (rc=0!) when GOG refuses the code,
            # and a traceback (rc!=0) if the file cannot be written, so the
            # return code alone cannot be trusted.
            _auth_dbg("gogdl auth: no refresh_token in response (rc="
                      + str(proc.returncode) + ")")
            die(4, "GOG rejected the code or it expired (gogdl rc="
                   + str(proc.returncode) + "). Open ONE fresh tab and retry.")
        _auth_dbg("gogdl auth: refresh_token stored (len="
                  + str(len(data["refresh_token"])) + ")")
        _auth_dbg("exchange OK, checking real session")
        account = _gog_logged_in()
        if not account:
            _auth_dbg("session check failed")
            die(4, "Login completed but the GOG session could not be confirmed (userData check failed). Retry with a fresh code, or check your network.")
        _auth_dbg("session check OK, emitting done")
        emit({"type": "done", "ok": True, "store": "gog", "account": account})
        return
    # No code on purpose: the launcher opens the browser (webbrowser.open was
    # removed so the tab is opened exactly once, by the launcher).
    _auth_dbg("auth gog: no code — emitting auth_url (launcher opens the browser)")
    emit({"type": "auth_url", "store": "gog", "url": GOG_LOGIN_URL,
          "instructions": "1) Log in to GOG in the window that just opened. 2) Nothing else: the code is picked up automatically when you land on the success page."})


def _gog_access_token():
    import urllib.request
    import urllib.parse
    import urllib.error
    refresh = _gog_refresh_token()
    if not refresh:
        _auth_dbg("access_token: no refresh_token in gogdl auth file")
        return ""
    _auth_dbg("access_token: refresh len=" + str(len(refresh)))
    try:
        # GOG's token endpoint only answers a refresh that carries
        # client_secret, and only over GET with the parameters in the query
        # string. A POST without the secret returns HTTP 400: that is what this
        # used to do, so a login that had actually succeeded was then reported
        # as "the GOG session could not be confirmed". gogdl does the code
        # exchange correctly (see cmd_auth) but this refresh was left doing the
        # plugin's own broken call.
        # without_new_session=1 keeps GOG from dropping the live session on
        # every refresh.
        qs = urllib.parse.urlencode({
            "client_id": GOG_CLIENT_ID,
            "client_secret": GOG_CLIENT_SECRET,
            "grant_type": "refresh_token",
            "refresh_token": refresh,
            "without_new_session": "1",
        })
        req = urllib.request.Request("https://auth.gog.com/token?" + qs,
                                     headers={"User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=30) as resp:
            tok = json.loads(resp.read().decode())
        at = tok.get("access_token", "")
        # GOG rotates the refresh_token, so if the response carries a new one
        # it must replace the stored entry in gogdl's format or gogdl would
        # keep a dead one and every download would fail.
        if tok.get("refresh_token") and tok["refresh_token"] != refresh:
            _gogdl_store_entry(tok, refresh)
            _auth_dbg("access_token: rotated refresh_token stored")
        _auth_dbg("access_token: obtained (len=" + str(len(at)) + ")")
        return at
    except urllib.error.URLError as e:
        _auth_dbg(f"access_token: network error: {e}")
        return ""
    except TimeoutError:
        _auth_dbg("access_token: network timeout")
        return ""
    except Exception as e:
        _auth_dbg(f"access_token: error ({type(e).__name__})")
        return ""


def _epic_cover(game: dict) -> str:
    meta = game.get("metadata") or {}
    imgs = meta.get("keyImages") or []
    prefer = ("DieselGameBoxTall", "DieselGameBox", "OfferImageWide",
              "DieselStoreFrontWide", "Thumbnail")
    by_type = {}
    for im in imgs:
        by_type.setdefault(im.get("type", ""), im.get("url", ""))
    for t in prefer:
        if by_type.get(t):
            return by_type[t]
    for im in imgs:
        if im.get("url"):
            return im["url"]
    return ""


def _epic_desc(game: dict) -> str:
    meta = game.get("metadata") or {}
    return str(meta.get("description") or meta.get("shortDescription") or "")


# --- per-app descriptions (single writer is this plugin) ---
# descriptions.json keyed by app_id. A positive entry
# {description, source, source_url, lang, saved_at} never expires and is
# served with zero external requests; a "no result" marker
# {no_description_checked_at} gates a redownload for NO_DESC_RETRY (7d).
# Network failures (transport / 429 / 5xx) persist nothing, so the next
# visit retries immediately. The legacy game_info_cache.json is migrated
# on first load (positives keep their text, gain a lang) and removed.
DESCRIPTIONS_FILE = CONFIG_DIR / "descriptions.json"
DESCRIPTIONS_LEGACY = CONFIG_DIR / "game_info_cache.json"
NO_DESC_RETRY = 7 * 24 * 3600


def _write_json(path: Path, data: dict):
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data))
    except OSError:
        pass


def _write_json_atomic(path: Path, data: dict):
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        tmp = path.with_name(path.name + ".tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False))
        os.replace(tmp, path)
    except OSError:
        pass


def _descriptions_load() -> dict:
    data = _read_json(DESCRIPTIONS_FILE)
    if not isinstance(data, dict):
        data = {}
    legacy = _read_json(DESCRIPTIONS_LEGACY)
    if isinstance(legacy, dict) and legacy:
        import time as _t
        migrated = False
        for app_id, e in legacy.items():
            if app_id in data or not isinstance(e, dict):
                continue
            desc = e.get("description") or ""
            if desc:
                data[app_id] = {
                    "description": desc,
                    "source": e.get("source") or "fallback",
                    "source_url": e.get("source_url") or "",
                    "lang": "spanish",
                    "saved_at": e.get("ts") or _t.time(),
                }
                migrated = True
            elif e.get("ts"):
                data[app_id] = {"no_description_checked_at": e.get("ts")}
                migrated = True
        if migrated:
            _write_json_atomic(DESCRIPTIONS_FILE, data)
        try:
            DESCRIPTIONS_LEGACY.unlink()
        except OSError:
            pass
    return data


def _descriptions_save(app_id: str, entry: dict):
    data = _descriptions_load()
    data[app_id] = entry
    _write_json_atomic(DESCRIPTIONS_FILE, data)


def _md_clean(s: str) -> str:
    # Drop image embeds (with optional wrapping link), markdown links and
    # bold/heading markers, then collapse blank runs so the store-content
    # about text reads clean.
    s = re.sub(r"\[!\[[^\]]*\]\([^)]*\)\]\([^)]*\)", "", s)
    s = re.sub(r"!\[[^\]]*\]\([^)]*\)", "", s)
    s = re.sub(r"\[([^\]]+)\]\([^)]*\)", r"\1", s)
    s = re.sub(r"[#>*_`]+", " ", s)
    s = re.sub(r"[\s\u200b]+", " ", s)
    return s.strip()


def _epic_store_slug(match, title: str) -> str:
    # Authoritative page slug wins; otherwise derive one from the title
    #   (e.g. "Fall Guys" -> "fall-guys"). Games without a store-content
    # product 404 and simply cascade to the next source.
    if match is not None:
        slug = _epic_page_slug(match)
        if slug:
            return slug
    slug = re.sub(r"[^a-z0-9]+", "-", (title or "").lower()).strip("-")
    return slug


def _epic_store_content_desc(title: str, match, err=None) -> str:
    # Public Epic CMS content, no auth: pages[].data.about.description /
    # shortDescription / seo.description. May 404 for games without a
    # store-content product (harmless -> empty -> next cascade level).
    # 429/5xx or transport errors are marked as network errors via err so
    # callers persist nothing.
    import urllib.request
    import urllib.error
    slug = _epic_store_slug(match, title)
    if not slug:
        return ""
    try:
        url = f"https://store-content.ak.epicgames.com/api/en-US/content/products/{slug}"
        req = urllib.request.Request(url, headers={"User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        if err is not None and (e.code == 429 or e.code >= 500):
            err["network"] = True
        return ""
    except Exception:
        if err is not None:
            err["network"] = True
        return ""
    best = ""
    pages = data.get("pages") or []
    for page in pages:
        d = page.get("data") or {}
        about = d.get("about") or {}
        for key in ("description", "shortDescription"):
            v = str(about.get(key) or "").strip()
            if v and v != title:
                best = best or v
                break
        if best:
            break
    if not best:
        seo = ((page.get("data") or {}).get("seo") or {}).get("description") or ""
        best = str(seo).strip()
    return _md_clean(best)[:1500]


_name_norm_re = re.compile(
    r"(?i)\s*[-–—(]?\s*(Definitive|Game of the Year|GOTY|Deluxe|Gold|Ultimate"
    r"|Collector'?s|Premium|Standard|Complete|Legendary|Anniversary|Remastered)"
    r"\s*Edition\s*\)?\s*$")
_name_norm_keep = re.compile(r"[^a-z0-9]+")


def _name_norm(title: str) -> str:
    # Bare game name for strict equality and Steam searches: drop ®/™ and
    # edition suffixes, then compare case-insensitively, ignoring any non
    # alphanumeric run so "Fall Guys" == "Fall-Guys" == "fallguys".
    t = (title or "").replace("\u00ae", "").replace("\u2122", "").casefold()
    t = _name_norm_re.sub("", t)
    return _name_norm_keep.sub("", t)


_steam_edition_terms = ("soundtrack", "demo", "dlc", "pack")


def _steam_throttle():
    # Steam public APIs have no SLA token; keep a >=1.5 s gap between
    # consecutive requests and back off when we still get 429s. The gap is
    # measured from the last real request (timestamp file), so concurrent
    # plugin invocations share it instead of stacking sleeps.
    import time as _t
    while True:
        last = 0.0
        try:
            last = float(STEAM_THROTTLE_FILE.read_text().strip() or 0)
        except (OSError, ValueError):
            pass
        wait = last + STEAM_MIN_INTERVAL - _t.time()
        if wait <= 0:
            break
        _t.sleep(wait)
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        STEAM_THROTTLE_FILE.write_text(str(_t.time()))
    except OSError:
        pass


def _http_json(url: str, timeout: float = 15, attempts: int = 2, err=None):
    # err: optional dict mutated with {"network": True} on any failure that
    # should count as a network problem (transport, 429, 5xx) so callers
    # persist nothing; a clean 404/empty payload is not a network error.
    import urllib.request
    for attempt in range(attempts):
        try:
            req = urllib.request.Request(
                url, headers={"User-Agent": "CorkyTux/3.0.19 (+https://github.com/Matts-lab69/CorkyTux-Launcher)"})
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return json.loads(resp.read().decode())
        except urllib.error.HTTPError as e:
            if e.code == 429 and attempt + 1 < attempts:
                import time as _t
                _t.sleep(2.0 + attempt * 2.0)
                continue
            if err is not None and (e.code == 429 or e.code >= 500):
                err["network"] = True
            return None
        except Exception:
            if err is not None:
                err["network"] = True
            return None
    return None


def _steam_find_appid(title: str, err=None) -> str:
    # storesearch -> strict name equality on the normalized name, dropping
    # OST/demo/DLC/pack suffixes ("DOOMBLADE Soundtrack" never wins over
    # "DOOMBLADE"). Public API, no key. Returns appid or "".
    import urllib.parse
    q = urllib.parse.quote(title)
    _steam_throttle()
    data = _http_json(f"https://store.steampowered.com/api/storesearch/?term={q}&cc=US&l=english", err=err)
    target = _name_norm(title)
    for it in (data or {}).get("items") or []:
        name = _name_norm(it.get("name") or "")
        if name != target:
            continue
        if any(t in name for t in _steam_edition_terms):
            continue
        return str(it.get("id") or "")
    return ""


def _steam_desc(appid: str, lang: str, err=None) -> str:
    # appdetails; keep only full games (type=="game", not a DLC), prefer
    # short_description, fall back to about_the_game as plain text. If the
    # requested language returns nothing usable, retry in English.
    for lng in (lang, "english"):
        _steam_throttle()
        data = _http_json(f"https://store.steampowered.com/api/appdetails?appids={appid}&l={lng}&cc=US", err=err)
        app = ((data or {}).get(appid) or {})
        if not app.get("success"):
            continue
        info = app.get("data") or {}
        if info.get("type") != "game" or bool(info.get("is_dlc")):
            return ""
        desc = str(info.get("short_description") or "").strip()
        if not desc:
            about = re.sub(r"<[^>]+>", " ", str(info.get("about_the_game") or ""))
            desc = re.sub(r"\s+", " ", about).strip()
        if desc:
            return desc[:1500]
    return ""


def _wiki_lookup(title: str, lang: str, err=None):
    # Wikipedia REST summary (no key, CC BY-SA). Try the bare title and the
    # "(videojuego)" / "(video game)" disambiguator. Accept only a standard
    # article (never a disambiguation/redlink) whose returned title matches
    # after normalization and whose extract mentions being a video game.
    # Returns (description, article_url).
    import urllib.parse
    wiki_lang = {"spanish": "es", "english": "en"}.get(lang, "es")
    canons = {wiki_lang: "(videojuego)", "es": "(videojuego)", "en": "(video game)"}
    cand = canons.get(wiki_lang, "(videojuego)")
    target = _name_norm(title)
    for cand_title in (title, f"{title} {cand}"):
        enc = urllib.parse.quote(cand_title.replace(" ", "_"))
        data = _http_json(f"https://{wiki_lang}.wikipedia.org/api/rest_v1/page/summary/{enc}", timeout=12, err=err)
        if not isinstance(data, dict):
            continue
        if data.get("type") != "standard":
            continue
        got = _name_norm(data.get("title") or "")
        if got != target:
            continue
        extract = str(data.get("extract") or "").strip()
        kw = "video game" if wiki_lang == "en" else "videojuego"
        if kw not in extract.casefold():
            continue
        if not extract:
            return "", ""
        page = data.get("content_urls", {}).get("desktop", {}).get("page") or \
            f"https://{wiki_lang}.wikipedia.org/wiki/{cand_title.replace(' ', '_')}"
        return extract[:1500], page
    return "", ""


def _desc_cascade(app_id: str, title: str, lang: str, match, force: bool = False):
    # No description usable -> try, in order: Epic store-content (level 2),
    # Steam (level 3), Wikipedia (level 4). A hit at any level stops the
    # cascade and is persisted to descriptions.json (source, source_url,
    # lang, saved_at). A miss on every level persists nothing for genuine
    # network failures, and a {no_description_checked_at} marker otherwise
    # (retried after NO_DESC_RETRY). force=True ignores the marker and
    # re-runs the cascade; a network failure keeps any previous entry.
    # All network access happens here, off the GTK main loop.
    import time as _t
    now = _t.time()
    disp = _descriptions_load().get(app_id) or {}
    if not isinstance(disp, dict):
        disp = {}
    if disp.get("no_description_checked_at") and not force:
        if now - float(disp.get("no_description_checked_at", 0)) < NO_DESC_RETRY:
            return "", "fallback", ""
    err = {"network": False}
    desc = _epic_store_content_desc(title, match, err=err)
    if desc:
        source, source_url = "store", ""
    else:
        appid = _steam_find_appid(title, err=err)
        desc = _steam_desc(appid, lang, err=err) if appid else ""
        if desc:
            source, source_url = "steam", f"https://store.steampowered.com/app/{appid}"
        else:
            desc, source_url = _wiki_lookup(title, lang, err=err)
            source = "wikipedia" if desc else "fallback"
            if not desc:
                source_url = ""
    if desc:
        _descriptions_save(app_id, {
            "description": desc, "source": source, "source_url": source_url,
            "lang": lang, "saved_at": now,
        })
    elif err["network"]:
        # Network failure and no new text: save nothing; when force asked
        # for a refresh, keep any previously saved positive entry.
        if disp.get("description"):
            return (disp.get("description") or "", disp.get("source") or "fallback",
                    disp.get("source_url") or "")
    else:
        # Genuine miss (no text in any source): persist only the marker,
        # and only when there is no positive entry to preserve — a refresh
        # never erases previously saved text for a miss or a failure.
        if not disp.get("description"):
            _descriptions_save(app_id, {"no_description_checked_at": now})
    return desc, source, source_url


def cmd_game_info(args):
    store = args.store
    if store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        try:
            proc = subprocess.run([LEGENDARY_BIN, "list", "--json"],
                                  capture_output=True, text=True, timeout=120)
            games = json.loads(proc.stdout or "[]")
        except (ValueError, subprocess.TimeoutExpired, OSError) as e:
            die(3, f"legendary list failed: {e}")
        g = next((x for x in games if x.get("app_name") == args.app_id), None)
        if not g:
            die(2, "Game not in Epic library")
        meta = g.get("metadata") or {}
        title = str(g.get("app_title") or "")
        app_id = g.get("app_name") or ""
        force = bool(getattr(args, "force_description", False))
        lang = args.lang or "spanish"
        saved = _descriptions_load().get(app_id) or {}
        if not isinstance(saved, dict):
            saved = {}
        saved_desc = saved.get("description") or ""
        # A saved positive wins with zero external requests and never
        # expires (all source requests come from descriptive sources; the
        # legendary list below is local).
        if not force and saved_desc:
            emit({"type": "done", "ok": True, "store": "epic", "info": {
                "app_id": app_id, "title": title,
                "version": g.get("app_version", ""),
                "cover": _epic_cover(g),
                "description": saved_desc[:1500],
                "description_source": saved.get("source") or "fallback",
                "source_url": saved.get("source_url") or "",
                "description_lang": saved.get("lang") or lang,
                "developer": str(meta.get("developer") or ""),
                "store_url": _epic_search_url(title),
            }})
            return
        # A recent "no result" marker is also served offline; the refresh
        # button ("force") ignores it and re-runs the cascade.
        import time as _t
        if not force and saved.get("no_description_checked_at"):
            if _t.time() - float(saved.get("no_description_checked_at", 0)) < NO_DESC_RETRY:
                emit({"type": "done", "ok": True, "store": "epic", "info": {
                    "app_id": app_id, "title": title,
                    "version": g.get("app_version", ""),
                    "cover": _epic_cover(g),
                    "description": "", "description_source": "fallback",
                    "source_url": "",
                    "description_lang": lang,
                    "developer": str(meta.get("developer") or ""),
                    "store_url": _epic_search_url(title),
                }})
                return
        desc = _epic_desc(g) or str(meta.get("longDescription") or "")
        store_url = ""
        try:
            match = next((e for e in _epic_catalog()
                          if str(e.get("title") or "").casefold() == title.casefold()), None)
        except Exception:
            match = None
        if match is not None:
            if not desc:
                desc = str(match.get("description") or "")
            store_url = _epic_slug_url(match)
        if not store_url:
            # namespace-based /p/ URLs 404; a store search never does.
            store_url = _epic_search_url(title)
        # A stub where the catalog description equals the title ("Fall
        # Guys" -> "Fall Guys") counts as "no description": cascade to
        # Epic store-content (level 2), Steam (level 3), Wikipedia
        # (level 4). The reported source is one of store | steam |
        # wikipedia | fallback so the modal can attribute the real text.
        desc_source = "store" if desc else ""
        source_url = ""
        from_cascade = False
        if not desc or desc.strip().casefold() == title.strip().casefold():
            if desc and desc.strip().casefold() == title.strip().casefold():
                desc = ""
            desc, desc_source, source_url = _desc_cascade(app_id, title, lang, match, force=force)
            from_cascade = True
        # Persist any real text that did not come from the cascade (which
        # already saved it): e.g. legendary/catalog level-1 descriptions.
        if desc and not from_cascade:
            _descriptions_save(app_id, {
                "description": desc, "source": desc_source, "source_url": source_url,
                "lang": lang, "saved_at": _t.time(),
            })
        emit({"type": "done", "ok": True, "store": "epic", "info": {
            "app_id": app_id, "title": title,
            "version": g.get("app_version", ""),
            "cover": _epic_cover(g),
            "description": desc[:1500],
            "description_source": desc_source,
            "source_url": source_url,
            "description_lang": lang,
            "developer": str(meta.get("developer") or ""),
            "store_url": store_url,
        }})
        return
    access = _gog_access_token()
    if not access:
        die(4, "GOG not logged in.")
    # Presupuesto total de red para game-info: 6 s (5 s por llamada).
    t0 = time.monotonic()
    budget = lambda: max(0.01, min(5.0, 6.0 - (time.monotonic() - t0)))
    try:
        import urllib.request
        req = urllib.request.Request(
            f"https://embed.gog.com/account/gameDetails/{args.app_id}.json",
            headers={"Authorization": f"Bearer {access}", "User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=budget()) as resp:
            data = json.loads(resp.read().decode())
    except Exception as e:
        # Degradación: ficha vacía marcada parcial en vez de matar la vista.
        emit({"type": "done", "ok": True, "store": "gog",
              "info": {"app_id": args.app_id, "title": "", "version": "",
                       "cover": "", "description": ""},
              "partial": True, "warning": f"game info failed: {e}"})
        return
    desc = (((data.get("description") or {}).get("full") or "")
            or ((data.get("description") or {}).get("lead") or ""))
    import re as _re
    desc = _re.sub(r"<[^>]+>", "", desc)[:1500]
    desc_source = ""
    bg = data.get("backgroundImage", "") or ""
    if bg.startswith("//"):
        bg = "https:" + bg
    key = f"gog:{args.app_id}"
    saved = _descriptions_load().get(key)
    saved = saved if isinstance(saved, dict) else {}
    if not desc.strip() and saved.get("description"):
        # 1) caché propia (guardado único, como Epic).
        desc = str(saved.get("description") or "")
        desc_source = str(saved.get("source") or "")
    vert = str(saved.get("cover") or "")
    if vert and saved.get("cover_src") not in (None, "", "v2-box"):
        # Entrada legacy con cover no vertical: reintentar v2; se
        # reemplaza solo si llega un vertical real.
        vert = ""
    fresh_vert = ""
    if not desc.strip() or not vert:
        # 2) un solo fetch v2 sirve banner+desc, con presupuesto; se
        # salta si ya se resolvió. Cadena: vertical v2 → bg con
        # extensión → .jpg → "" (el modal cae al tile).
        v2_box, v2_desc = _gog_v2_game(args.app_id, timeout=budget())
        if not desc.strip() and v2_desc:
            desc, desc_source = v2_desc, "gog"
        if not vert:
            fresh_vert = v2_box
            vert = fresh_vert
        cover = _gog_modal_cover(vert, bg, "")
        # 4) guardado único: solo datos nuevos reales, nunca fallos. El
        # wipe de Refresh borra la entrada entera (cover_src incluido).
        merged = _gog_merge_entry(saved, desc, desc_source, fresh_vert, "v2-box")
        if merged is not None:
            _descriptions_save(key, merged)
    else:
        cover = _gog_modal_cover(vert, bg, "")
    emit({"type": "done", "ok": True, "store": "gog", "info": {
        "app_id": args.app_id, "title": data.get("title", ""),
        "version": "", "cover": cover, "description": desc,
        "description_source": desc_source,
        "developer": "", "store_url": f"https://www.gog.com/game/{args.app_id}",
    }})


def _gog_modal_cover(vert: str, bg: str, pub_bg: str) -> str:
    """Pura: coverVertical → background con extensión → público → .jpg → "".
    "" deja que el modal use el cover del tile (fallback del launcher)."""
    if vert:
        return vert
    if bg and bg.lower().endswith(IMG_EXTS):
        return bg
    if pub_bg:
        return pub_bg
    if bg:
        return bg + ".jpg"
    return ""


def _gog_merge_entry(saved: dict, desc: str, desc_source: str,
                     fresh_vert: str, vert_src: str = ""):
    """Pura: entrada a guardar (una sola vez) o None si no hay nada nuevo.
    Nunca guarda fallos (""/"") ni reescribe lo ya guardado."""
    saved = saved if isinstance(saved, dict) else {}
    entry = dict(saved)
    changed = False
    if desc.strip() and desc != saved.get("description"):
        entry.update({"description": desc,
                      "source": desc_source or saved.get("source", ""),
                      "source_url": "", "lang": saved.get("lang", "en")})
        changed = True
    if fresh_vert and fresh_vert != saved.get("cover"):
        entry["cover"] = fresh_vert
        if vert_src:
            entry["cover_src"] = vert_src
        changed = True
    if not changed:
        return None
    if not entry.get("description") and not entry.get("cover"):
        return None
    entry["saved_at"] = time.time()
    return entry


def _gog_v2_game(app_id: str, timeout: float = 5):
    """(boxart_vertical, description) desde api.gog.com/v2/games/<id>.
    Un solo fetch sirve banner y descripción (description es string con
    HTML: se limpia igual que v1). ("","") ante fallo o 404, sin
    excepciones hacia la UI.
    Backup documentado (NO implementado): gamesdb
    platforms/gog/external_releases/<id> → game.vertical_cover.url_format
    con formatter _glx_vertical_cover (verificado 342×482 en 1831618557
    y 1542190742). Solo si v2 muere."""
    if timeout <= 0:
        return "", ""
    try:
        import urllib.request
        req = urllib.request.Request(
            f"https://api.gog.com/v2/games/{app_id}",
            headers={"User-Agent": "CorkyTux/3.0"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            d = json.loads(resp.read().decode())
        if not isinstance(d, dict):
            return "", ""
        links = d.get("_links") or {}
        boxart = str(((links.get("boxArtImage") or {}).get("href")) or "")
        if boxart.startswith("//"):
            boxart = "https:" + boxart
        import re as _re
        import html as _html
        txt = _re.sub(r"<[^>]+>", "", str(d.get("description") or ""))
        txt = _html.unescape(txt).strip()[:1500]
        return boxart, txt
    except Exception:
        return "", ""


IMG_EXTS = (".jpg", ".jpeg", ".png", ".webp")



def _gog_desc_wipe(data: dict) -> dict:
    """Puro: Refresh explícito — borra TODAS las claves gog:, conserva
    el resto (Epic y demás). Re-resuelven al abrir cada ficha."""
    return {k: v for k, v in data.items() if not k.startswith("gog:")}


def _gog_desc_prune(data: dict, vivas: set) -> dict:
    """Puro: cargas normales — solo poda gog: de juegos ausentes."""
    return {k: v for k, v in data.items()
            if not (k.startswith("gog:") and k not in vivas)}


def cmd_library(args):
    store = args.store
    if store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        cmd = [LEGENDARY_BIN, "list", "--json"]
        if args.refresh:
            cmd.append("--force-refresh")
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            die(3, "legendary list timed out")
        if proc.returncode != 0:
            err = (proc.stderr or proc.stdout).strip()[-300:]
            if "ogged in" in err or "login" in err.lower():
                die(4, "Epic not logged in. Log in from the Stores tab first.")
            die(3, f"legendary list failed: {err}")
        try:
            games = json.loads(proc.stdout)
        except ValueError:
            die(3, "Could not parse legendary output")
        status = _installed_status()
        # Prune descriptions.json entries whose app_id left the Epic
        # library. Only run when the list arrived complete and without
        # error (we are here only after a successful parse); if the list
        # somehow came back empty, keep everything rather than wipe.
        current_ids = {g.get("app_name") for g in games if g.get("app_name")}
        if current_ids:
            data = _descriptions_load()
            stale = set(data) - current_ids
            if stale:
                for k in stale:
                    del data[k]
                _write_json_atomic(DESCRIPTIONS_FILE, data)
        emit({"type": "done", "ok": True, "store": "epic", "games": [
            {"app_id": g.get("app_name"), "title": g.get("app_title"),
             "version": g.get("app_version", ""),
             "installed": status.get(g.get("app_name"), {}).get("installed", False),
             "stale_registry": status.get(g.get("app_name"), {}).get("stale", False),
             "install_path": status.get(g.get("app_name"), {}).get("install_path", "") if status.get(g.get("app_name"), {}).get("installed", False) else "",
             "executable": status.get(g.get("app_name"), {}).get("executable", "") if status.get(g.get("app_name"), {}).get("installed", False) else "",
             "cover": _epic_cover(g),
             "description": _epic_desc(g)}
            for g in games if g.get("app_name")
        ]})
        return
    try:
        import urllib.request
        import urllib.parse
    except ImportError:
        die(3, "urllib missing")
    access = _gog_access_token()
    if not access:
        die(4, "GOG not logged in. Log in from the Stores tab first.")
    status = _gog_installed_status()
    games = []
    page = 1
    advertencia = ""
    # Degradación por página/producto: una página o un producto roto no mata
    # la lista entera; se emite lo que haya con partial:true. Solo la falta
    # de sesión (arriba) sigue siendo un error duro.
    try:
        while True:
            try:
                url = ("https://embed.gog.com/account/getFilteredProducts?mediaType=1"
                       f"&page={page}&sortBy=title")
                req = urllib.request.Request(url, headers={
                    "Authorization": f"Bearer {access}", "User-Agent": "CorkyTux/3.0"})
                with urllib.request.urlopen(req, timeout=30) as resp:
                    data = json.loads(resp.read().decode())
            except Exception as e:
                advertencia = f"page {page} failed: {e}"
                break
            mal = 0
            for p in data.get("products", []) or []:
                try:
                    img = p.get("image", "") or ""
                    if img.startswith("//"):
                        img = "https:" + img + "_product_tile_256_2x.jpg"
                    app_id = str(p.get("id", ""))
                    st = status.get(app_id, {})
                    verified = st.get("installed", False)
                    # worksOn existe pero Lutris documenta que viene roto
                    # (todo-falso): solo se publican los true, nunca se
                    # inventa sistema. Vacío = la UI oculta esa mitad.
                    systems = sorted(
                        k for k, v in (p.get("worksOn") or {}).items() if v
                    ) if isinstance(p.get("worksOn"), dict) else []
                    games.append({"app_id": app_id,
                                  "title": p.get("title", ""),
                                  "category": p.get("category", "") or "",
                                  "systems": systems,
                                  "version": "",
                                  "installed": verified,
                                  "stale_registry": st.get("stale", False),
                                  "install_path": st.get("install_path", "") if verified else "",
                                  "executable": st.get("executable", "") if verified else "",
                                  "cover": img})
                except Exception:
                    mal += 1
            if mal:
                advertencia = f"{mal} product(s) skipped on page {page}"
            if page >= int(data.get("totalPages", 1)) or page >= 10:
                break
            page += 1
    except Exception as e:
        advertencia = f"unexpected: {e}"
    # descriptions.json (claves gog:, nunca Epic): Refresh explícito
    # (--refresh) invalida todo y re-resuelve; cargas normales solo
    # podan ausentes. Solo con lista completa y no vacía.
    if not advertencia and games:
        vivas = {"gog:" + str(g.get("app_id", "")) for g in games if g.get("app_id")}
        if vivas:
            data = _descriptions_load()
            if getattr(args, "refresh", False):
                nueva = _gog_desc_wipe(data)
            else:
                nueva = _gog_desc_prune(data, vivas)
            if nueva != data:
                _write_json_atomic(DESCRIPTIONS_FILE, nueva)
    emit({"type": "done", "ok": True, "store": "gog", "games": games,
          "partial": bool(advertencia), "warning": advertencia})


def _describe_game(app_id: str, title: str, lang: str, g, match) -> bool:
    # Library-refresh equivalent of game-info's refresh path for one game:
    # a previously saved positive is replaced only when a new valid result
    # arrives (network failures and genuine misses both keep the old text).
    import time as _t
    desc = _epic_desc(g) or ""
    if not desc and match is not None:
        desc = str(match.get("description") or "")
    src, url = "store", ""
    from_cascade = False
    if not desc or desc.strip().casefold() == title.strip().casefold():
        if desc and desc.strip().casefold() == title.strip().casefold():
            desc = ""
        desc, src, url = _desc_cascade(app_id, title, lang, match, force=True)
        from_cascade = True
    if desc:
        if not from_cascade:
            _descriptions_save(app_id, {
                "description": desc, "source": src, "source_url": url,
                "lang": lang, "saved_at": _t.time(),
            })
        return True
    return False


