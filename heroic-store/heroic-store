def _gog_info_raw(app_id: str, platform: str):
    """(info_dict, stderr). {} ante cualquier fallo: el llamador degrada
    (sin --lang) o muere con mensaje accionable (auth → re-login)."""
    try:
        proc = subprocess.run(
            [GOGDL_BIN, "--auth-config-path", _gogdl_auth_file(),
             "info", app_id, "--platform", platform],
            capture_output=True, text=True, timeout=60)
    except (subprocess.TimeoutExpired, OSError) as e:
        return {}, f"spawn failed: {type(e).__name__}"
    if proc.returncode != 0:
        return {}, proc.stderr or ""
    try:
        data = json.loads(proc.stdout or "{}")
    except ValueError:
        return {}, (proc.stderr or "") + " bad-json"
    return (data if isinstance(data, dict) else {}), proc.stderr or ""


def _gog_pick_lang(info: dict, override: str) -> str:
    """en-US si está en languages, si no el primero, si no "". Pura."""
    if override:
        return override
    langs = [str(x) for x in (info.get("languages") or []) if str(x)]
    if not langs:
        return ""
    return "en-US" if "en-US" in langs else langs[0]


def _gog_has_linux_build(info: dict) -> bool:
    """Pura: ¿builds[].os del info (windows) incluye linux? NUNCA invoca a
    `info --platform linux`: ese manager crashea con traceback si no hay
    build nativo."""
    try:
        items = (info.get("builds") or {}).get("items", []) or []
    except AttributeError:
        return False
    return any(str((b or {}).get("os") or "").lower() == "linux" for b in items)


def _sanitize_folder(name: str, fallback: str) -> str:
    keep = "".join(c for c in (name or "")
                   if c.isalnum() or c in (" ", "-", "_", ".", "(", ")", "[", "]"))
    keep = re.sub(r"\s+", " ", keep).strip(" .")
    return keep or fallback


# Una sola lista de exclusiones para Epic y GOG (instaladores, helpers,
# crash-handlers: nunca son el juego).
_EXE_IGNORE = ("unins", "crashhandler", "setup", "redist", "vcredist", "installer")


def _exe_excluded(filename: str) -> bool:
    """Puro: ¿el nombre huele a instalador/helper?"""
    return any(s in Path(filename).stem.lower() for s in _EXE_IGNORE)


def _gog_pick_task(tasks: list) -> str:
    """Puro: isPrimary .exe (no excluido) > primer filetask .exe (no
    excluido) > "". gogdl marca isPrimary en el import."""
    cands = []
    for task in tasks or []:
        if not isinstance(task, dict):
            continue
        path = str(task.get("path", "") or "")
        if ((task.get("type") or "").lower() != "filetask"
                or not path.lower().endswith(".exe")
                or _exe_excluded(path)):
            continue
        cands.append((bool(task.get("isPrimary")), path))
    for primary, path in cands:
        if primary:
            return path
    return cands[0][1] if cands else ""


def _gog_dir_parece_juego(d: Path) -> bool:
    """Puro salvo IO local: goggame-*.info o algún .exe directo."""
    try:
        if d.is_dir():
            names = [p.name for p in d.iterdir()]
            return (any(n.startswith("goggame-") and n.endswith(".info") for n in names)
                    or any(n.lower().endswith(".exe") for n in names))
    except OSError:
        pass
    return False


def _gogdl_manifests_dir() -> Path:
    """Espeja gogdl/constants.py (CONFIG_DIR + override GOGDL_CONFIG_PATH)."""
    import os as _os
    base = _os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    cfg = _os.environ.get("GOGDL_CONFIG_PATH")
    root = Path(cfg, "heroic_gogdl") if cfg else Path(base, "heroic_gogdl")
    return root / "manifests"


def _gog_old_manifests_dir() -> Path:
    """Dir compartido legacy (~/.config/heroic_gogdl): SOLO lectura,
    nunca se escribe ni se migra nada ahí."""
    import os as _os
    base = _os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base, "heroic_gogdl") / "manifests"


def _gog_manifest_source(app_id: str) -> str:
    """'new' | 'old' | ''. Dónde está el manifest (nuevo primero)."""
    try:
        if (_gogdl_manifests_dir() / str(app_id)).is_file():
            return "new"
        if (_gog_old_manifests_dir() / str(app_id)).is_file():
            return "old"
    except OSError:
        pass
    return ""


def _gog_has_manifest(app_id: str) -> bool:
    """Puro salvo IO local: ¿hay manifest (nuevo o viejo)?"""
    return _gog_manifest_source(app_id) != ""


def _gog_find_game_dir(base: Path, folder: str) -> Path:
    """Tras `download --path <base>`, gogdl crea <base>/<folder>. Se usa
    si parece juego; si no, se prueba UN nivel de subdirectorios (cubre
    instalaciones legacy con doble nesting); si no, base (nunca se
    pierde la instalación). Acota el walk del probe al juego."""
    cand = base / folder
    if _gog_dir_parece_juego(cand):
        return cand
    try:
        subs = sorted(p for p in cand.iterdir() if p.is_dir())
    except OSError:
        subs = []
    for sub in subs:
        if _gog_dir_parece_juego(sub):
            return sub
    return base


def _mark_partial(store: str, app_id: str, path: str) -> None:
    """Marca partial ANTES de descargar (permite Reanudar). Si ya hay una
    entrada completa con carpeta presente → error claro (repair/update
    fuera de alcance); registro huérfano (carpeta ausente) se pisa."""
    regs = _read_installs()
    key = f"{store}:{app_id}"
    cur = regs.get(key)
    if isinstance(cur, dict) and cur.get("status") != "partial":
        old_path = str(cur.get("path") or "")
        old_exe = str(cur.get("exe") or "")
        if old_path and Path(old_path).exists():
            real = (_gog_dir_parece_juego(Path(old_path))
                    or (bool(old_exe) and (Path(old_path) / old_exe).is_file()))
            if real:
                die(4, f"already installed at {old_path} (repair/update out of scope)")
            # Registro rancio (carpeta sin juego o exe que no resuelve):
            # se pisa con el partial nuevo en vez de bloquear la reinstall.
    regs[key] = {"path": path, "exe": "", "status": "partial",
                 "started": int(time.time())}
    _write_installs(regs)


def _gog_resolve_installed(entry_path: str) -> Path:
    """Dir de un juego ya instalado: el path tal cual si parece juego,
    si no UN nivel de subdirectorios (legacy con doble nesting), si no
    el path original. Puro salvo IO local."""
    p = Path(str(entry_path or ""))
    if _gog_dir_parece_juego(p):
        return p
    try:
        subs = sorted(x for x in p.iterdir() if x.is_dir())
    except OSError:
        subs = []
    for sub in subs:
        if _gog_dir_parece_juego(sub):
            return sub
    return p


def cmd_reprobe(args):
    """Re-probe del exe de un juego instalado: actualiza SOLO 'exe'
    (relativo, con subcarpetas) en installs.json. Sin --write muestra
    el cambio (dry-run implícito); con --write respalda installs.json
    a .bak antes de escribir. Sin exe hallado: error, sin escribir."""
    import shutil
    key = f"{args.store}:{args.app_id}"
    regs = _read_installs()
    info = regs.get(key)
    if not isinstance(info, dict) or not info.get("path"):
        die(2, f"no install record for {key} (install first)")
    game_dir = _gog_resolve_installed(str(info["path"]))
    _require_binary(GOGDL_BIN, "gogdl")
    _ip, exe_probe, _plat = _gog_probe(game_dir, args.app_id)
    old = str(info.get("exe") or "")
    old_path = str(info["path"])
    if not exe_probe:
        die(3, f"reprobe found no exe under {game_dir}")
    # El launcher compone path + exe: exe relativo al path que quede
    # registrado (el actual, o el nuevo con --fix-path).
    fix = bool(getattr(args, "fix_path", False))
    new_path = old_path
    if fix:
        base = exe_probe if os.path.isabs(exe_probe) else os.path.join(str(game_dir), exe_probe)
        cand = os.path.dirname(base)
        if cand and cand != old_path and os.path.isdir(cand) and os.path.isfile(
                os.path.join(cand, os.path.basename(exe_probe))):
            new_path = cand
        elif cand != old_path:
            die(3, f"reprobe --fix-path: {cand or old_path} missing exe")
    try:
        exe = os.path.relpath(os.path.join(str(game_dir), exe_probe), new_path)
    except ValueError:
        exe = exe_probe
    if exe == old and new_path == old_path:
        emit({"type": "done", "ok": True, "store": args.store,
              "app_id": args.app_id, "old_exe": old, "new_exe": exe,
              "wrote": False, "note": "unchanged"})
        return
    if not bool(getattr(args, "write", False)):
        emit({"type": "done", "ok": True, "store": args.store,
              "app_id": args.app_id, "old_exe": old, "new_exe": exe,
              "old_path": old_path, "new_path": new_path,
              "wrote": False, "note": "dry-run; pass --write to apply"})
        return
    try:
        import time as _t
        _ts = _t.strftime("%Y%m%d-%H%M%S")
        shutil.copy2(INSTALLS_JSON,
                     INSTALLS_JSON.parent / f"installs.json.bak-{_ts}")
        for _bak in sorted(
                INSTALLS_JSON.parent.glob("installs.json.bak-*"))[:-5]:
            try:
                _bak.unlink()
            except OSError:
                pass
    except OSError as e:
        die(3, f"could not back up installs.json: {e}")
    info["exe"] = exe
    info["path"] = new_path
    regs[key] = info
    _write_installs(regs)
    emit({"type": "done", "ok": True, "store": args.store,
          "app_id": args.app_id, "old_exe": old, "new_exe": exe,
          "old_path": old_path, "new_path": new_path,
          "wrote": True})


def cmd_install(args):
    store = args.store
    # Sin --path no hay install: el default vive SOLO en el launcher
    # (default_games_dir por tienda). Ningún literal propio acá.
    if not (getattr(args, "path", "") or "").strip():
        die(2, "install needs --path (the launcher always sends it)")
    dest = Path(args.path).expanduser()
    dest.mkdir(parents=True, exist_ok=True)
    if store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        ok = _run_streaming([LEGENDARY_BIN, "install", args.app_id, "-y",
                             "--base-path", str(dest)], store)
        if not ok:
            die(3, "legendary install failed")
        # Re-read AFTER install: pre-install info has no install section.
        info = _legendary_info(args.app_id)
        inst = info.get("install", {}) or {}
        game = info.get("game", {}) or {}
        platform = game.get("platform", "Windows")
        exe = inst.get("executable", "") or ""
        ipath = inst.get("install_path", "") or str(dest / args.app_id)
        if not exe and Path(ipath).is_dir():
            best, best_size = "", -1
            try:
                entries = list(Path(ipath).iterdir())
            except OSError:
                entries = []
            for p in entries:
                if not (p.is_file() and p.suffix.lower() == ".exe"):
                    continue
                if _exe_excluded(p.name):
                    continue
                try:
                    sz = p.stat().st_size
                except OSError:
                    continue
                if sz > best_size:
                    best, best_size = p.name, sz
            exe = best
    else:
        _require_binary(GOGDL_BIN, "gogdl")
        # gogdl reads its tokens from --auth-config-path (global flag, before
        # the subcommand) and runs ANONYMOUS without it (auth.py
        # get_credentials -> None -> no Authorization header in api.py).
        platform = getattr(args, "platform", "") or "windows"
        if platform not in ("windows", "linux"):
            die(2, f"unsupported platform '{platform}' (want windows|linux)")
        info, info_err = _gog_info_raw(args.app_id, "windows")
        if not info and _AUTH_ERR_RE.search(info_err or ""):
            die(8, "GOG session expired or invalid (re-login in the Stores tab)")
        if platform == "linux" and not _gog_has_linux_build(info):
            die(6, "no Linux build for this game (Windows-only)")
        lang = _gog_pick_lang(info, getattr(args, "lang", "") or "")
        # --path es la BASE: gogdl anexa <folder_name> solo (pasar la
        # carpeta duplicaba el nesting: Bloody Hell/Bloody Hell).
        folder = _sanitize_folder(str(info.get("folder_name") or ""), args.app_id)
        # Reinstall tras borrado: con manifest guardado, `download` diría
        # "Nothing to do" sin mirar el disco; `repair` verifica cada
        # archivo y re-descarga faltantes. Sin manifest, download normal.
        verb = "download"
        # repair trabaja IN-PLACE (no anexa carpeta, a diferencia de
        # download): su --path es el dir esperado del juego.
        cfg_previo = os.environ.get("GOGDL_CONFIG_PATH")
        if _gog_manifest_source(args.app_id) == "old" and not _gog_dir_parece_juego(dest / folder):
            # El manifest vive en el dir compartido legacy: esa invocación
            # corre con ese config (repair lo exige); no se migra nada.
            # Se restaura al terminar (también ante die): no contamina
            # al proceso ni a tests en el mismo intérprete.
            os.environ["GOGDL_CONFIG_PATH"] = str(
                _gog_old_manifests_dir().parent.parent)
            verb = "repair"
        elif _gog_has_manifest(args.app_id) and not _gog_dir_parece_juego(dest / folder):
            verb = "repair"
        dl = [GOGDL_BIN, "--auth-config-path", _gogdl_auth_file(),
              verb, args.app_id, "--path",
              str(dest / folder) if verb == "repair" else str(dest),
              "--platform", platform]
        if lang:
            dl += ["--lang", lang]
        _mark_partial(store, args.app_id, str(dest / folder))
        try:
            ok = _run_streaming(dl, store, ppid=int(getattr(args, "ppid", 0) or 0))
        except Exception as e:
            die(3, f"gogdl download failed: {type(e).__name__}: {str(e)[:150]}")
        finally:
            if cfg_previo is None:
                os.environ.pop("GOGDL_CONFIG_PATH", None)
            else:
                os.environ["GOGDL_CONFIG_PATH"] = cfg_previo
        if not ok:
            die(3, "gogdl download failed (partial kept for resume)")
        game_dir = _gog_find_game_dir(dest, folder)
        # Puerta de verificación: el dir resuelto NUNCA puede ser la base
        # compartida (archivos sueltos en la raíz), aunque tenga exe; y
        # debe parecer juego. Sin eso: die(3), sin escribir registro.
        if game_dir == dest or not _gog_dir_parece_juego(game_dir):
            die(3, f"gogdl reported success but {game_dir} has no game files")
        ipath, exe, platform = _gog_probe(game_dir, args.app_id)
    regs = _read_installs()
    regs[f"{store}:{args.app_id}"] = {"path": ipath, "exe": exe}
    _write_installs(regs)
    _status_cache_invalidate()
    emit({"type": "done", "ok": True, "store": store, "app_id": args.app_id,
          "install_path": ipath, "executable": exe,
          "requires_wine": platform == "Windows"})


def _gog_probe(game_dir: Path, app_id: str):
    """Exe en un dir ya resuelto: isPrimary > filetask > mayor .exe,
    todo con las exclusiones compartidas. Nunca toca installs.json."""
    try:
        proc = subprocess.run([GOGDL_BIN, "import", str(game_dir)], capture_output=True,
                              text=True, timeout=60)
        data = json.loads(proc.stdout or "{}")
        game = data.get("game", {}) if isinstance(data, dict) else {}
        tasks = game.get("playTasks", []) or []
        picked = _gog_pick_task(tasks)
        if picked:
            return str(game_dir), picked, "Windows"
        for task in tasks:
            if isinstance(task, dict) and str(task.get("path", "") or ""):
                return str(game_dir), str(task["path"]), "Linux"
    except (ValueError, subprocess.TimeoutExpired, OSError):
        pass
    best, best_size = "", -1
    for root, _dirs, files in os.walk(game_dir):
        for f in files:
            if not f.lower().endswith(".exe") or _exe_excluded(f):
                continue
            try:
                sz = os.path.getsize(os.path.join(root, f))
            except OSError:
                continue
            if sz > best_size:
                best, best_size = os.path.join(root, f), sz
    if best:
        return str(game_dir), os.path.relpath(best, game_dir), "Windows"
    return str(game_dir), "", "Linux"


def _stale_cleanup_decision(install_path: str):
    """Guards shared by cleanup-stale (real run and --dry-run).

    Returns (allowed, reason). Reasons: "no_path" (registry entry without
    install_path), "folder_present" (the install folder exists again —
    never touch live files), "disk_unmounted" (parent folder missing while
    the path is under a mount prefix or outside the default base).
    allowed=True means the record is safe to drop: the folder is gone and
    either its parent exists or the path lives under the plugin's default
    base (~/Games/Heroic), which is never a mount point.
    """
    if not install_path:
        return False, "no_path"
    ipath = Path(install_path)
    if ipath.is_dir():
        return False, "folder_present"
    if not ipath.parent.is_dir():
        under_mount = any(
            ipath.is_relative_to(Path(p))
            for p in ("/mnt", "/media", "/run/media")
        )
        if under_mount or not ipath.is_relative_to(Path.home() / "Games" / "Heroic"):
            return False, "disk_unmounted"
    return True, None


def cmd_cleanup_stale(args):
    """Drop a stale Epic registry entry (record whose install folder is
    gone) so the next `install` respects the user's --base-path instead of
    legendary silently reusing the old install_path from the registry.

    Safe by construction: guards refuse to touch live folders or paths
    whose parent is missing under a mount prefix; the uninstall runs with
    --keep-files/--skip-uninstaller (pure registry drop, never deletes
    files); installed.json is backed up first (last 5 kept in CONFIG_DIR);
    success is verified by re-reading installed.json because legendary
    exits 0 even when its lock is held. --dry-run applies the guards and
    reports what would happen without touching anything.
    """
    if args.store != "epic":
        die(2, "cleanup-stale only supports the epic store")
    regs = _read_json(LEGENDARY_INSTALLED)
    if not isinstance(regs, dict):
        die(4, f"Could not read {LEGENDARY_INSTALLED}: expected the installed-games "
               f"object (is the legendary session ready?).")
    entry = regs.get(args.app_id)
    if not entry:
        emit({"type": "done", "ok": True, "store": "epic", "app_id": args.app_id,
              "cleaned": False, "reason": "no_record"})
        return
    ip = str(entry.get("install_path") or "")
    allowed, reason = _stale_cleanup_decision(ip)
    if args.dry_run:
        emit({"type": "done", "ok": True, "store": "epic", "app_id": args.app_id,
              "cleaned": False, "would_clean": allowed, "reason": reason,
              "install_path": ip})
        return
    if not allowed:
        if reason == "folder_present":
            die(7, f"The install folder already exists ({ip}); the record was NOT "
                   f"cleaned. Import the game instead.")
        if reason == "disk_unmounted":
            die(6, f"Install directory is not accessible ({Path(ip).parent} does not "
                   f"exist; disk probably unmounted). The record was NOT cleaned.")
        die(6, f"The registry entry of {args.app_id} has no install_path; "
               f"nothing to clean.")
    _require_binary(LEGENDARY_BIN, "legendary")
    # Backup installed.json (only the 5 most recent survive).
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    import time as _t
    ts = _t.strftime("%Y%m%d-%H%M%S")
    shutil.copy2(LEGENDARY_INSTALLED, CONFIG_DIR / f"installed.json.bak-{ts}")
    for bak in sorted(CONFIG_DIR.glob("installed.json.bak-*"))[:-5]:
        try:
            bak.unlink()
        except OSError:
            pass
    try:
        subprocess.run([LEGENDARY_BIN, "uninstall", "--keep-files",
                        "--skip-uninstaller", "-y", args.app_id],
                       capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        die(5, f"legendary uninstall timed out (120s) for {args.app_id}; "
               f"the record was NOT cleaned. Retry once no other Epic "
               f"operation is running.")
    # legendary exits 0 even when it could not take the installed.json lock
    # (cli.py returns without error); verify by re-reading the registry.
    regs2 = _read_json(LEGENDARY_INSTALLED)
    if isinstance(regs2, dict) and args.app_id in regs2:
        die(5, "The record was not cleaned: another Epic process holds the "
               "installed.json lock. Retry when it finishes.")
    regs = _read_installs()
    regs.pop(f"epic:{args.app_id}", None)
    _write_installs(regs)
    emit({"type": "done", "ok": True, "store": "epic", "app_id": args.app_id,
          "cleaned": True})


def _gog_uninstall_safe(path: str, regs: dict, self_key: str) -> bool:
    """Puro salvo IO local: ¿se puede borrar `path` como carpeta del juego?
    Niega base compartida, padres, no-juegos sin subdir-juego y cualquier
    solape con otro registro (hermano dentro o path dentro de otro)."""
    import os as _os
    try:
        rp = Path(path).resolve()
    except OSError:
        return False
    if not rp.is_dir():
        return True  # nada que borrar; el pop del registro sigue
    home = Path.home()
    for shared in (Path("/"), home, home / "Games", home / "Games" / "Heroic"):
        try:
            if rp == shared.resolve():
                return False
        except OSError:
            if rp == shared:
                return False
    try:
        game_here = _gog_dir_parece_juego(rp) or any(
            _gog_dir_parece_juego(x) for x in rp.iterdir() if x.is_dir())
    except OSError:
        return False
    if not game_here:
        return False
    for key, val in regs.items():
        if key == self_key or not isinstance(val, dict):
            continue
        op = str(val.get("path") or "")
        if not op:
            continue
        try:
            rop = Path(op).resolve()
        except OSError:
            continue
        if rop == rp or rp in rop.parents or rop in rp.parents:
            return False
    return True


def cmd_uninstall(args):
    if args.store == "epic":
        _require_binary(LEGENDARY_BIN, "legendary")
        proc = subprocess.run([LEGENDARY_BIN, "uninstall", args.app_id, "-y"],
                              capture_output=True, text=True, timeout=120)
        if proc.returncode != 0:
            die(3, f"Uninstall failed: {(proc.stderr or proc.stdout).strip()[-200:]}")
    else:
        regs = _read_installs()
        key = f"gog:{args.app_id}"
        info = regs.get(key, {})
        path = info.get("path", "")
        kept = False
        if path and Path(path).is_dir():
            if _gog_uninstall_safe(path, regs, key):
                shutil.rmtree(path, ignore_errors=True)
            else:
                kept = True
        regs.pop(key, None)
        _write_installs(regs)
        _status_cache_invalidate()
        if kept:
            emit({"type": "warning",
                  "message": f"kept files at {path} (unsafe to delete)"})
    regs = _read_installs()
    regs.pop(f"{args.store}:{args.app_id}", None)
    _write_installs(regs)
    emit({"type": "done", "ok": True, "store": args.store, "app_id": args.app_id})


