    except subprocess.TimeoutExpired:
        die(3, "legendary list timed out")
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout).strip()[-300:]
        if "ogged in" in err or "login" in err.lower():
            die(4, "Epic not logged in. Log in from the Stores tab first.")
        die(3, f"legendary list failed: {err}")
    try:
        games = json.loads(proc.stdout)
    except ValueError:
        die(3, "Could not parse legendary output")
    status = _installed_status()
    current_ids = {g.get("app_name") for g in games if g.get("app_name")}
    if current_ids:
        data = _descriptions_load()
        stale = set(data) - current_ids
        if stale:
            for k in stale:
                del data[k]
            _write_json_atomic(DESCRIPTIONS_FILE, data)
    try:
        catalog = _epic_catalog()
    except Exception:
        catalog = []
    cat = {str((e or {}).get("title") or "").casefold(): e for e in catalog}
    rows = [g for g in games if g.get("app_name")]
    total = len(rows)
    emit({"type": "library", "store": "epic", "games": [
        {"app_id": g.get("app_name"), "title": g.get("app_title"),
         "version": g.get("app_version", ""),
         "installed": status.get(g.get("app_name"), {}).get("installed", False),
         "stale_registry": status.get(g.get("app_name"), {}).get("stale", False),
         "install_path": status.get(g.get("app_name"), {}).get("install_path", "") if status.get(g.get("app_name"), {}).get("installed", False) else "",
         "executable": status.get(g.get("app_name"), {}).get("executable", "") if status.get(g.get("app_name"), {}).get("installed", False) else "",
         "cover": _epic_cover(g),
         "description": _epic_desc(g)}
        for g in rows
    ]})
    done = 0
    updated = 0
    for g in rows:
        app_id = g.get("app_name") or ""
        title = str(g.get("app_title") or "")
        if ppid:
