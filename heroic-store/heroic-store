def _legendary_list_installed(env_extra=None):
    try:
        env = os.environ.copy()
        if env_extra:
            env.update(env_extra)
        proc = subprocess.run([LEGENDARY_BIN, "list-installed", "--json"],
                              capture_output=True, text=True, timeout=60, env=env)
        if proc.returncode == 0:
            data = json.loads(proc.stdout or "[]")
            return data if isinstance(data, list) else []
    except (ValueError, subprocess.TimeoutExpired, OSError):
        pass
    return []


def _verify_path_exe(ip: str, exe: str) -> bool:
    """Single installed criterion shared by every store: the install dir
    exists AND the game executable exists inside it (executable is usually
    relative to the install dir; an empty exe only requires the dir)."""
    if not ip or not Path(ip).is_dir():
        return False
    if exe:
        ep = Path(exe)
        if not ep.is_absolute():
            ep = Path(ip) / exe
        return ep.is_file()
    return True


def _installed_status():
    """app_name -> {"installed": bool, "stale": bool, "install_path": str,
    "executable": str}.

    installed = legendary registry entry AND the install dir exists AND the
    game executable exists on disk (executable is usually relative to the
    install dir). stale = registry entry present but the files are gone:
    the game is still listed so the launcher offers Install instead of
    Import, and installed.json is never edited here. install_path and
    executable are echoed from the registry so a verified game can be
    imported with its real folder/exe (a broken import must not fall back
    to a guessed default dir).
    """
    out = {}
    for g in _legendary_list_installed():
        app = g.get("app_name")
        if not app:
            continue
        ip = str(g.get("install_path") or "")
        exe = str(g.get("executable") or "")
        ok = _verify_path_exe(ip, exe)
        out[app] = {"installed": ok, "stale": not ok,
                    "install_path": ip, "executable": exe}
    return out


def _gog_installed_status():
    """app_id -> {"installed": bool, "stale": bool, "install_path": str,
    "executable": str} for GOG, using the plugin's own registry
    (installs.json, written by cmd_install and read by launch-info). Same
    single criterion as Epic: registry entry AND install dir exists AND
    executable exists on disk. GOG has no external list-installed to query,
    so installs.json is the only reliable source; a game installed outside
    the launcher (Heroic/Galaxy) simply has no entry and shows as not
    installed (Install), never as a false 'installed'.
    """
    out = {}
    for key, info in _read_installs().items():
        if not key.startswith("gog:") or not isinstance(info, dict):
            continue
        app = key.split(":", 1)[1]
        if not app:
            continue
        ip = str(info.get("path") or "")
        exe = str(info.get("exe") or "")
        # GOG: con exe vacío el dir DEBE parecer juego (el registro
        # {base,""} de una instalación fallida mostraba installed).
        # Epic no se toca (legendary manda).
        if exe:
            ok = _verify_path_exe(ip, exe)
        else:
            ok = bool(ip) and _gog_dir_parece_juego(Path(ip))
        # path que no es DIRECTAMENTE un juego (base compartida, nesting
        # legacy): Remove-con-archivos sobre esa carpeta es peligroso.
        # Solo se avisa (flag), no se corrige.
        misplaced = bool(ip) and not _gog_dir_parece_juego(Path(ip))
        out[app] = {"installed": ok, "stale": not ok,
                    "install_path": ip, "executable": exe,
                    "partial": info.get("status") == "partial",
                    "misplaced": misplaced}
    return out


def _pretty_dir_title(dirname: str) -> str:
    name = re.sub(r"(GgG\d+|EGS_?\d*|_?\d{4,})$", "", dirname).strip(" _-")
    name = re.sub(r"(?<!^)(?=[A-Z][a-z])", " ", name).strip()
    return re.sub(r"\s+", " ", name) or dirname


_SKIP_EXE = ("crashhandler", "crashpad", "unins", "setup", "redist",
              "vcredist", "dxsetup", "dotnet", "language_setup", "installer",
              "uninstall", "config", "launcher_update")


def _find_exe(root: Path):
    """Game exe within 1 level: skip helpers/crashhandlers, prefer a name
    resembling the folder, else the biggest remaining candidate."""
    try:
        top = list(root.iterdir())
    except OSError:
        return "", False
    subdirs = [p for p in top if p.is_dir()]
    # container guard: several subdirs each holding an exe = collection folder
    with_exe = 0
    for sub in subdirs:
        try:
            if any(f.is_file() and f.suffix.lower() == ".exe" for f in sub.iterdir()):
                with_exe += 1
        except OSError:
            continue
    if with_exe >= 2:
        return "", False
    cands = []
    for base in [root] + subdirs:
        try:
            entries = list(base.iterdir())
        except OSError:
            continue
        for p in entries:
            if not p.is_file() or p.suffix.lower() != ".exe":
                continue
            stem = p.stem.lower()
            if any(s in stem for s in _SKIP_EXE):
                continue
            try:
                sz = p.stat().st_size
            except OSError:
                continue
            if sz < 50 * 1024:
                continue
            cands.append((str(p.relative_to(root)), stem, sz))
    if not cands:
        for base in [root] + subdirs:
            try:
                entries = list(base.iterdir())
            except OSError:
                continue
            for p in entries:
                if p.is_file() and not p.suffix and os.access(p, os.X_OK):
                    return str(p.relative_to(root)), False
        return "", True
    norm = re.sub(r"[^a-z0-9]", "", root.name.lower())
    named = [c for c in cands if c[1].replace(" ", "") and
             (norm in c[1].replace(" ", "") or c[1].replace(" ", "") in norm)]
    pool = named or cands
    best = max(pool, key=lambda c: c[2])
    return best[0], True


def cmd_heroic_scan(_args):
    games = []
    seen_paths = set()
    titles = _heroic_titles()

    def push(store, app, title, version, ipath, exe, platform, eac, battleye):
        if not ipath or ipath in seen_paths:
            return
        seen_paths.add(ipath)
        games.append({
            "store": store, "app_id": app or Path(ipath).name,
            "title": title or _pretty_dir_title(Path(ipath).name),
            "version": version, "install_path": ipath, "executable": exe,
            "platform": platform, "requires_wine": platform == "Windows",
            "eac": bool(eac), "battleye": bool(battleye),
        })

    if Path(LEGENDARY_BIN).exists() or shutil.which("legendary"):
        # 1) own session installs
        for g in _legendary_list_installed():
            app = g.get("app_name", "")
            if not app:
                continue
            info = _legendary_info(app)
            game = info.get("game", {}) or {}
            inst = info.get("install", {}) or {}
            platform = game.get("platform", "Windows")
            push("epic", app, game.get("app_title") or titles.get(app) or g.get("title") or app,
                 inst.get("version") or g.get("version", ""),
                 inst.get("install_path") or g.get("install_path", ""),
                 inst.get("executable") or g.get("executable", ""),
                 platform, False, False)
        # 2) Heroic's own session installs (read-only: import only)
        heroic_leg = HEROIC_DIR / "legendaryConfig" / "legendary"
        if heroic_leg.is_dir():
            hero_env = {"LEGENDARY_CONFIG_PATH": str(heroic_leg)}
            hero_list = _legendary_list_installed(hero_env)
            missing = [g.get("app_name", "") for g in hero_list
                       if g.get("app_name") and not titles.get(g.get("app_name", ""))]
            hero_names = {}
            for app in missing:
                try:
                    env = os.environ.copy()
                    env.update(hero_env)
                    proc = subprocess.run(
                        [LEGENDARY_BIN, "info", app, "--json"],
                        capture_output=True, text=True, timeout=60, env=env)
                    if proc.returncode == 0:
                        gg = json.loads(proc.stdout or "{}").get("game") or {}
                        hero_names[app] = gg.get("title") or gg.get("app_title", "")
                except (ValueError, subprocess.TimeoutExpired, OSError):
                    continue
            for g in hero_list:
                app = g.get("app_name", "")
                if not app:
                    continue
                cfg = _heroic_game_cfg(app)
                ipath = g.get("install_path", "")
                title = (titles.get(app) or hero_names.get(app) or ""
                         or (g.get("app_title", "") if isinstance(g.get("app_title"), str) else ""))
                if not title and ipath:
                    title = _pretty_dir_title(Path(ipath).name)
                push("epic", app, title or app, g.get("version", ""),
                     ipath, g.get("executable", ""),
                     "Windows", cfg.get("eacRuntime", False),
                     cfg.get("battlEyeRuntime", False))
    # 3) filesystem fallback ONLY inside Heroic's own folder: game dirs
    # with an exe but no legendary record (killed/incomplete downloads).
    # Never ~/Games as a whole — those are GOG/manual games, not Heroic.
    roots = []
    for cand in (Path.home() / "Games" / "Heroic",):
        if cand.is_dir():
            roots.append(cand)
    for root in roots:
        try:
            subdirs = [p for p in root.iterdir() if p.is_dir()]
        except OSError:
            continue
        for d in subdirs:
            if d.name in ("Prefixes", "Heroic", "CommonRedist", "__redist"):
                continue
            if str(d) in seen_paths:
                continue
            exe, wine = _find_exe(d)
            if not exe:
                continue
            push("epic", d.name, _pretty_dir_title(d.name), "",
                 str(d), exe, "Windows" if wine else "Linux", False, False)
    eac = EAC_RUNTIME.is_dir()
    be = BE_RUNTIME.is_dir()
    emit({"type": "done", "ok": True, "games": games,
          "runtimes": {"eac": eac, "battleye": be,
                       "eac_path": str(EAC_RUNTIME) if eac else "",
                       "battleye_path": str(BE_RUNTIME) if be else ""}})


