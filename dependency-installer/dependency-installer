#!/usr/bin/env python3
"""Dependency Installer — CorkyTux plugin (v2.0.0).

Smart dependency detection:
1. Extract DLL names from game executables using strings
2. Check what Wine/Proton already provides
3. Only recommend deps that are ACTUALLY imported by the game AND not provided by Wine

Usage:
  dependency-installer scan <gamedir> [--prefix P] [--proton PATH]
  dependency-installer install --prefix P [--proton PATH] dep1 [dep2 ...]

Every command prints ONE JSON document on stdout.
Exit codes: 0 ok, 2 usage/invalid, 3 install failed.
"""
import json
import os
import re
import shutil
import subprocess
import sys

