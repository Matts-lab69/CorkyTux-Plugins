# ---------------------------------------------------------------------------
# DLL extraction using strings (reliable, no broken PE parsing)
# ---------------------------------------------------------------------------

def extract_dll_names(file_path):
    """Extract DLL names from a binary file using strings or fallback."""
    try:
        # Skip files larger than 100MB (strings takes too long)
        if os.path.getsize(file_path) > 100 * 1024 * 1024:
            return set()

        # Try to find strings binary
        strings_bin = shutil.which('strings')
        if not strings_bin:
            # Fallback: read file and extract with regex
            with open(file_path, 'rb') as f:
                data = f.read(50 * 1024 * 1024)  # Read first 50MB
            dlls = set()
            for match in re.finditer(rb'[\x20-\x7e]{4,60}', data):
                try:
                    s = match.group(0).decode('ascii').strip().lower()
                    if re.match(r'^[a-z0-9_\-\.]+\.dll$', s):
                        dlls.add(s)
                except:
                    pass
            return dlls

        result = subprocess.run(
            [strings_bin, '-n', '4', file_path],
            capture_output=True, text=True, timeout=10
        )
        dlls = set()
        for line in result.stdout.splitlines():
            line = line.strip().lower()
            # Match Windows DLL names: word.dll, api-ms-win-*.dll, etc.
            if re.match(r'^[a-z0-9_\-\.]+\.dll$', line):
                # Filter out obvious non-DLL strings
                if len(line) < 80 and not line.startswith(('.', '..', '...')):
                    dlls.add(line)
        return dlls
    except Exception:
        return set()


def scan_game(game_dir, prefix=None, proton_path=None):
    """Smart scan: extract DLL imports, check Wine built-ins, recommend only what's needed."""
    if not game_dir or not os.path.isdir(game_dir):
        json.dump({"ok": True, "deps": [], "message": "Invalid or missing game directory"}, sys.stdout)
        return

    # Find game executables and DLLs (top 2 levels)
    game_files = []
    for root, dirs, files in os.walk(game_dir):
        depth = root.replace(game_dir, '').count(os.sep)
        if depth > 2:
            dirs.clear()
            continue
        for f in files:
            if f.lower().endswith(('.exe', '.dll')):
                game_files.append(os.path.join(root, f))

    if not game_files:
        json.dump({"ok": True, "deps": [], "message": "No executables found"}, sys.stdout)
        return

    # Step 1: Extract ALL DLL names referenced in game files
    all_dlls = set()
    for f in game_files:
        dlls = extract_dll_names(f)
        all_dlls.update(dlls)

    # Step 2: Separate Wine built-ins from external
    wine_dlls = set()
    external_dlls = set()
    for dll in all_dlls:
        if is_wine_builtin(dll):
            wine_dlls.add(dll)
        else:
            external_dlls.add(dll)

    # Step 3: Check each dependency
    detected = []

    for dep in DEPENDENCIES:
        # If Wine provides this, skip entirely
        if dep.get("skip_if_wine"):
            continue

        # If game ships with Mono, skip .NET detection (Mono handles it)
        if dep["id"] in ("dotnet48", "dotnet35sp1"):
            has_mono = False
            has_dotnet = False
            for f in game_files:
                bn = os.path.basename(f).lower()
                if bn in ('mono-2.0-bdwgc.dll', 'mono.dll', 'monoposixhelper.dll'):
                    has_mono = True
                # .NET games have managed assemblies
                if bn.startswith(('system.', 'microsoft.', 'mscorlib.')) or \
                   bn.startswith(('System.', 'Microsoft.', 'mscorlib.')):
                    has_dotnet = True
            # Also check deeper for MonoBleedingEdge
            if not has_mono:
                for root, dirs, files in os.walk(game_dir):
                    for f in files:
                        if f.lower() in ('mono-2.0-bdwgc.dll', 'mono.dll'):
                            has_mono = True
                            break
                    if has_mono:
                        break
            # Skip if has Mono OR if game is not .NET (no managed assemblies)
            if has_mono or not has_dotnet:
                continue

        # Check if game ACTUALLY imports the required DLLs
        needs_dep = False
        evidence = []

        for dll in dep.get("must_import", []):
            if dll in all_dlls and not is_wine_builtin(dll):
                # Check if game ships with this DLL (doesn't need winetricks)
                game_has_dll = False
                for f in game_files:
                    if os.path.basename(f).lower() == dll:
                        game_has_dll = True
                        break
                if not game_has_dll:
                    needs_dep = True
                    evidence.append(dll)

        for pattern in dep.get("must_import_pattern", []):
            for dll in all_dlls:
                if re.match(pattern, dll) and not is_wine_builtin(dll):
                    # Check if game ships with this DLL
                    game_has_dll = False
                    for f in game_files:
                        if re.match(pattern, os.path.basename(f).lower()):
                            game_has_dll = True
                            break
                    if not game_has_dll:
                        needs_dep = True
                        evidence.append(dll)
                    break

        if needs_dep:
            # NOW check if already installed in prefix
            if prefix and check_dep_installed(prefix, dep):
                detected.append({
                    "id": dep["id"],
                    "desc": dep["desc"],
                    "confidence": "installed",
                    "status": "installed",
                })
            else:
                detected.append({
                    "id": dep["id"],
                    "desc": dep["desc"],
                    "confidence": "detected",
                    "evidence": evidence[:3],
                })

    # Summary
    needs_install = [d for d in detected if d.get("status") != "installed"]

    if not detected:
        json.dump({
            "ok": True,
            "deps": [],
            "message": f"No dependencies needed - game only uses Wine built-ins ({len(wine_dlls)} Wine DLLs found)",
            "game_dlls": len(all_dlls),
            "wine_dlls": len(wine_dlls),
            "external_dlls": len(external_dlls),
            "external_list": sorted(external_dlls)[:20],
        }, sys.stdout)
    elif not needs_install:
        json.dump({
            "ok": True,
            "deps": detected,
            "message": f"All {len(needs_install)} dependencies already installed",
        }, sys.stdout)
    else:
        json.dump({
            "ok": True,
            "deps": detected,
            "game_dir": game_dir,
            "game_dlls": len(all_dlls),
            "wine_dlls": len(wine_dlls),
            "external_dlls": len(external_dlls),
        }, sys.stdout)


def check_dep_installed(prefix, dep):
    """Check if a dependency is already installed in the prefix."""
    if not prefix:
        return False
    sys32 = os.path.join(prefix, "drive_c", "windows", "system32")
    syswow64 = os.path.join(prefix, "drive_c", "windows", "syswow64")
    search_dirs = [d for d in [sys32, syswow64] if os.path.isdir(d)]

    for dll in dep.get("must_import", []):
        for d in search_dirs:
            if os.path.isfile(os.path.join(d, dll)):
                return True
    return False


