def find_winetricks(proton_path=None):
    candidates = []
    if proton_path:
        for sub in ["protonfixes/winetricks", "protonfixes/files/bin/winetricks"]:
            candidates.append(os.path.join(proton_path, sub))
    sys_wt = shutil.which("winetricks")
    if sys_wt:
        candidates.append(sys_wt)
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_wine(proton_path=None):
    candidates = []
    if proton_path:
        for sub in ["files/bin/wine64", "files/bin/wine"]:
            candidates.append(os.path.join(proton_path, sub))
    sys_wine = shutil.which("wine64") or shutil.which("wine")
    if sys_wine:
        candidates.append(sys_wine)
    for c in candidates:
        if c and os.path.isfile(c):
            return c
    return None


def emit_progress(dep_id, desc, status, error=None):
    json.dump({"type": "progress", "id": dep_id, "desc": desc, "status": status, "error": error}, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.flush()


def install_deps(prefix, deps, proton_path=None):
    if not prefix or not os.path.isdir(prefix):
        json.dump({"ok": False, "error": f"Invalid prefix: {prefix}"}, sys.stdout)
        sys.exit(2)

    winetricks = find_winetricks(proton_path)
    if not winetricks:
        json.dump({"ok": False, "error": "winetricks not found"}, sys.stdout)
        sys.exit(2)

    wine = find_wine(proton_path)
    results = []
    failed = []

    for dep_id in deps:
        dep_def = None
        for d in DEPENDENCIES:
            if d["id"] == dep_id:
                dep_def = d
                break

        if not dep_def:
            results.append({"id": dep_id, "ok": False, "error": "Unknown dependency"})
            failed.append(dep_id)
            emit_progress(dep_id, dep_id, "error", "Unknown dependency")
            continue

        emit_progress(dep_id, dep_def["desc"], "installing")

        env = os.environ.copy()
        env["WINEPREFIX"] = prefix
        env["WINETRICKS_GUI"] = "0"
        env["DISPLAY"] = ""
        if wine:
            env["WINE"] = wine

        try:
            proc = subprocess.run(
                [winetricks, "-q", dep_def["verb"]],
                env=env, capture_output=True, text=True, timeout=300,
            )
            ok = proc.returncode == 0
            results.append({"id": dep_id, "desc": dep_def["desc"], "ok": ok,
                           "error": proc.stderr.strip() if not ok else None})
            if ok:
                emit_progress(dep_id, dep_def["desc"], "done")
            else:
                failed.append(dep_id)
                emit_progress(dep_id, dep_def["desc"], "error",
                            proc.stderr.strip()[:200] if proc.stderr else "Install failed")
        except subprocess.TimeoutExpired:
            results.append({"id": dep_id, "desc": dep_def["desc"], "ok": False, "error": "Timed out"})
            failed.append(dep_id)
            emit_progress(dep_id, dep_def["desc"], "error", "Timed out")
        except Exception as e:
            results.append({"id": dep_id, "desc": dep_def["desc"], "ok": False, "error": str(e)})
            failed.append(dep_id)
            emit_progress(dep_id, dep_def["desc"], "error", str(e))

    json.dump({
        "type": "done", "ok": len(failed) == 0, "results": results,
        "installed": [r["id"] for r in results if r["ok"]], "failed": failed,
    }, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.flush()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    if len(sys.argv) < 2:
        json.dump({"ok": False, "error": "Usage: dependency-installer <scan|install> [args]"}, sys.stdout)
        sys.exit(2)

    cmd = sys.argv[1]

    if cmd == "scan":
        prefix = None
        proton_path = None
        game_dir = None
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--prefix" and i + 1 < len(sys.argv):
                prefix = sys.argv[i + 1]
                i += 2
            elif sys.argv[i] == "--proton" and i + 1 < len(sys.argv):
                proton_path = sys.argv[i + 1]
                i += 2
            elif game_dir is None:
                game_dir = sys.argv[i]
                i += 1
            else:
                i += 1
        if not game_dir:
            json.dump({"ok": False, "error": "Usage: dependency-installer scan <gamedir>"}, sys.stdout)
            sys.exit(2)
        scan_game(game_dir, prefix, proton_path)

    elif cmd == "install":
        prefix = None
        proton_path = None
        deps = []
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--prefix" and i + 1 < len(sys.argv):
                prefix = sys.argv[i + 1]
                i += 2
            elif sys.argv[i] == "--proton" and i + 1 < len(sys.argv):
                proton_path = sys.argv[i + 1]
                i += 2
            else:
                deps.append(sys.argv[i])
                i += 1
        if not prefix:
            json.dump({"ok": False, "error": "--prefix is required"}, sys.stdout)
            sys.exit(2)
        if not deps:
            json.dump({"ok": False, "error": "At least one dependency ID is required"}, sys.stdout)
            sys.exit(2)
        install_deps(prefix, deps, proton_path)

    else:
        json.dump({"ok": False, "error": f"Unknown command: {cmd}"}, sys.stdout)
        sys.exit(2)


if __name__ == "__main__":
    main()
