# ---------------------------------------------------------------------------
# DLL extraction using strings (reliable, no broken PE parsing)
# ---------------------------------------------------------------------------

def extract_dll_names(file_path):
    """Extract DLL names from a binary file using strings."""
    try:
        result = subprocess.run(
            ['strings', '-n', '4', file_path],
            capture_output=True, text=True, timeout=30
        )
        dlls = set()
        for line in result.stdout.splitlines():
            line = line.strip().lower()
            # Match Windows DLL names: word.dll, word.dll (with numbers)
            if re.match(r'^[a-z0-9_\-]+\.dll$', line):
                dlls.add(line)
        return dlls
    except Exception:
        return set()


def scan_game(game_dir, prefix=None, proton_path=None):
    """Smart scan: extract DLL imports, check Wine built-ins, recommend only what's needed."""
    if not game_dir or not os.path.isdir(game_dir):
        json.dump({"ok": True, "deps": [], "message": "Invalid or missing game directory"}, sys.stdout)
        return

    # Find game executables and DLLs (top 2 levels)
    game_files = []
    for root, dirs, files in os.walk(game_dir):
        depth = root.replace(game_dir, '').count(os.sep)
        if depth > 2:
            dirs.clear()
            continue
        for f in files:
            if f.lower().endswith(('.exe', '.dll')):
                game_files.append(os.path.join(root, f))

    if not game_files:
        json.dump({"ok": True, "deps": [], "message": "No executables found"}, sys.stdout)
        return

    # Step 1: Extract ALL DLL names referenced in game files
    all_dlls = set()
    for f in game_files:
        dlls = extract_dll_names(f)
        all_dlls.update(dlls)

    # Step 2: Separate Wine built-ins from external
    wine_dlls = set()
    external_dlls = set()
    for dll in all_dlls:
        if is_wine_builtin(dll):
            wine_dlls.add(dll)
        else:
            external_dlls.add(dll)

    # Step 3: Check each dependency
    detected = []

    for dep in DEPENDENCIES:
        # If Wine provides this, skip entirely
        if dep.get("skip_if_wine"):
            continue

        # If game ships with Mono, skip .NET detection (Mono handles it)
        if dep["id"] in ("dotnet48", "dotnet35sp1"):
            has_mono = any(os.path.basename(f).lower() in ('mono-2.0-bdwgc.dll', 'mono.dll')
                          for f in game_files)
            if has_mono:
                continue

        # Check if game ACTUALLY imports the required DLLs
        needs_dep = False
        evidence = []

        for dll in dep.get("must_import", []):
            if dll in all_dlls:
                # Check if game ships with this DLL (doesn't need winetricks)
                game_has_dll = False
                for f in game_files:
                    if os.path.basename(f).lower() == dll:
                        game_has_dll = True
                        break
                if not game_has_dll:
                    needs_dep = True
                    evidence.append(dll)

        for pattern in dep.get("must_import_pattern", []):
            for dll in all_dlls:
                if re.match(pattern, dll):
                    # Check if game ships with this DLL
                    game_has_dll = False
                    for f in game_files:
                        if re.match(pattern, os.path.basename(f).lower()):
                            game_has_dll = True
                            break
                    if not game_has_dll:
                        needs_dep = True
                        evidence.append(dll)
                    break

        if needs_dep:
            # NOW check if already installed in prefix
            if prefix and check_dep_installed(prefix, dep):
                detected.append({
                    "id": dep["id"],
                    "desc": dep["desc"],
                    "confidence": "installed",
                    "status": "installed",
                })
            else:
                detected.append({
                    "id": dep["id"],
                    "desc": dep["desc"],
                    "confidence": "detected",
                    "evidence": evidence[:3],
                })

    # Summary
    needs_install = [d for d in detected if d.get("status") != "installed"]

    if not detected:
        json.dump({
            "ok": True,
            "deps": [],
            "message": f"No dependencies needed - game only uses Wine built-ins ({len(wine_dlls)} Wine DLLs found)",
            "game_dlls": len(all_dlls),
            "wine_dlls": len(wine_dlls),
            "external_dlls": len(external_dlls),
            "external_list": sorted(external_dlls)[:20],
        }, sys.stdout)
    elif not needs_install:
        json.dump({
            "ok": True,
            "deps": detected,
            "message": f"All {len(needs_install)} dependencies already installed",
        }, sys.stdout)
    else:
        json.dump({
            "ok": True,
            "deps": detected,
            "game_dir": game_dir,
            "game_dlls": len(all_dlls),
            "wine_dlls": len(wine_dlls),
            "external_dlls": len(external_dlls),
        }, sys.stdout)


def check_dep_installed(prefix, dep):
    """Check if a dependency is already installed in the prefix."""
    if not prefix:
        return False
    sys32 = os.path.join(prefix, "drive_c", "windows", "system32")
    syswow64 = os.path.join(prefix, "drive_c", "windows", "syswow64")
    search_dirs = [d for d in [sys32, syswow64] if os.path.isdir(d)]

    for dll in dep.get("must_import", []):
        for d in search_dirs:
            if os.path.isfile(os.path.join(d, dll)):
                return True
    return False


# ---------------------------------------------------------------------------
# Install
# ---------------------------------------------------------------------------

def find_winetricks(proton_path=None):
    candidates = []
    if proton_path:
        for sub in ["protonfixes/winetricks", "protonfixes/files/bin/winetricks"]:
            candidates.append(os.path.join(proton_path, sub))
    sys_wt = shutil.which("winetricks")
    if sys_wt:
        candidates.append(sys_wt)
    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_wine(proton_path=None):
    candidates = []
    if proton_path:
        for sub in ["files/bin/wine64", "files/bin/wine"]:
            candidates.append(os.path.join(proton_path, sub))
    sys_wine = shutil.which("wine64") or shutil.which("wine")
    if sys_wine:
        candidates.append(sys_wine)
    for c in candidates:
        if c and os.path.isfile(c):
            return c
    return None


def emit_progress(dep_id, desc, status, error=None):
    json.dump({"type": "progress", "id": dep_id, "desc": desc, "status": status, "error": error}, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.flush()


def install_deps(prefix, deps, proton_path=None):
    if not prefix or not os.path.isdir(prefix):
        json.dump({"ok": False, "error": f"Invalid prefix: {prefix}"}, sys.stdout)
        sys.exit(2)

    winetricks = find_winetricks(proton_path)
    if not winetricks:
        json.dump({"ok": False, "error": "winetricks not found"}, sys.stdout)
        sys.exit(2)

    wine = find_wine(proton_path)
    results = []
    failed = []

    for dep_id in deps:
        dep_def = None
        for d in DEPENDENCIES:
            if d["id"] == dep_id:
                dep_def = d
                break

        if not dep_def:
            results.append({"id": dep_id, "ok": False, "error": "Unknown dependency"})
            failed.append(dep_id)
            emit_progress(dep_id, dep_id, "error", "Unknown dependency")
            continue

        emit_progress(dep_id, dep_def["desc"], "installing")

        env = os.environ.copy()
        env["WINEPREFIX"] = prefix
        env["WINETRICKS_GUI"] = "0"
        env["DISPLAY"] = ""
        if wine:
            env["WINE"] = wine

        try:
            proc = subprocess.run(
                [winetricks, "-q", dep_def["verb"]],
                env=env, capture_output=True, text=True, timeout=300,
            )
            ok = proc.returncode == 0
            results.append({"id": dep_id, "desc": dep_def["desc"], "ok": ok,
                           "error": proc.stderr.strip() if not ok else None})
            if ok:
                emit_progress(dep_id, dep_def["desc"], "done")
            else:
                failed.append(dep_id)
                emit_progress(dep_id, dep_def["desc"], "error",
                            proc.stderr.strip()[:200] if proc.stderr else "Install failed")
        except subprocess.TimeoutExpired:
            results.append({"id": dep_id, "desc": dep_def["desc"], "ok": False, "error": "Timed out"})
            failed.append(dep_id)
            emit_progress(dep_id, dep_def["desc"], "error", "Timed out")
        except Exception as e:
            results.append({"id": dep_id, "desc": dep_def["desc"], "ok": False, "error": str(e)})
            failed.append(dep_id)
            emit_progress(dep_id, dep_def["desc"], "error", str(e))

    json.dump({
        "type": "done", "ok": len(failed) == 0, "results": results,
        "installed": [r["id"] for r in results if r["ok"]], "failed": failed,
    }, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.flush()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    if len(sys.argv) < 2:
        json.dump({"ok": False, "error": "Usage: dependency-installer <scan|install> [args]"}, sys.stdout)
        sys.exit(2)

    cmd = sys.argv[1]

    if cmd == "scan":
        prefix = None
        proton_path = None
        game_dir = None
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--prefix" and i + 1 < len(sys.argv):
                prefix = sys.argv[i + 1]
                i += 2
            elif sys.argv[i] == "--proton" and i + 1 < len(sys.argv):
                proton_path = sys.argv[i + 1]
                i += 2
            elif game_dir is None:
                game_dir = sys.argv[i]
                i += 1
            else:
                i += 1
        if not game_dir:
            json.dump({"ok": False, "error": "Usage: dependency-installer scan <gamedir>"}, sys.stdout)
            sys.exit(2)
        scan_game(game_dir, prefix, proton_path)

    elif cmd == "install":
        prefix = None
        proton_path = None
        deps = []
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--prefix" and i + 1 < len(sys.argv):
                prefix = sys.argv[i + 1]
                i += 2
            elif sys.argv[i] == "--proton" and i + 1 < len(sys.argv):
                proton_path = sys.argv[i + 1]
                i += 2
            else:
                deps.append(sys.argv[i])
                i += 1
        if not prefix:
            json.dump({"ok": False, "error": "--prefix is required"}, sys.stdout)
            sys.exit(2)
        if not deps:
            json.dump({"ok": False, "error": "At least one dependency ID is required"}, sys.stdout)
            sys.exit(2)
        install_deps(prefix, deps, proton_path)

    else:
        json.dump({"ok": False, "error": f"Unknown command: {cmd}"}, sys.stdout)
        sys.exit(2)


if __name__ == "__main__":
    main()
