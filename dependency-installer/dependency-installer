def is_wine_builtin(dll_name):
    """Check if a DLL is provided by Wine/Proton natively."""
    dll = dll_name.lower()
    if dll in WINE_PROVIDES:
        return True
    # Check patterns
    for pattern in ['xactengine*.dll', 'x3daudio*.dll', 'xapo*.dll']:
        prefix = pattern.split('*')[0]
        suffix = pattern.split('*')[-1] if '*' in pattern else ''
        if dll.startswith(prefix) and dll.endswith(suffix):
            return True
    return False

