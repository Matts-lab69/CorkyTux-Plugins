def err(msg, code=2):
    """Print error JSON and exit."""
    json.dump({"ok": False, "error": msg}, sys.stdout)
    sys.exit(code)


def find_exe_files(directory, extensions=(".exe", ".dll")):
    """Recursively find all files with given extensions."""
    results = []
    for root, dirs, files in os.walk(directory):
        for f in files:
            if any(f.lower().endswith(ext) for ext in extensions):
                results.append(os.path.join(root, f))
    return results


def scan_game(game_dir):
    """Scan a game directory for dependency hints."""
    if not game_dir or not os.path.isdir(game_dir):
        json.dump({"ok": True, "deps": [], "message": "Invalid or missing game directory"}, sys.stdout)
        return

    try:
        exe_files = find_exe_files(game_dir)
    except Exception as e:
        json.dump({"ok": True, "deps": [], "message": f"Scan error: {e}"}, sys.stdout)
        return

    if not exe_files:
        json.dump({"ok": True, "deps": [], "message": "No executables found in game directory"}, sys.stdout)
        return

    # Read all DLL names present in the game directory
    dll_names = set()
    for f in exe_files:
        dll_names.add(os.path.basename(f).lower())

    # Check which dependencies are hinted at
    detected = []
    for dep in DEPENDENCIES:
        # Common deps are always recommended
        if dep["common"]:
            detected.append({
                "id": dep["id"],
                "desc": dep["desc"],
                "confidence": "recommended",
            })
            continue

        # For non-common deps, check if any detect files are present
        has_own = False
        for pattern in dep["detect_files"]:
            if "*" in pattern:
                prefix_pat = pattern.split("*")[0].lower()
                suffix_pat = pattern.split("*")[-1].lower() if "*" in pattern else ""
                for dll in dll_names:
                    if dll.startswith(prefix_pat) and dll.endswith(suffix_pat):
                        has_own = True
                        break
            elif pattern.lower() in dll_names:
                has_own = True
                break

        if not has_own:
            detected.append({
                "id": dep["id"],
                "desc": dep["desc"],
                "confidence": "suggested",
            })

    if not detected:
        json.dump({
            "ok": True,
            "deps": [],
            "message": "No dependencies needed - game appears to be fully configured",
        }, sys.stdout)
    else:
        json.dump({
            "ok": True,
            "deps": detected,
            "game_dir": game_dir,
            "total_dlls": len([f for f in exe_files if f.lower().endswith(".dll")]),
            "total_exes": len([f for f in exe_files if f.lower().endswith(".exe")]),
        }, sys.stdout)


def find_winetricks(proton_path=None):
    """Find winetricks binary from Proton directory or system."""
    candidates = []

    if proton_path:
        # Look inside Proton directory
        for sub in [
            "protonfixes/winetricks",
            "protonfixes/files/bin/winetricks",
        ]:
            candidates.append(os.path.join(proton_path, sub))

    # System winetricks
    sys_wt = shutil.which("winetricks")
    if sys_wt:
        candidates.append(sys_wt)

    for c in candidates:
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def find_wine(proton_path=None):
    """Find wine binary from Proton directory or system."""
    candidates = []

    if proton_path:
        for sub in ["files/bin/wine64", "files/bin/wine"]:
            candidates.append(os.path.join(proton_path, sub))

    sys_wine = shutil.which("wine64") or shutil.which("wine")
    if sys_wine:
        candidates.append(sys_wine)

    for c in candidates:
        if c and os.path.isfile(c):
            return c
    return None


def emit_progress(dep_id, desc, status, error=None):
    """Emit a single JSON line for real-time progress."""
    json.dump({"type": "progress", "id": dep_id, "desc": desc, "status": status, "error": error}, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.flush()


def install_deps(prefix, deps, proton_path=None):
    """Install dependencies using winetricks."""
    if not prefix or not os.path.isdir(prefix):
        err(f"Invalid prefix: {prefix}")

    winetricks = find_winetricks(proton_path)
    if not winetricks:
        err("winetricks not found. Install winetricks or use a Proton with bundled winetricks.")

    wine = find_wine(proton_path)

    results = []
    failed = []
    total = len(deps)

    for idx, dep_id in enumerate(deps):
        # Find the dependency definition
        dep_def = None
        for d in DEPENDENCIES:
            if d["id"] == dep_id:
                dep_def = d
                break

        if not dep_def:
            results.append({"id": dep_id, "ok": False, "error": "Unknown dependency"})
            failed.append(dep_id)
            emit_progress(dep_id, dep_id, "error", "Unknown dependency")
            continue

        emit_progress(dep_id, dep_def["desc"], "installing")

        # Set up environment
        env = os.environ.copy()
        env["WINEPREFIX"] = prefix
        if wine:
            env["WINE"] = wine
        # Disable winetricks GUI prompts
        env["WINETRICKS_GUI"] = "0"

        try:
            proc = subprocess.run(
                [winetricks, "-q", dep_def["verb"]],
                env=env,
                capture_output=True,
                text=True,
                timeout=300,  # 5 minute timeout per dep
            )
            ok = proc.returncode == 0
            results.append({
                "id": dep_id,
                "desc": dep_def["desc"],
                "ok": ok,
                "error": proc.stderr.strip() if not ok else None,
            })
            if ok:
                emit_progress(dep_id, dep_def["desc"], "done")
            else:
                failed.append(dep_id)
                emit_progress(dep_id, dep_def["desc"], "error", proc.stderr.strip()[:200] if proc.stderr else "Install failed")
        except subprocess.TimeoutExpired:
            results.append({
                "id": dep_id,
                "desc": dep_def["desc"],
                "ok": False,
                "error": "Installation timed out (5 min limit)",
            })
            failed.append(dep_id)
            emit_progress(dep_id, dep_def["desc"], "error", "Timed out")
        except Exception as e:
            results.append({
                "id": dep_id,
                "desc": dep_def["desc"],
                "ok": False,
                "error": str(e),
            })
            failed.append(dep_id)
            emit_progress(dep_id, dep_def["desc"], "error", str(e))

    # Final summary line
    json.dump({
        "type": "done",
        "ok": len(failed) == 0,
        "results": results,
        "installed": [r["id"] for r in results if r["ok"]],
        "failed": failed,
    }, sys.stdout)
    sys.stdout.write("\n")
    sys.stdout.flush()


def main():
    if len(sys.argv) < 2:
        err("Usage: dependency-installer <scan|install> [args]")

    cmd = sys.argv[1]

    if cmd == "scan":
        if len(sys.argv) < 3:
            err("Usage: dependency-installer scan <gamedir>")
        scan_game(sys.argv[2])

    elif cmd == "install":
        # Parse args: --prefix P [--proton PATH] dep1 [dep2 ...]
        prefix = None
        proton_path = None
        deps = []
        i = 2
        while i < len(sys.argv):
            if sys.argv[i] == "--prefix" and i + 1 < len(sys.argv):
                prefix = sys.argv[i + 1]
                i += 2
            elif sys.argv[i] == "--proton" and i + 1 < len(sys.argv):
                proton_path = sys.argv[i + 1]
                i += 2
            else:
                deps.append(sys.argv[i])
                i += 1

        if not prefix:
            err("--prefix is required")
        if not deps:
            err("At least one dependency ID is required")

        install_deps(prefix, deps, proton_path)

    else:
        err(f"Unknown command: {cmd}")


if __name__ == "__main__":
    main()
