def find_compatible_java(required_major: int, max_major: int = 99):
    best = None
    best_major = None
    for path, origin in _iter_java_candidates():
        p = Path(path)
        if not (p.is_file() and os.access(p, os.X_OK)):
            continue
        ver = _java_version_of(path)
        major = _java_major_of(ver)
        if major < required_major or major > max_major:
            continue
        if best is None or major < best_major:
            best, best_major = {"path": path, "version": ver,
                                "major": major, "origin": origin}, major
    return best


def cmd_java_detect(args):
    found = []
    seen = set()
    seen_real = set()

    def add(path: str, origin: str):
        p = str(Path(path).expanduser())
        if p in seen:
            return
        seen.add(p)
        try:
            rp = str(Path(p).resolve())
        except OSError:
            rp = p
        if rp in seen_real:
            return
        seen_real.add(rp)
        if Path(p).is_file() and os.access(p, os.X_OK):
            ver = _java_version_of(p)
            found.append({"path": p, "version": ver,
                          "major": _java_major_of(ver), "origin": origin})

    import shutil as _sh  # noqa
    for cand in ["/usr/bin/java", "/usr/local/bin/java"]:
        add(cand, "system")
    jh = os.environ.get("JAVA_HOME", "")
    if jh:
        add(str(Path(jh) / "bin" / "java"), "JAVA_HOME")
    for jvm in sorted(Path("/usr/lib/jvm").glob("*/bin/java")):
        add(str(jvm), "jvm-dir")
    for jvm in sorted(Path("/usr/lib/jvm").glob("*/*/bin/java")):
        add(str(jvm), "jvm-dir-nested")
    for base in [Path.home() / "jdk", Path("/opt/jvm"), Path("/opt/java")]:
        if base.is_dir():
            for jvm in sorted(base.glob("*/bin/java")):
                add(str(jvm), "temurin-dir")
    for jb in sorted(Path("/opt").glob("*/bin/java")):
        add(str(jb), "opt-dir")
    try:
        alt = subprocess_run(["update-alternatives", "--list", "java"], timeout=10)
        for line in ((alt.stdout or "").splitlines()):
            p = line.strip()
            if p:
                add(p, "alternatives")
    except Exception:
        pass
    for jb in sorted((Path.home() / ".minecraft" / "runtime").rglob("bin/java")):
        add(str(jb), "mojang-runtime")
    for jb in sorted(JAVA_DIR.glob("*/bin/java")) + sorted(JAVA_DIR.glob("*/*/bin/java")):
        add(str(jb), "corkytux-adoptium")
    which_java = _sh.which("java")
    if which_java:
        add(which_java, "PATH")

    state = _read_java_json()
    emit({"type": "done", "ok": True, "found": found,
          "selected": state.get("selected", "")})


def cmd_java_install(args):
    import shutil as _sh
    import subprocess as sp
    import tarfile
    import urllib.request

    ver = args.version
    if ver not in JAVA_VERSIONS:
        die(2, f"version must be one of {JAVA_VERSIONS}")
    dest = JAVA_DIR / ver
    emit({"type": "progress", "stage": f"downloading-java-{ver}", "percent": 0})
    url = ADOPTIUM_API.format(ver=ver)
    tmp = JAVA_DIR / f".tmp-java-{ver}.tar.gz"
    try:
        JAVA_DIR.mkdir(parents=True, exist_ok=True)
        req = urllib.request.Request(url, headers={"User-Agent": "CorkyTux/3.0"})
        downloaded = 0
        with urllib.request.urlopen(req, timeout=60) as resp, open(tmp, "wb") as f:
            total = int(resp.headers.get("Content-Length", 0))
            while True:
                chunk = resp.read(1024 * 256)
                if not chunk:
                    break
                f.write(chunk)
                downloaded += len(chunk)
                if total:
                    emit({"type": "progress", "stage": f"downloading-java-{ver}",
                          "percent": round(downloaded * 100 / total, 1)})
        emit({"type": "progress", "stage": f"extracting-java-{ver}", "percent": None})
        if dest.exists():
            _sh.rmtree(dest, ignore_errors=True)
        dest.mkdir(parents=True, exist_ok=True)
        with tarfile.open(tmp, "r:gz") as tf:
            tf.extractall(dest)
        tmp.unlink(missing_ok=True)
    except Exception as e:
        die(3, f"Java {ver} download failed: {e}")

    cands = sorted(dest.glob("*/bin/java")) + sorted(dest.glob("bin/java"))
    java_bin = str(cands[0]) if cands else ""
    if not java_bin or not _java_version_of(java_bin):
        die(3, f"Java {ver} extracted but bin/java is unusable")
    try:
        os.chmod(java_bin, 0o755)
    except OSError:
        pass
    state = _read_java_json()
    installs = state.get("installs", {})
    installs[ver] = java_bin
    state["installs"] = installs
    if not state.get("selected"):
        state["selected"] = java_bin
    _write_java_json(state)
    emit({"type": "done", "ok": True, "version": ver, "path": java_bin,
          "java_version": _java_version_of(java_bin)})


