# --- JSON Lines helper --------------------------------------------------

def emit(event: dict):
    print(json.dumps(event), flush=True)


def die(code: int, message: str):
    emit({"type": "error", "message": message})
    sys.exit(code)


# --- Auth (device code flow) --------------------------------------------

def cmd_auth(args):
    client_id = effective_client_id()
    if client_id.startswith("REPLACE_WITH") or not client_id.strip():
        die(4, "CLIENT_ID not configured. Register an Azure app (portal.azure.com -> App "
               "registrations, Mobile+desktop, public client flows) and save it with: "
               "auth-config --client-id <id>.")

    resp = requests.post(DEVICE_CODE_URL, data={
        "client_id": client_id,
        "scope": "XboxLive.signin offline_access",
    })
    resp.raise_for_status()
    data = resp.json()

    emit({
        "type": "device_code",
        "user_code": data["user_code"],
        "verification_uri": data["verification_uri"],
        "expires_in": data["expires_in"],
    })

    interval = data.get("interval", 5)
    device_code = data["device_code"]
    expires_at = time.time() + data["expires_in"]

    ms_token = None
    while time.time() < expires_at:
        time.sleep(interval)
        poll = requests.post(TOKEN_URL, data={
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
            "client_id": client_id,
            "device_code": device_code,
        })
        payload = poll.json()
        if poll.status_code == 200:
            ms_token = payload["access_token"]
            break
        if payload.get("error") not in ("authorization_pending", "slow_down"):
            die(4, f"MS auth failed: {payload.get('error')}")

    if not ms_token:
        die(4, "Device code expired before user authorized")

    emit({"type": "progress", "stage": "xbox_live_auth", "percent": 40})
    xbl = requests.post(XBL_AUTH_URL, json={
        "Properties": {"AuthMethod": "RPS", "SiteName": "user.auth.xboxlive.com",
                        "RpsTicket": f"d={ms_token}"},
        "RelyingParty": "http://auth.xboxlive.com",
        "TokenType": "JWT",
    }).json()
    xbl_token = xbl["Token"]
    uhs = xbl["DisplayClaims"]["xui"][0]["uhs"]

    emit({"type": "progress", "stage": "xsts_auth", "percent": 60})
    xsts = requests.post(XSTS_AUTH_URL, json={
        "Properties": {"SandboxId": "RETAIL", "UserTokens": [xbl_token]},
        "RelyingParty": "rp://api.minecraftservices.com/",
        "TokenType": "JWT",
    }).json()
    xsts_token = xsts["Token"]

    emit({"type": "progress", "stage": "minecraft_login", "percent": 80})
    mc_login = requests.post(MC_LOGIN_URL, json={
        "identityToken": f"XBL3.0 x={uhs};{xsts_token}"
    }).json()
    mc_access_token = mc_login["access_token"]

    profile = requests.get(MC_PROFILE_URL, headers={
        "Authorization": f"Bearer {mc_access_token}"
    }).json()

    if "id" not in profile:
        die(4, "Account has no Minecraft profile (game not owned / not migrated)")

    account = {
        "id": profile["id"],
        "name": profile["name"],
        "access_token": mc_access_token,
    }
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    accounts = json.loads(ACCOUNTS_FILE.read_text()) if ACCOUNTS_FILE.exists() else []
    accounts = [a for a in accounts if a["id"] != account["id"]] + [account]
    ACCOUNTS_FILE.write_text(json.dumps(accounts, indent=2))

    emit({"type": "done", "ok": True, "account_id": account["id"], "username": account["name"]})


