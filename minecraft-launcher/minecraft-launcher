def _cf_key() -> str:
    try:
        key = str(json.loads(CURSE_JSON.read_text()).get("api_key", "")).strip()
    except (OSError, ValueError):
        key = ""
    if len(key) < 20:
        key = CURSE_BUILTIN_KEY.strip()
    if len(key) < 20:
        die(4, "CurseForge API key missing and no built-in key set.")
    return key


def _cf_get(path: str, params: dict = None):
