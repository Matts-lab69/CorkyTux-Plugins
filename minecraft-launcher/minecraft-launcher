def _pct(value, maximum):
    if not maximum:
        return 0
    return min(100, int(value * 100 / maximum))


def _check_available_memory(requested_heap_mb: int):
    """Refuse to launch if free RAM can't cover the requested JVM heap
    plus a safety margin. Returns (ok, available_mb)."""
    if psutil is None:
        # Can't check without psutil; don't block launch, just skip the check.
        return True, None
    available_mb = psutil.virtual_memory().available / (1024 * 1024)
    needed_mb = requested_heap_mb + MIN_FREE_RAM_MARGIN_MB
    return available_mb >= needed_mb, available_mb


def _account_lock_path(account_id: str) -> Path:
    return LOCKS_DIR / f"{account_id}.lock"


def _acquire_account_lock(account_id: str) -> bool:
    """Prevent launching the same account twice concurrently. Stale
    locks (pointing to a pid that no longer exists) are cleared
    automatically."""
    LOCKS_DIR.mkdir(parents=True, exist_ok=True)
    lock_path = _account_lock_path(account_id)

    if lock_path.exists():
        try:
            held_pid = int(lock_path.read_text().strip())
        except (ValueError, OSError):
            held_pid = None

        still_running = False
        if held_pid is not None:
            if psutil is not None:
                still_running = psutil.pid_exists(held_pid)
            else:
                still_running = _pid_exists_fallback(held_pid)

        if still_running:
            return False
        lock_path.unlink(missing_ok=True)

    lock_path.write_text(str(os.getpid()))
    return True


def _pid_exists_fallback(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    return True


def cmd_launch(args):
    _require_mll()
    mc_dir = _mc_dir(args)
    if not ACCOUNTS_FILE.exists():
        die(4, "No accounts. Run 'auth' first.")

    accounts = json.loads(ACCOUNTS_FILE.read_text())
    account = next((a for a in accounts if a["id"] == args.account), None) if args.account else (accounts[0] if accounts else None)
    if not account:
        die(4, f"Account not found: {args.account}")

    if not _acquire_account_lock(account["id"]):
        die(4, f"Account {account['name']} is already running an instance")

    ok, available_mb = _check_available_memory(args.max_memory_mb)
    if not ok:
        _account_lock_path(account["id"]).unlink(missing_ok=True)
        die(3, f"Not enough free RAM: need ~{args.max_memory_mb + MIN_FREE_RAM_MARGIN_MB}MB, "
               f"have {available_mb:.0f}MB available")
    if available_mb is not None:
        emit({"type": "progress", "stage": "memory_check", "percent": 100,
              "available_mb": round(available_mb)})

    jvm_args = [f"-Xmx{args.max_memory_mb}M"]
    if args.min_memory_mb and args.min_memory_mb > 0:
        jvm_args.append(f"-Xms{args.min_memory_mb}M")
    for extra in (args.jvm_arg or []):
        extra = (extra or "").strip()
        if extra:
            jvm_args.append(extra)
    options = {
        "username": account["name"],
        "uuid": account["id"],
        "token": account["access_token"],
        "jvmArguments": jvm_args,
    }
    if args.resolution:
        m = re.match(r"(\d+)x(\d+)", args.resolution.strip())
        if m:
            options["customResolution"] = True
            options["resolutionWidth"] = m.group(1)
            options["resolutionHeight"] = m.group(2)

    mc_part = _mc_of_version_id(args.version)
    required = manifest_java_required(mc_dir, args.version)
    if not isinstance(required, int):
        required = required_java_major(mc_part or args.version)
    max_major = max_java_major(mc_part or args.version)
    raw_java = (args.java or "").strip()
    java_bin = ""
    if raw_java and raw_java != "auto" and Path(raw_java).is_file():
        if required <= _java_major_of(_java_version_of(raw_java)) <= max_major:
            java_bin = raw_java
    elif raw_java and raw_java != "auto":
        pass
    else:
        sel = _read_java_json().get("selected", "")
        if sel and Path(sel).is_file() and required <= _java_major_of(_java_version_of(sel)) <= max_major:
            java_bin = sel
        else:
            auto = find_compatible_java(required, max_major)
            if auto:
                java_bin = auto["path"]
    if not java_bin or not Path(java_bin).is_file():
        _account_lock_path(account["id"]).unlink(missing_ok=True)
        want = f"Java {required}+" if max_major >= 99 else f"Java {required}-{max_major}"
        die(3, f"No compatible Java found for Minecraft {args.version} "
               f"(needs {want}). Install it below "
               f"or set a system Java — no download was started automatically.")
    emit({"type": "progress", "stage": "java_select", "percent": 100,
          "java": java_bin, "required_java": required})
    launch_env = None
    if java_bin and Path(java_bin).is_file():
        java_dir = str(Path(java_bin).parent)
        env = os.environ.copy()
        env["PATH"] = java_dir + os.pathsep + env.get("PATH", "")
        env["JAVA_HOME"] = str(Path(java_bin).parent.parent)
        launch_env = env
        options["executablePath"] = java_bin

    try:
        command = mll.command.get_minecraft_command(
            version=args.version,
            minecraft_directory=str(mc_dir),
            options=options,
        )
    except TypeError:
        options.pop("executablePath", None)
        try:
            command = mll.command.get_minecraft_command(
                version=args.version,
                minecraft_directory=str(mc_dir),
                options=options,
            )
        except Exception as e:
            _account_lock_path(account["id"]).unlink(missing_ok=True)
            die(3, f"Could not build launch command: {e}")
    except Exception as e:
        _account_lock_path(account["id"]).unlink(missing_ok=True)
        die(3, f"Could not build launch command: {e}")

    if args.dry_run:
        _account_lock_path(account["id"]).unlink(missing_ok=True)
        emit({"type": "done", "ok": True, "dry_run": True,
              "java": command[0] if command else "", "argv": command})
        return

    if args.pre_hook and args.pre_hook.strip():
        emit({"type": "progress", "stage": "pre_hook", "percent": None})
        hook = subprocess.run(args.pre_hook.strip(), shell=True, cwd=str(mc_dir),
                              capture_output=True, text=True, timeout=300)
        if hook.returncode != 0:
            emit({"type": "progress", "stage": "pre_hook_failed", "percent": None})

    import datetime as _dt
    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    safe_ver = re.sub(r"[^A-Za-z0-9._-]+", "_", args.version)
    log_path = LOGS_DIR / f"Minecraft-{safe_ver}-{_dt.datetime.now():%Y%m%d-%H%M%S}.log"
    try:
        log_fh = open(log_path, "w")
        log_fh.write(f"# CorkyTux Minecraft {args.version} as {account['name']} java={java_bin}\n")
        log_fh.write(f"# cmd: {' '.join(command)}\n")
        log_fh.flush()
    except OSError as e:
        _account_lock_path(account["id"]).unlink(missing_ok=True)
        die(3, f"Cannot write log file: {e}")
    if args.wrapper and args.wrapper.strip():
        command = args.wrapper.strip().split() + command
    proc = subprocess.Popen(command, cwd=str(mc_dir), env=launch_env,
                             stdout=log_fh, stderr=subprocess.STDOUT,
                             start_new_session=True)
    # Lock now points at the actual game process, not this short-lived plugin.
    _account_lock_path(account["id"]).write_text(str(proc.pid))
    emit({"type": "done", "ok": True, "pid": proc.pid,
          "log": str(log_path), "java": java_bin,
          "required_java": required})


