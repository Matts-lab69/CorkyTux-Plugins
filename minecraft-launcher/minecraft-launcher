LOADERS = ["fabric", "forge", "neoforge", "quilt"]


def _install_callbacks():
    state = {"max": 1}

    def set_status(status):
        emit({"type": "progress", "stage": status, "percent": None})

    def set_progress(value):
        emit({"type": "progress", "stage": "downloading",
              "percent": _pct(value, state["max"])})

    def set_max(value):
        state["max"] = value

    return {"setStatus": set_status, "setProgress": set_progress,
            "setMax": set_max}




def _mc_dir(args) -> Path:
    custom = (getattr(args, "mc_dir", "") or "").strip()
    if custom:
        d = Path(custom).expanduser()
        d.mkdir(parents=True, exist_ok=True)
        return d
    return MC_DIR

def cmd_install(args):
    _require_mll()
    mc_dir = _mc_dir(args)
    loader = (getattr(args, "loader", "") or "").strip().lower()
    loader_version = (getattr(args, "loader_version", "") or "").strip() or None

    if loader and loader != "vanilla":
        if loader not in LOADERS:
            die(2, f"loader must be one of vanilla/{'/'.join(LOADERS)}")
        try:
            ml = mll.mod_loader.get_mod_loader(loader)
        except ValueError:
            die(2, f"loader not supported by minecraft-launcher-lib: {loader}")
        if not ml.is_minecraft_version_supported(args.version):
            die(2, f"{loader} does not support Minecraft {args.version}")
        if not loader_version:
            try:
                loader_version = ml.get_latest_loader_version(args.version)
            except Exception as e:
                die(3, f"Could not resolve {loader} version: {e}")
        emit({"type": "progress", "stage": f"installing-{loader}-{loader_version}",
              "percent": None})
        try:
            installed_id = ml.install(args.version, str(mc_dir),
                                      loader_version=loader_version,
                                      callback=_install_callbacks())
        except Exception as e:
            die(3, f"Install failed: {e}")
        emit({"type": "done", "ok": True, "version": installed_id,
              "mc_version": args.version, "loader": loader,
              "loader_version": loader_version})
        return

    try:
        mll.install.install_minecraft_version(
            version=args.version,
            minecraft_directory=str(mc_dir),
            callback=_install_callbacks(),
        )
    except Exception as e:
        die(3, f"Install failed: {e}")

    emit({"type": "done", "ok": True, "version": args.version})


def cmd_loader_versions(args):
    _require_mll()
    loader = (args.loader or "").strip().lower()
