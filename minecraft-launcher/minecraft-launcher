ELY_SKIN_URL2 = "https://skinsystem.ely.by/skins?name={name}.png"
SKINS_CACHE = CONFIG_DIR / "skins"


def _ely_request(url: str, payload: dict):
    import urllib.request
    data = json.dumps(payload).encode()
    req = urllib.request.Request(url, data=data,
                                 headers={"User-Agent": MODRINTH_UA,
                                          "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, json.loads(resp.read().decode() or "{}")
    except Exception as e:
        die(4, f"Ely.by request failed: {e}")


def _ely_error(status: int, payload: dict) -> str:
    if isinstance(payload, dict):
        msg = payload.get("errorMessage") or payload.get("error") or ""
        cause = payload.get("cause") or ""
        detail = f"{msg} {cause}".strip()
        if detail:
            return detail
    return f"Ely.by error (HTTP {status})"


def _load_accounts():
    try:
        return json.loads(ACCOUNTS_FILE.read_text()) if ACCOUNTS_FILE.exists() else []
    except ValueError:
        return []


def _save_accounts(accounts):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    ACCOUNTS_FILE.write_text(json.dumps(accounts, indent=2))


def cmd_ely_auth(args):
    username = (args.username or "").strip()
    password = (args.password or "")
    if not username or not password:
        die(2, "username and password required")
    import uuid as _ulib
    client_token = _ulib.uuid4().hex
    status, payload = _ely_request(ELY_AUTH_URL, {
        "username": username,
        "password": password,
        "clientToken": client_token,
        "requestUser": True,
    })
    if status != 200 or not isinstance(payload, dict) or "accessToken" not in payload:
        die(4, _ely_error(status, payload))
    profile = payload.get("selectedProfile") or {}
    if "id" not in profile:
        die(4, "Ely.by account has no Minecraft profile")
    account = {
        "id": profile["id"].replace("-", ""),
        "name": profile.get("name", username),
        "access_token": payload["accessToken"],
        "client_token": payload.get("clientToken", client_token),
        "ely": True,
    }
    accounts = [a for a in _load_accounts() if a.get("id") != account["id"]] + [account]
    _save_accounts(accounts)
    emit({"type": "done", "ok": True, "account_id": account["id"],
          "username": account["name"], "ely": True})


def _find_ely(account_id: str):
    for a in _load_accounts():
        if a.get("id") == account_id and a.get("ely"):
            return a
    return None


def cmd_ely_refresh(args):
    acc = _find_ely(args.account or "")
    if not acc:
        die(4, "Ely.by account not found")
    status, payload = _ely_request(ELY_REFRESH_URL, {
        "accessToken": acc.get("access_token", ""),
        "clientToken": acc.get("client_token", ""),
        "requestUser": True,
    })
    if status != 200 or "accessToken" not in payload:
        die(4, _ely_error(status, payload))
    accounts = _load_accounts()
    for a in accounts:
        if a.get("id") == acc["id"]:
            a["access_token"] = payload["accessToken"]
            if payload.get("clientToken"):
                a["client_token"] = payload["clientToken"]
            if (payload.get("selectedProfile") or {}).get("name"):
                a["name"] = payload["selectedProfile"]["name"]
    _save_accounts(accounts)
    emit({"type": "done", "ok": True, "account_id": acc["id"],
          "username": acc["name"]})


def cmd_ely_validate(args):
    acc = _find_ely(args.account or "")
    if not acc:
