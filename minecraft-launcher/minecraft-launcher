                                    args.mc_version or "",
                                    (args.loader or "").lower(), ptype)
    if args.version_id:
        pick = next((v for v in versions if v.get("id") == args.version_id), None)
        if not pick:
            die(2, "version_id not found for this project/filters")
    else:
        pick = versions[0] if versions else None
        if not pick:
            die(3, "No matching version on Modrinth for this MC/loader")
    files = pick.get("files", [])
    primary = next((f for f in files if f.get("primary")), files[0] if files else None)
