def cmd_mod_match(args):
    """PineconeMC-style hash matching: identify local jars via Modrinth
    version_files (sha1) and write sidecars with title/icon so rows show
    real metadata instead of the launcher fallback icon."""
    import hashlib
    addon_type = (args.addon_type or "mods").strip()
    if addon_type not in ADDON_DIRS:
        die(2, f"addon_type must be one of {list(ADDON_DIRS)}")
    mc_base = _mc_dir(args)
    target_dir = mc_base / ADDON_DIRS[addon_type]
    if not target_dir.is_dir():
        emit({"type": "done", "ok": True, "matched": 0, "total": 0})
        return
    files = [p for p in sorted(target_dir.iterdir())
             if p.is_file() and not p.name.endswith((".corky.json", ".disabled"))
             and not (target_dir / (p.name + ".corky.json")).exists()]
    total = len(files)
    if not total:
        emit({"type": "done", "ok": True, "matched": 0, "total": 0})
        return
    hashes = {}
    for idx, p in enumerate(files):
        emit({"type": "progress", "stage": "hashing", "percent": round(idx * 50 / total, 1)})
        try:
            h = hashlib.sha1()
            with open(p, "rb") as f:
                for chunk in iter(lambda: f.read(1024 * 1024), b""):
                    h.update(chunk)
            hashes[h.hexdigest()] = p.name
        except OSError:
            continue
    if not hashes:
        emit({"type": "done", "ok": True, "matched": 0, "total": total})
        return
    import urllib.request
    try:
        body = json.dumps({"hashes": list(hashes.keys()), "algorithm": "sha1"}).encode()
        req = urllib.request.Request(MODRINTH_API + "/version_files", data=body,
                                     headers={"User-Agent": MODRINTH_UA,
                                              "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=60) as resp:
            found = json.loads(resp.read().decode())
    except Exception as e:
        die(3, f"Modrinth hash lookup failed: {e}")
    proj_ids = sorted({v.get("project_id", "") for v in found.values() if v.get("project_id")})
    projects = {}
    if proj_ids:
        import urllib.parse
        try:
            qs = urllib.parse.urlencode({"ids": json.dumps(proj_ids)})
            req = urllib.request.Request(MODRINTH_API + "/projects?" + qs,
                                         headers={"User-Agent": MODRINTH_UA})
            with urllib.request.urlopen(req, timeout=60) as resp:
                for pr in json.loads(resp.read().decode()):
                    projects[pr.get("id", "")] = pr
        except Exception:
            pass
    matched = 0
    for idx, (h, ver) in enumerate(found.items()):
        fname = hashes.get(h, "")
        if not fname:
            continue
        emit({"type": "progress", "stage": "matching",
              "percent": 50 + round(idx * 50 / max(1, len(found)), 1)})
        pr = projects.get(ver.get("project_id", ""), {})
        _sidecar_path(target_dir, fname).write_text(json.dumps({
            "project_id": ver.get("project_id", ""),
            "version_id": ver.get("id", ""),
            "version_number": ver.get("version_number", ""),
            "title": pr.get("title", fname),
            "slug": pr.get("slug", ""),
            "icon_url": pr.get("icon_url", ""),
            "loaders": ver.get("loaders", []),
            "game_versions": ver.get("game_versions", []),
            "addon_type": addon_type,
        }, indent=2))
        matched += 1
    emit({"type": "done", "ok": True, "matched": matched, "total": total})


