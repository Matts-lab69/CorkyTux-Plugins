def cmd_offline(args):
    name = (args.name or "").strip()
    if not name or len(name) > 16 or not re.match(r"^[A-Za-z0-9_]+$", name):
        die(2, "offline name must be 1-16 chars [A-Za-z0-9_]")
    import hashlib
    import uuid as ulib
    digest = hashlib.md5(f"OfflinePlayer:{name}".encode()).digest()
    raw = bytearray(digest)
    raw[6] = (raw[6] & 0x0F) | 0x30
    raw[8] = (raw[8] & 0x3F) | 0x80
    uid = str(ulib.UUID(bytes=bytes(raw))).replace("-", "")
    account = {"id": uid, "name": name, "access_token": "0", "offline": True}
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    accounts = json.loads(ACCOUNTS_FILE.read_text()) if ACCOUNTS_FILE.exists() else []
    accounts = [a for a in accounts if a["id"] != account["id"]] + [account]
    ACCOUNTS_FILE.write_text(json.dumps(accounts, indent=2))
    emit({"type": "done", "ok": True, "account_id": uid, "username": name,
          "offline": True})


