def _mc_parts(mc_version: str):
    m = re.match(r"(\d+)\.(\d+)(?:\.(\d+))?", (mc_version or "").strip())
    if not m:
        return None
    return int(m.group(1)), int(m.group(2)), int(m.group(3) or 0)


def _mc_of_version_id(version_id: str) -> str:
    vid = (version_id or "").strip()
    m = re.match(r"(\d+\.\d+(?:\.\d+)?)-", vid)
    if m:
        return m.group(1)
    m = re.search(r"-(\d+\.\d+(?:\.\d+)?)$", vid)
    if m:
        return m.group(1)
    return vid


def manifest_java_required(mc_dir: Path, version_id: str):
    """Read javaVersion.majorVersion following inheritsFrom (PineconeMC-style:
    the version json, not a heuristic, decides the JVM)."""
    seen = set()
    cur = version_id
    for _ in range(4):
        if not cur or cur in seen:
            break
        seen.add(cur)
        jf = mc_dir / "versions" / cur / f"{cur}.json"
        try:
            doc = json.loads(jf.read_text())
        except (OSError, ValueError):
            break
        jv = doc.get("javaVersion") or {}
        if isinstance(jv.get("majorVersion"), int):
            return jv["majorVersion"]
        nxt = doc.get("inheritsFrom") or ""
        cur = nxt if nxt != version_id else ""
    return None


def required_java_major(mc_version: str) -> int:
    parts = _mc_parts(mc_version)
    if not parts:
        return 21
    major, minor, _patch = parts
    if major != 1:
        return 21
    if minor < 17:
        return 8
    if minor <= 20:
        return 17
    return 21


def max_java_major(mc_version: str) -> int:
    parts = _mc_parts(mc_version)
    if not parts:
        return 99
    major, minor, _patch = parts
    if major == 1 and minor <= 16:
        return 17
    return 99


def _java_major_of(version_str: str) -> int:
    s = (version_str or "").strip()
    m = re.match(r"1\.(\d+)", s)
    if m:
        try:
            return int(m.group(1))
        except ValueError:
            return 0
    m = re.match(r"(\d+)", s)
    try:
        return int(m.group(1)) if m else 0
    except ValueError:
        return 0

