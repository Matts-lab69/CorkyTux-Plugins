def _patch_requests_timeouts(default=120):
    """mll petitions without timeout: a stalled connection hangs the worker
    forever (30min+ silent installs). Inject a generous default instead."""
    try:
        import requests
        _orig = requests.Session.request

        def _wrapped(self, method, url, **kwargs):
            kwargs.setdefault("timeout", default)
            return _orig(self, method, url, **kwargs)

        requests.Session.request = _wrapped
    except Exception:
        pass


