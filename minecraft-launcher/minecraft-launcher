def _cf_pack_manifest(pack_id: str, file_id: str):
    """Download a CurseForge modpack file and return (manifest, extract_dir, tmpdir)."""
    import tempfile
    import zipfile
    files = _cf_get(f"/mods/{pack_id}/files", {"pageSize": 50}).get("data", [])
    if file_id:
        pick = next((f for f in files if str(f.get("id", "")) == file_id), None)
        if not pick:
            die(2, "file_id not found for this modpack")
    else:
        pick = next((f for f in files if f.get("downloadUrl")), None)
        if not pick:
            die(3, "No downloadable file for this modpack on CurseForge")
    url = pick.get("downloadUrl", "")
    if not url:
        die(3, "CurseForge pack file has no download URL")
    tmp = Path(tempfile.mkdtemp(prefix="cfpack-"))
    zpath = tmp / "pack.zip"
    emit({"type": "progress", "stage": "downloading-modpack", "percent": 0})
    _download_with_progress(url, zpath, "downloading-modpack")
    dest = tmp / "unzipped"
    dest.mkdir(parents=True, exist_ok=True)
    try:
        with zipfile.ZipFile(zpath) as z:
            z.extractall(dest)
    except Exception as e:
        die(3, f"Invalid modpack zip: {e}")
    manifest_path = dest / "manifest.json"
    if not manifest_path.is_file():
        die(3, "Modpack zip has no manifest.json")
    try:
        manifest = json.loads(manifest_path.read_text())
    except ValueError:
        die(3, "Modpack manifest.json is corrupt")
    return manifest, dest, tmp


def _cf_pack_loader(manifest: dict):
    """(loader, loader_version, mc_version) from a CF manifest."""
    mc = (((manifest.get("minecraft") or {}).get("version")) or "").strip()
    loaders = ((manifest.get("minecraft") or {}).get("modLoaders") or [])
    primary = next((l for l in loaders if l.get("primary")), loaders[0] if loaders else None)
    raw = str((primary or {}).get("id", "") or "").strip().lower()
    loader, lver = "", ""
    for name in ("neoforge", "forge", "fabric", "quilt"):
        if raw == name or raw.startswith(name + "-"):
            loader = name
            lver = raw[len(name) + 1:] if raw.startswith(name + "-") else ""
            break
    return loader, lver, mc


def cmd_cf_modpack_install(args):
    _require_mll()
    import shutil as _sh
    dest_base = Path((args.mc_dir or "").strip() or str(MC_DIR)).expanduser()
    dest_base.mkdir(parents=True, exist_ok=True)
    manifest, extracted, tmp = _cf_pack_manifest(args.pack_id, args.file_id or "")
    try:
        loader, lver, mc = _cf_pack_loader(manifest)
        title = str(manifest.get("name", "") or "CurseForge pack")
        if not mc:
            die(3, "Modpack manifest has no Minecraft version")
        if loader and loader != "vanilla":
            try:
                ml = mll.mod_loader.get_mod_loader(loader)
            except ValueError:
                die(2, f"loader not supported: {loader}")
            if not lver:
                try:
                    lver = ml.get_latest_loader_version(mc)
                except Exception as e:
                    die(3, f"Could not resolve {loader} version: {e}")
            emit({"type": "progress", "stage": f"installing-{loader}-{lver}",
                  "percent": None})
            try:
                installed_id = ml.install(mc, str(dest_base),
                                          loader_version=lver,
                                          callback=_install_callbacks())
            except Exception as e:
                die(3, f"Base install failed: {e}")
        else:
            try:
                mll.install.install_minecraft_version(
                    version=mc,
                    minecraft_directory=str(dest_base),
                    callback=_install_callbacks(),
                )
            except Exception as e:
                die(3, f"Base install failed: {e}")
            installed_id = mc
            lver = ""
        entries = [f for f in manifest.get("files", []) or []
                   if f.get("required", True)]
        mods_dir = dest_base / "mods"
        mods_dir.mkdir(parents=True, exist_ok=True)
        total = len(entries)
        for i, entry in enumerate(entries):
            pid, fid = entry.get("projectID"), entry.get("fileID")
            try:
                info = _cf_get(f"/mods/{pid}/files/{fid}")
                fdata = info.get("data", {})
                url = fdata.get("downloadUrl", "")
                fname = fdata.get("fileName", "")
                if not url or not fname:
                    continue
                dest = mods_dir / fname
                if not dest.exists():
                    emit({"type": "progress",
                          "stage": f"mods-{i + 1}/{total}-{fname}",
                          "percent": round((i / max(1, total)) * 100, 1)})
                    _download_with_progress(url, dest, f"mods-{i + 1}/{total}")
            except Exception:
                continue
        over = str(manifest.get("overrides", "") or "overrides").lstrip("/")
        over_dir = extracted / over
        if over_dir.is_dir():
            for item in over_dir.iterdir():
                tgt = dest_base / item.name
                try:
                    if tgt.exists():
                        if tgt.is_dir():
                            _sh.rmtree(tgt, ignore_errors=True)
                        else:
                            tgt.unlink(missing_ok=True)
                    if item.is_dir():
                        _sh.copytree(item, tgt)
                    else:
                        _sh.copy2(item, tgt)
                except OSError:
                    continue
    finally:
        _sh.rmtree(tmp, ignore_errors=True)
    emit({"type": "done", "ok": True, "version": installed_id,
          "title": title, "mc_version": mc,
          "pack_id": args.pack_id})


