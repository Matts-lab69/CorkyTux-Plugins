def cmd_ely_skin(args):
    # Skin resolution per account type (Ely.by docs + Mojang API):
    # - Ely.by nicknames: skinsystem.ely.by first (local wardrobe database).
    # - Microsoft (premium UUID): Mojang session profile by UUID, no auth needed.
    # - Offline: skinsystem proxy by name (finds premium namesakes), else 204.
    # Changing skins has no public API anywhere: Ely -> ely.by wardrobe,
    # Microsoft -> PUT minecraftservices (needs valid MS token) or minecraft.net.
    name = (args.name or "").strip()
    uuid = (getattr(args, "uuid", "") or "").strip().replace("-", "")
    if not name:
        die(2, "name required")
    SKINS_CACHE.mkdir(parents=True, exist_ok=True)
    full = SKINS_CACHE / f"{name}.png"
    head = SKINS_CACHE / f"{name}-head.png"
    model_file = SKINS_CACHE / f"{name}.model"
    if not args.refresh and full.is_file() and head.is_file():
        try:
            cached_model = model_file.read_text().strip() or "classic"
        except OSError:
            cached_model = "classic"
        emit({"type": "done", "ok": True, "name": name,
              "skin": str(full), "head": str(head), "cached": True,
              "model": cached_model})
        return
    import base64
    import urllib.request

    def _get(url):
        req = urllib.request.Request(url, headers={"User-Agent": MODRINTH_UA})
        with urllib.request.urlopen(req, timeout=30) as resp:
            if resp.status == 200:
                return resp.read()
        return None

    def _mojang_skin(username):
        try:
            raw = _get(f"https://api.mojang.com/users/profiles/minecraft/{username}")
            uid = json.loads(raw.decode()).get("id", "")
            if not uid:
                return None
            raw = _get(f"https://sessionserver.mojang.com/session/minecraft/profile/{uid}")
            for prop in json.loads(raw.decode()).get("properties", []):
                if prop.get("name") == "textures":
                    tex = json.loads(base64.b64decode(prop.get("value", "")))
                    url = ((tex.get("textures") or {}).get("SKIN") or {}).get("url", "")
                    if url:
                        return _get(url)
        except Exception:
            return None
        return None

    def _mojang_by_uuid(uid):
        try:
            raw = _get(f"https://sessionserver.mojang.com/session/minecraft/profile/{uid}")
            for prop in json.loads(raw.decode()).get("properties", []):
                if prop.get("name") == "textures":
                    tex = json.loads(base64.b64decode(prop.get("value", "")))
                    skin = ((tex.get("textures") or {}).get("SKIN")) or {}
                    if skin.get("url"):
                        return _get(skin["url"]), skin.get("metadata", {}).get("model", "")
        except Exception:
            return None, ""
        return None, ""

    data, model = None, ""
    if uuid and not (len(uuid) == 32 and set(uuid) == set("0")):
        try:
            data, model = _mojang_by_uuid(uuid)
        except Exception:
            data, model = None, ""
    if not data:
        for tmpl in (ELY_SKIN_URL, ELY_SKIN_URL2):
            try:
                data = _get(tmpl.format(name=name))
                if data:
                    break
            except Exception:
                continue
    if not data:
        data = _mojang_skin(name)
        model = ""
    if not data:
        die(3, f"No skin found for {name} (Ely.by + Mojang empty)")
    try:
        full.write_bytes(data)
        try:
            from PIL import Image
            im = Image.open(full).convert("RGBA")
            w, h = im.size
            # classic 64x64 (or 64x32 legacy): face + overlay
            sx, sy = (w // 64, h // 64) if w >= 64 and h >= 32 else (1, 1)
            face = Image.new("RGBA", (8 * sx, 8 * sy), (0, 0, 0, 0))
            face.alpha_composite(im.crop((8 * sx, 8 * sy, 16 * sx, 16 * sy)))
            if w >= 64 and h >= 64:
                face.alpha_composite(im.crop((40 * sx, 8 * sy, 48 * sx, 16 * sy)))
            face = face.resize((96, 96), Image.NEAREST)
            face.save(head)
        except Exception:
            if head.exists():
                head.unlink(missing_ok=True)
    except OSError as e:
        die(3, f"Cannot save skin: {e}")
    try:
        (SKINS_CACHE / f"{name}.model").write_text(model or "classic")
    except OSError:
        pass
    emit({"type": "done", "ok": True, "name": name,
          "skin": str(full), "head": str(head), "cached": False,
          "model": model or "classic"})


