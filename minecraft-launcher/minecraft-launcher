def _download_with_progress(url: str, dest: Path, stage: str):
    import urllib.request
    req = urllib.request.Request(url, headers={"User-Agent": MODRINTH_UA})
    downloaded = 0
    total = 0
    try:
        with urllib.request.urlopen(req, timeout=120) as resp, open(dest, "wb") as f:
            try:
                total = int(resp.headers.get("Content-Length", 0))
            except (TypeError, ValueError):
                total = 0
            while True:
                chunk = resp.read(1024 * 256)
                if not chunk:
                    break
                f.write(chunk)
                downloaded += len(chunk)
                pct = round(downloaded * 100 / total, 1) if total else None
                emit({"type": "progress", "stage": stage, "percent": pct})
    except Exception as e:
        if dest.exists():
            dest.unlink(missing_ok=True)
        die(3, f"Download failed: {e}")
    if dest.stat().st_size < 1024:
        dest.unlink(missing_ok=True)
        die(3, "Downloaded file too small, aborting")


