            ordered.append((str(jb), "opt-dir"))
    try:
        alt = subprocess_run(["update-alternatives", "--list", "java"], timeout=10)
        for line in ((alt.stdout or "").splitlines()):
            p = line.strip()
            if p and p not in seen:
                seen.add(p)
                ordered.append((p, "alternatives"))
    except Exception:
        pass
    for jb in sorted((Path.home() / ".minecraft" / "runtime").rglob("bin/java")):
        if str(jb) not in seen:
            seen.add(str(jb))
            ordered.append((str(jb), "mojang-runtime"))
