def _scan_addon_dir(addon_type: str, mc_dir=None):
    base = mc_dir or MC_DIR
    target_dir = base / ADDON_DIRS[addon_type]
    target_dir.mkdir(parents=True, exist_ok=True)
    items = []
    for p in sorted(target_dir.iterdir()):
        if not p.is_file() or p.suffix == ".json":
            continue
        name = p.name
        enabled = True
        if name.endswith(".jar.disabled") or name.endswith(".disabled"):
            enabled = False
        if p.suffix.lower() not in (".jar", ".zip", ".disabled"):
            if addon_type == "mods" and not name.endswith((".jar", ".jar.disabled")):
                continue
        meta = {}
        sc = target_dir / (name + ".corky.json")
        if sc.is_file():
            try:
                meta = json.loads(sc.read_text())
            except ValueError:
                meta = {}
        items.append({
            "file": name, "enabled": enabled, "size": p.stat().st_size,
            "title": meta.get("title", name),
            "version_number": meta.get("version_number", ""),
            "version_id": meta.get("version_id", ""),
            "project_id": meta.get("project_id", ""),
            "icon_url": meta.get("icon_url", ""),
            "platform": "modrinth" if meta.get("project_id") else "local",
        })
    return target_dir, items


def cmd_addons_list(args):
    addon_type = (args.addon_type or "mods").strip()
    if addon_type not in ADDON_DIRS:
        die(2, f"addon_type must be one of {list(ADDON_DIRS)}")
    target_dir, items = _scan_addon_dir(addon_type, _mc_dir(args))
    emit({"type": "done", "ok": True, "addons": items,
          "addon_type": addon_type, "dir": str(target_dir)})


def cmd_mod_check_updates(args):
    addon_type = (args.addon_type or "mods").strip()
    if addon_type not in ADDON_DIRS:
        die(2, f"addon_type must be one of {list(ADDON_DIRS)}")
    _, items = _scan_addon_dir(addon_type, _mc_dir(args))
    updates = []
    ptype = _ptype_of_addon(addon_type)
    for it in items:
        pid = it.get("project_id", "")
        if not pid:
            continue
        try:
            versions = _mr_project_versions(pid, args.mc_version or "",
                                            (args.loader or "").lower(), ptype)
        except SystemExit:
            raise
        except Exception:
            continue
        if not versions:
            continue
        latest = versions[0]
        if latest.get("id") != it.get("version_id"):
            updates.append({
                "file": it["file"], "title": it["title"],
                "current": it.get("version_number", ""),
                "latest": latest.get("version_number", ""),
                "version_id": latest.get("id"),
                "project_id": pid,
            })
    emit({"type": "done", "ok": True, "updates": updates,
          "addon_type": addon_type})


def cmd_mod_update(args):
    addon_type = (args.addon_type or "mods").strip()
    if addon_type not in ADDON_DIRS:
        die(2, f"addon_type must be one of {list(ADDON_DIRS)}")
    mc_base = _mc_dir(args)
    target_dir = mc_base / ADDON_DIRS[addon_type]
    sc = target_dir / (args.file + ".corky.json")
    if not sc.is_file():
        die(2, "No Modrinth metadata for this file (local addon?)")
    try:
        meta = json.loads(sc.read_text())
    except ValueError:
        die(2, "Corrupt metadata sidecar")
    ptype = _ptype_of_addon(addon_type)
    versions = _mr_project_versions(meta["project_id"], args.mc_version or "",
                                    (args.loader or "").lower(), ptype)
    if not versions:
        die(3, "No versions found on Modrinth")
    latest = versions[0]
    if latest.get("id") == meta.get("version_id") and not args.force:
        emit({"type": "done", "ok": True, "file": args.file,
              "updated": False})
        return
    files = latest.get("files", [])
    primary = next((f for f in files if f.get("primary")), files[0] if files else None)
    if not primary:
        die(3, "Version has no files")
    dest = target_dir / primary["filename"]
    emit({"type": "progress", "stage": f"updating-{primary['filename']}",
          "percent": 0})
    _download_with_progress(primary["url"], dest, "downloading")
    old = target_dir / args.file
    if dest != old and old.is_file():
        old.unlink(missing_ok=True)
        sc.unlink(missing_ok=True)
    _sidecar_path(target_dir, dest.name).write_text(json.dumps({
        **meta, "version_id": latest.get("id"),
        "version_number": latest.get("version_number"),
        "loaders": latest.get("loaders", []),
        "game_versions": latest.get("game_versions", []),
    }, indent=2))
    emit({"type": "done", "ok": True, "file": dest.name,
          "updated": True,
          "version_number": latest.get("version_number")})


def _download_mrpack_file(project_id: str, version_id: str, dest_dir: Path):
    versions = _mr_project_versions(project_id, "", "", "modpack")
    if version_id:
        pick = next((v for v in versions if v.get("id") == version_id), None)
        if not pick:
            die(2, "version_id not found for this modpack")
    else:
        pick = versions[0] if versions else None
        if not pick:
            die(3, "Modpack has no versions on Modrinth")
    files = pick.get("files", [])
    mr = next((f for f in files if (f.get("filename") or "").endswith(".mrpack")),
              files[0] if files else None)
    if not mr:
        die(3, "Version has no files")
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / mr["filename"]
    emit({"type": "progress", "stage": f"downloading-{mr['filename']}", "percent": 0})
    _download_with_progress(mr["url"], dest, "downloading")
    return dest, pick


def _install_mrpack_file(mrpack_path: Path, mc_dir: Path, name_hint: str):
    _require_mll()
    mc_dir.mkdir(parents=True, exist_ok=True)
    try:
        info = mll.mrpack.get_mrpack_information(str(mrpack_path))
    except Exception:
        info = {}
    title = info.get("name", "") or name_hint
    try:
        mll.mrpack.install_mrpack(str(mrpack_path), str(mc_dir),
                                  callback=_install_callbacks())
    except Exception as e:
        die(3, f"Modpack install failed: {e}")
    try:
        launch_version = mll.mrpack.get_mrpack_launch_version(str(mrpack_path))
    except Exception:
        launch_version = ""
    if not launch_version:
        installed = mll.utils.get_installed_versions(str(mc_dir))
        launch_version = installed[-1]["id"] if installed else ""
    return launch_version, title


def cmd_modpack_install(args):
    dest_base = Path((args.mc_dir or "").strip() or str(MC_DIR)).expanduser()
    tmp = dest_base.parent / (dest_base.name + ".downloading")
    try:
        mrpack_path, pick = _download_mrpack_file(args.project_id,
                                                  args.version_id or "", tmp)
        launch_version, title = _install_mrpack_file(
            mrpack_path, dest_base,
            pick.get("name", "") if isinstance(pick, dict) else "")
    finally:
        import shutil as _sh
        _sh.rmtree(tmp, ignore_errors=True)
    emit({"type": "done", "ok": True, "version": launch_version,
          "title": title, "mc_version": "",
          "project_id": args.project_id})


def cmd_modpack_import(args):
    src = Path(args.path).expanduser()
    if not (src.is_file() and src.suffix.lower() in (".mrpack", ".zip")):
        die(2, f"not a modpack file: {src}")
    dest_base = Path((args.mc_dir or "").strip() or str(MC_DIR)).expanduser()
    launch_version, title = _install_mrpack_file(src, dest_base, src.stem)
    emit({"type": "done", "ok": True, "version": launch_version,
          "title": title, "mc_version": ""})


