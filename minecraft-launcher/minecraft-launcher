def cmd_stop(args):
    import signal as _sig
    target = (args.account or "").strip()
    accounts = []
    if ACCOUNTS_FILE.exists():
        try:
            accounts = json.loads(ACCOUNTS_FILE.read_text())
        except ValueError:
            accounts = []
    ids = [a["id"] for a in accounts
           if not target or a["id"] == target or a.get("name") == target]
    if target and not ids:
        ids = [target]
    if not ids:
        die(2, "no accounts to stop")
    stopped, alive = [], []
    for aid in ids:
        lp = _account_lock_path(aid)
        if not lp.exists():
            continue
        try:
            pid = int(lp.read_text().strip())
        except (ValueError, OSError):
            lp.unlink(missing_ok=True)
            continue
        try:
            os.kill(pid, _sig.SIGTERM)
            stopped.append({"account": aid, "pid": pid})
        except OSError:
            try:
                os.kill(pid, 0)
                alive.append({"account": aid, "pid": pid})
            except OSError:
                lp.unlink(missing_ok=True)
    emit({"type": "done", "ok": True, "stopped": stopped,
          "still_running": alive})


