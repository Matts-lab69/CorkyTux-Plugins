def _deps_state():
    return {
        "minecraft_launcher_lib": mll is not None,
        "psutil": psutil is not None,
        "requests": True,
    }


def _java_version_of(path: str):
    # Cached per binary (mtime+size): spawning 11 JVMs on every detect
    # costs ~1s + process churn; binaries almost never change version.
    try:
        st = os.stat(os.path.realpath(path))
        sig = f"{st.st_mtime_ns}:{st.st_size}"
    except OSError:
        return ""
    try:
        cached = (_read_java_json().get("versions") or {}).get(path)
        if isinstance(cached, dict) and cached.get("sig") == sig and cached.get("version"):
            return cached["version"]
    except Exception:
        pass
    try:
        proc = subprocess_run([path, "-version"], timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    out = (proc.stderr or "") + (proc.stdout or "")
    m = re.search(r'version "([^"]+)"', out)
    if m:
        ver = m.group(1)
    else:
        m = re.search(r"(\d[\d._]+)", out)
        ver = m.group(1) if m else ""
    if ver:
        try:
            state = _read_java_json()
            vers = state.get("versions")
            if not isinstance(vers, dict):
                vers = {}
            vers[path] = {"sig": sig, "version": ver}
            for k in [k for k in vers if not Path(k).exists()]:
                del vers[k]
            state["versions"] = vers
            _write_java_json(state)
        except Exception:
            pass
    return ver


def subprocess_run(cmd, timeout):
    import subprocess as sp
    return sp.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                  timeout=timeout)


def _read_java_json():
    try:
        return json.loads(JAVA_JSON.read_text())
    except (OSError, ValueError):
        return {}


def _write_java_json(data: dict):
    JAVA_DIR.mkdir(parents=True, exist_ok=True)
    JAVA_JSON.write_text(json.dumps(data, indent=2))


def _iter_java_candidates():
    import shutil as _sh
    seen = set()
    ordered = []
    for cand in ["/usr/bin/java", "/usr/local/bin/java"]:
        if cand not in seen:
            seen.add(cand)
            ordered.append((cand, "system"))
    jh = os.environ.get("JAVA_HOME", "")
    if jh:
        p = str(Path(jh) / "bin" / "java")
        if p not in seen:
            seen.add(p)
