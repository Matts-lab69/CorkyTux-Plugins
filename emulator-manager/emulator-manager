def load_linked():
    """Load linked emulators from JSON file."""
    if os.path.exists(LINKED_FILE):
        try:
            with open(LINKED_FILE, "r") as f:
                return json.load(f)
        except Exception:
            pass
    return {}


def save_linked(data):
    """Save linked emulators to JSON file."""
    with open(LINKED_FILE, "w") as f:
        json.dump(data, f, indent=2)


def get_arch():
    """Detect system architecture for AppImage filtering."""
    import platform
    machine = platform.machine().lower()
    if machine in ("x86_64", "amd64"):
        return "x86_64"
    elif machine in ("aarch64", "arm64"):
        return "aarch64"
    return machine


def is_installed(name):
    """Check if emulator is installed (AppImage or linked)."""
    # Check linked first
    linked = load_linked()
    if name in linked:
        path = linked[name].get("path", "")
        return os.path.isfile(path) and os.access(path, os.X_OK)
    # Check AppImage
    path = os.path.join(EMULATORS_DIR, name + ".AppImage")
    return os.path.isfile(path) and os.access(path, os.X_OK)


def get_path(name):
    """Get emulator path (linked or AppImage)."""
    # Check linked first
    linked = load_linked()
    if name in linked:
        path = linked[name].get("path", "")
        if os.path.isfile(path):
            return path
    # Check AppImage
    path = os.path.join(EMULATORS_DIR, name + ".AppImage")
    if os.path.isfile(path):
        return path
    return ""


def get_launch_args(name):
    """Get launch args for an emulator (linked or AppImage)."""
    # Check linked
    linked = load_linked()
    if name in linked:
        return linked[name].get("launch_args", "{rom}")
    # Check built-in
    info = EMULATORS.get(name, {})
    return info.get("launch_args", "{rom}")


def list_emulators():
    """List all emulators with status (AppImage or linked)."""
    linked = load_linked()
    result = []
    for name, info in EMULATORS.items():
        is_link = name in linked
        result.append({
            "name": name,
            "description": info["description"],
            "extensions": info["extensions"],
            "installed": is_installed(name),
            "path": get_path(name),
            "launch_args": get_launch_args(name),
            "linked": is_link,
            "settings": info.get("settings", []),
        })
    # Add linked emulators not in EMULATORS list (custom/unknown)
    for name, data in linked.items():
        if name not in EMULATORS:
            result.append({
                "name": name,
                "description": data.get("description", "Custom emulator"),
                "extensions": data.get("extensions", []),
                "installed": True,
                "path": data.get("path", ""),
                "launch_args": data.get("launch_args", "{rom}"),
                "linked": True,
            })
    return result


def link_emulator(name, path, launch_args=None, description=None, extensions=None):
    """Link an existing emulator executable."""
    if not os.path.isfile(path):
        return {"ok": False, "message": "File not found: " + path}
    if not os.access(path, os.X_OK):
        return {"ok": False, "message": "File not executable: " + path}
    linked = load_linked()
    info = {
        "path": os.path.abspath(path),
    }
    if launch_args:
        info["launch_args"] = launch_args
    elif name in EMULATORS:
        info["launch_args"] = EMULATORS[name].get("launch_args", "{rom}")
    else:
        info["launch_args"] = "{rom}"
    if description:
        info["description"] = description
    elif name in EMULATORS:
        info["description"] = EMULATORS[name].get("description", "")
    else:
        info["description"] = "Custom emulator"
    if extensions:
        info["extensions"] = extensions
    elif name in EMULATORS:
        info["extensions"] = EMULATORS[name].get("extensions", [])
    else:
        info["extensions"] = []
    linked[name] = info
    save_linked(linked)
    return {"ok": True, "message": name + " linked to " + path}


def unlink_emulator(name):
    """Remove a linked emulator (does not delete the file)."""
    linked = load_linked()
    if name in linked:
        del linked[name]
        save_linked(linked)
        return {"ok": True, "message": name + " unlinked"}
    return {"ok": False, "message": name + " not linked"}


def find_download_url(name):
    """Find the latest AppImage download URL from GitHub."""
    info = EMULATORS.get(name)
    if not info:
        return None, "Unknown emulator: " + name
    github = info["github"]
    pattern = info["asset_pattern"]
    arch = get_arch()
    api_url = "https://api.github.com/repos/{}/releases/latest".format(github)
    try:
        req = urllib.request.Request(api_url)
        req.add_header("User-Agent", "CorkyTux/2.10")
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
            for asset in data.get("assets", []):
                aname = asset.get("name", "")
                if (aname.endswith(".AppImage")
                        and pattern.lower() in aname.lower()
                        and not aname.endswith(".zsync")):
                    if arch == "x86_64" and "aarch64" in aname.lower():
                        continue
                    if arch == "aarch64" and "x86_64" in aname.lower():
                        continue
                    return asset["browser_download_url"], None
            for asset in data.get("assets", []):
                aname = asset.get("name", "")
                if aname.endswith(".AppImage") and not aname.endswith(".zsync"):
                    if arch == "x86_64" and "aarch64" in aname.lower():
                        continue
                    if arch == "aarch64" and "x86_64" in aname.lower():
                        continue
                    return asset["browser_download_url"], None
        return None, "No {} AppImage found in latest release of {}".format(arch, github)
    except urllib.error.HTTPError as e:
        return None, "GitHub API error ({}): {}".format(e.code, github)
    except Exception as e:
        return None, "Failed to fetch release info: " + str(e)


def install_emulator(name):
    """Download and install an emulator AppImage."""
    if is_installed(name):
        return {"ok": True, "message": name + " already installed"}
    url, err = find_download_url(name)
    if err:
        return {"ok": False, "message": err}
    os.makedirs(EMULATORS_DIR, exist_ok=True)
    dest = os.path.join(EMULATORS_DIR, name + ".AppImage")
    try:
        req = urllib.request.Request(url)
        req.add_header("User-Agent", "CorkyTux/2.10")
        with urllib.request.urlopen(req, timeout=300) as resp:
            with open(dest, "wb") as f:
                while True:
                    chunk = resp.read(65536)
                    if not chunk:
                        break
                    f.write(chunk)
        os.chmod(dest, os.stat(dest).st_mode | stat.S_IEXEC | stat.S_IXGRP | stat.S_IXOTH)
        return {"ok": True, "message": name + " installed to " + dest}
    except Exception as e:
        if os.path.exists(dest):
            os.remove(dest)
        return {"ok": False, "message": "Download failed: " + str(e)}


def remove_emulator(name):
    """Remove an AppImage (does not affect linked emulators)."""
    path = os.path.join(EMULATORS_DIR, name + ".AppImage")
    if os.path.exists(path):
        os.remove(path)
        return {"ok": True, "message": name + " removed"}
    return {"ok": False, "message": name + " not found"}


def remove_all_emulators():
    """Remove all AppImage emulators."""
    count = 0
    if os.path.isdir(EMULATORS_DIR):
        for f in os.listdir(EMULATORS_DIR):
            if f.endswith(".AppImage"):
                os.remove(os.path.join(EMULATORS_DIR, f))
                count += 1
    return {"ok": True, "message": "Removed {} emulators".format(count)}


def register_game(emulator_name, game_dir):
    """Register a game directory with the emulator so it appears in its game list."""
    home = os.path.expanduser("~")

    if emulator_name == "Dolphin":
        config_dir = os.path.join(home, ".config", "dolphin-emu", "Config")
        config_file = os.path.join(config_dir, "Dolphin.ini")
        os.makedirs(config_dir, exist_ok=True)

        lines = []
        iso_paths = {}
        iso_count = 0
        if os.path.exists(config_file):
            with open(config_file, "r") as f:
                lines = f.readlines()
            for line in lines:
                line = line.strip()
                if line.startswith("ISOPath") and "=" in line:
                    key, val = line.split("=", 1)
                    iso_paths[key.strip()] = val.strip()
                if line.startswith("ISOPaths"):
                    try:
                        iso_count = int(line.split("=", 1)[1].strip())
                    except ValueError:
                        pass

        for key, val in iso_paths.items():
            if val == game_dir:
                return {"ok": True, "message": "Game directory already registered in Dolphin"}

        next_idx = 0
        while "ISOPath{}".format(next_idx) in iso_paths:
            next_idx += 1

        new_line = "ISOPath{} = {}\n".format(next_idx, game_dir)

        if iso_count > 0 or iso_paths:
            new_lines = []
            updated = False
            for line in lines:
                if line.strip().startswith("ISOPaths"):
                    new_count = max(iso_count, next_idx + 1)
                    new_lines.append("ISOPaths = {}\n".format(new_count))
                    updated = True
                elif line.strip().startswith("ISOPath") and "=" in line:
                    new_lines.append(line)
                else:
                    new_lines.append(line)
            if not updated:
                insert_idx = len(new_lines)
                for i, line in enumerate(new_lines):
                    if line.strip().startswith("ISOPath") and "=" in line:
                        insert_idx = i + 1
                new_lines.insert(insert_idx, new_line)
            else:
                new_lines.append(new_line)
            with open(config_file, "w") as f:
                f.writelines(new_lines)
        else:
            with open(config_file, "a") as f:
                f.write("\n[General]\n")
                f.write("ISOPaths = 1\n")
                f.write(new_line)

        return {"ok": True, "message": "Game directory added to Dolphin: " + game_dir}

    elif emulator_name == "melonDS":
        config_dir = os.path.join(home, ".config", "melonDS")
        os.makedirs(config_dir, exist_ok=True)
        return {"ok": True, "message": "melonDS game registered"}

    elif emulator_name == "PCSX2":
        config_dir = os.path.join(home, ".config", "PCSX2", "inis")
        os.makedirs(config_dir, exist_ok=True)
        return {"ok": True, "message": "PCSX2 game registered"}

    elif emulator_name == "DuckStation":
        config_dir = os.path.join(home, ".local", "share", "duckstation")
        os.makedirs(config_dir, exist_ok=True)
        return {"ok": True, "message": "DuckStation game registered"}

    elif emulator_name == "Cemu":
        config_dir = os.path.join(home, ".local", "share", "Cemu")
        os.makedirs(config_dir, exist_ok=True)
        return {"ok": True, "message": "Cemu game registered"}

    else:
        return {"ok": True, "message": emulator_name + " game registered (no config update needed)"}


def main():
    if len(sys.argv) < 2:
        print(json.dumps({"ok": False, "message": "Usage: emulator-manager <corky-command>"}))
        sys.exit(2)

    cmd = sys.argv[1]

    # Strip corky- prefix if present
    if cmd.startswith("corky-"):
        cmd = cmd[6:]

    if cmd == "list":
        print(json.dumps({"ok": True, "emulators": list_emulators()}))

    elif cmd == "installed":
        emus = [e for e in list_emulators() if e["installed"]]
        print(json.dumps({"ok": True, "emulators": emus}))

    elif cmd == "linked":
        emus = [e for e in list_emulators() if e.get("linked")]
        print(json.dumps({"ok": True, "emulators": emus}))

    elif cmd == "install":
        if len(sys.argv) < 3:
            print(json.dumps({"ok": False, "message": "Usage: emulator-manager corky-install <name>"}))
            sys.exit(2)
        name = sys.argv[2]
        if name not in EMULATORS:
            print(json.dumps({"ok": False, "message": "Unknown emulator: " + name}))
            sys.exit(2)
        result = install_emulator(name)
        print(json.dumps(result))
        sys.exit(0 if result["ok"] else 3)

    elif cmd == "remove":
        if len(sys.argv) < 3:
            print(json.dumps({"ok": False, "message": "Usage: emulator-manager corky-remove <name>"}))
            sys.exit(2)
        name = sys.argv[2]
        if name == "__all__":
            result = remove_all_emulators()
        elif name in EMULATORS:
            result = remove_emulator(name)
        else:
            result = {"ok": False, "message": "Unknown emulator: " + name}
        print(json.dumps(result))
        sys.exit(0 if result["ok"] else 3)

    elif cmd == "link":
        if len(sys.argv) < 4:
            print(json.dumps({"ok": False, "message": "Usage: emulator-manager corky-link <name> <path>"}))
            sys.exit(2)
        name = sys.argv[2]
        path = sys.argv[3]
        launch_args = sys.argv[4] if len(sys.argv) > 4 else None
        result = link_emulator(name, path, launch_args)
        print(json.dumps(result))
        sys.exit(0 if result["ok"] else 3)

    elif cmd == "unlink":
        if len(sys.argv) < 3:
            print(json.dumps({"ok": False, "message": "Usage: emulator-manager corky-unlink <name>"}))
            sys.exit(2)
        name = sys.argv[2]
        result = unlink_emulator(name)
        print(json.dumps(result))
        sys.exit(0 if result["ok"] else 3)

    elif cmd == "register-game":
        if len(sys.argv) < 4:
            print(json.dumps({"ok": False, "message": "Usage: emulator-manager corky-register-game <emulator> <game_dir>"}))
            sys.exit(2)
        emulator_name = sys.argv[2]
        game_dir = sys.argv[3]
        result = register_game(emulator_name, game_dir)
        print(json.dumps(result))
        sys.exit(0 if result["ok"] else 3)

    else:
        print(json.dumps({"ok": False, "message": "Unknown command: " + cmd}))
        sys.exit(2)


if __name__ == "__main__":
    main()
