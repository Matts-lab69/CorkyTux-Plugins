#!/usr/bin/env python3
"""Emulator Manager plugin for CorkyTux.
Manages retro emulator AppImages.

Commands:
  list                  - List all known emulators with install status
  install <name>        - Download and install an emulator AppImage
  remove <name>         - Remove an installed emulator AppImage
  installed             - List only installed emulators
"""

