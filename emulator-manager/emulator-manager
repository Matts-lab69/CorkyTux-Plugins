#!/usr/bin/env python3
"""Emulator Manager plugin for CorkyTux.
Manages retro emulator AppImages and links to existing installs.

All commands require the 'corky-' prefix to avoid conflicts with system tools.
Run from the plugin directory or with full path.

Commands:
  corky-list                  - List all known emulators with install status
  corky-install <name>        - Download and install an emulator AppImage
  corky-remove <name>         - Remove an installed emulator AppImage
  corky-installed             - List only installed emulators
  corky-link <name> <path>    - Link an existing emulator executable
  corky-unlink <name>         - Remove a linked emulator (does not delete the file)
  corky-linked                - List only linked emulators
"""

